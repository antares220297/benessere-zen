      "blocks": {
        "faq-0": {
          "type": "faq",
          "settings": {
            "tab": "0",
            "question": "Quanto costa la spedizione?",
            "answer": "<p>La spedizione Express costa 5,90&nbsp;€, ed è gratuita da 50&nbsp;€ di spesa.</p>"
          }
        },
        "faq-1": {
          "type": "faq",
          "settings": {
            "tab": "0",
            "question": "Spedite anche all’estero?",
            "answer": "<p>No, spediamo solo in Italia.</p>"
          }
        },
        "faq-2": {
          "type": "faq",
          "settings": {
            "tab": "0",
            "question": "In Sicilia e Sardegna costa di più?",
            "answer": "<p>No, il prezzo è lo stesso in tutta Italia, isole comprese.</p>"
          }
        },
        "faq-3": {
          "type": "faq",
          "settings": {
            "tab": "0",
            "question": "Posso restituire un acquisto?",
            "answer": "<p>Sì, entro 14 giorni dalla ricezione, con il pezzo non usato e nel suo imballo originale. Scrivi a <a href=\"mailto:info@benesserezen.shop\">info@benesserezen.shop</a>: se il reso è accettato ti mandiamo noi l’etichetta, e il rimborso arriva entro 10 giorni lavorativi.</p>"
          }
        },
        "faq-4": {
          "type": "faq",
          "settings": {
            "tab": "1",
            "question": "Come posso pagare?",
            "answer": "<p>Con carta (Visa, Mastercard, Maestro, American Express), PayPal, Apple Pay, Google Pay e Shop Pay.</p>"
          }
        },
        "faq-5": {
          "type": "faq",
          "settings": {
            "tab": "1",
            "question": "Devo creare un account per ordinare?",
            "answer": "<p>No, puoi ordinare anche senza registrarti.</p>"
          }
        },
        "faq-6": {
          "type": "faq",
          "settings": {
            "tab": "1",
            "question": "C’è uno sconto sul primo ordine?",
            "answer": "<p>Sì, il 10% sul primo acquisto. Si applica da solo, non serve nessun codice.</p>"
          }
        },
        "faq-7": {
          "type": "faq",
          "settings": {
            "tab": "1",
            "question": "In cosa posso regalare un gioiello?",
            "answer": "<p>Nelle nostre <a href=\"/collections/scatole-porta-gioielli\">scatole porta gioielli</a>: in velluto a 18,50&nbsp;€, in legno e pietra a 29,90&nbsp;€.</p>"
          }
        },
        "faq-8": {
          "type": "faq",
          "settings": {
            "tab": "2",
            "question": "Ricevo la pietra della foto?",
            "answer": "<p>Ricevi la stessa pietra, nella stessa misura. La natura però non fa copie: forma e venature cambiano da un pezzo all’altro.</p>"
          }
        },
        "faq-9": {
          "type": "faq",
          "settings": {
            "tab": "2",
            "question": "Le pietre hanno effetti sulla salute?",
            "answer": "<p>No. I significati che leggi qui vengono dalla tradizione e non sostituiscono il parere di un medico.</p>"
          }
        },
        "faq-10": {
          "type": "faq",
          "settings": {
            "tab": "2",
            "question": "Che misura hanno i bracciali?",
            "answer": "<p>Sono elastici, in taglia unica. Il diametro, circa 6 o 7 cm, lo trovi nella scheda del bracciale.</p>"
          }
        },
        "faq-11": {
          "type": "faq",
          "settings": {
            "tab": "2",
            "question": "Quanti grani ha un mala?",
            "answer": "<p>I nostri mala hanno tutti 108 grani, come vuole la tradizione.</p>"
          }
        },
        "faq-12": {
          "type": "faq",
          "settings": {
            "tab": "2",
            "question": "Come pulisco pietre e bracciali?",
            "answer": "<p>Con un panno morbido e asciutto. Tienili lontani dall’acqua, dal calore e dai prodotti chimici.</p>"
          }
        }
      },
