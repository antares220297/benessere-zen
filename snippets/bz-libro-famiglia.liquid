{%- liquid
  assign famiglia = ''
  assign principale = product.metafields.custom.pietre.value.first
  assign handle_pietra = principale.system.handle | default: principale.handle
  case handle_pietra
    when 'ametista', 'quarzo-rosa', 'selenite', 'cristallo-di-rocca', 'lapislazzuli', 'occhio-di-tigre', 'ossidiana', 'tormalina-nera'
      assign famiglia = handle_pietra
  endcase
  if famiglia == blank
    case product.handle
      when 'ametista', 'bracciale-ametista-naturale', 'brucia-incensi-ametista', 'ciondolo-ala-angelo-ametista', 'ciondolo-ametista-cuore'
        assign famiglia = 'ametista'
      when 'ciondolo-ametista-grezza', 'collana-genesa-con-ametista', 'mala-ametista-108-perle', 'mala-braccialetto-ametista-loto', 'pendolo-in-ametista-sferico-e-metallo'
        assign famiglia = 'ametista'
      when 'pietre-burattate-ametista-1', 'roll-on-mix-oli-essenziali-hope-hare-la-luna', 'scatola-porta-gioielli-in-legno-loto-ametista-legno-di-mango'
        assign famiglia = 'ametista'
      when 'braccialetto-con-cristallo-di-rocca-con-loto', 'brucia-incensi-quarzo-rosa', 'ciondolo-ala-angelo-quarzo-rosa', 'ciondolo-in-quarzo-rosa-con-gancio', 'ciondolo-quarzo-rosa-cuore'
        assign famiglia = 'quarzo-rosa'
      when 'collana-genesa-con-quarzo-rosa', 'mala-braccialetto-quarzo-rosa-loto', 'mala-braccialetto-quarzo-rosa-ohm', 'pendolo-quarzo-rosa-e-catenina-dei-chakra', 'pietre-burattate-quarzo-rosa'
        assign famiglia = 'quarzo-rosa'
      when 'power-bracelet-quarzo-rosa', 'quarzo-rosa', 'roll-on-mix-oli-essenziali-hope-hare-gli-innamorati', 'scatola-porta-gioielli-in-legno-mandala-quarzo-rosa'
        assign famiglia = 'quarzo-rosa'
      when 'ciotola-a-stella-in-selenite', 'ciotola-di-ricarica-in-selenite-10-cm-cuore', 'piastra-ricarica-selenite-lotus-mandala-10cm', 'piatto-di-ricarica-in-selenite-10-cm-7-chakra-con-buddha', 'piatto-di-ricarica-in-selenite-10-cm-albero-della-vita'
        assign famiglia = 'selenite'
      when 'piatto-di-ricarica-in-selenite-10-cm-fase-lunare', 'piatto-di-ricarica-in-selenite-10-cm-fiore-della-vita', 'piatto-di-ricarica-in-selenite-10-cm-mandala', 'piatto-selenite-feng-shui', 'piatto-selenite-lotus'
        assign famiglia = 'selenite'
      when 'piatto-selenite-om-hexa-arancione', 'porta-candela-in-selenite-cuore-8-cm', 'porta-candela-selenite-montagna-8cm', 'porta-candela-selenite-sfera-8cm', 'porta-candela-selenite-yin-yang'
        assign famiglia = 'selenite'
      when 'ciondolo-ala-angelo-cristallo-di-rocca', 'ciondolo-cristallo-di-rocca-grezzo', 'collana-genesa-con-cristallo-di-rocca', 'cristallo-di-rocca', 'mala-108-cristallo-di-rocca-aa-nappa-bianca-borsa'
        assign famiglia = 'cristallo-di-rocca'
      when 'mala-bracciale-cristallo-di-rocca-loto', 'pendolo-cristallo-di-rocca-e-catenina-dei-chakra', 'pietre-burattate-cristallo-di-rocca', 'roll-on-mix-oli-essenziali-hope-hare-il-leone'
        assign famiglia = 'cristallo-di-rocca'
      when 'braccialetto-lapis-lazuli', 'ciondolo-a-cuore-in-lapislazzuli', 'ciondolo-in-lapis-lazuli', 'collana-genesa-con-lapislazzuli', 'lapislazzuli'
        assign famiglia = 'lapislazzuli'
      when 'pietre-burattate-lapislazzuli'
        assign famiglia = 'lapislazzuli'
      when 'braccialetto-occhio-di-tigre-dorato-6mm', 'ciondolo-occhio-di-tigre-grezzo', 'collana-con-genesa-e-occhio-di-tigre', 'mala-braccialetto-elastico-con-pietra-occhio-di-tigre-coraggio-iniziativa', 'occhio-di-tigre'
        assign famiglia = 'occhio-di-tigre'
      when 'pietre-burattate-occhio-di-tigre'
        assign famiglia = 'occhio-di-tigre'
      when 'bracciale-ossidiana-nera-dorata-perle-8mm', 'braccialetto-obsideinne-neige-perles', 'ciondolo-in-ossidiana-neve-goccia', 'ciondolo-larme-obsideinne-noire', 'ossidiana-nera'
        assign famiglia = 'ossidiana'
      when 'pietre-burattate-ossidiana-nera'
        assign famiglia = 'ossidiana'
      when 'bracciale-tormalina-nera-elastico', 'ciondolo-in-tormalina-grezza', 'collana-genesa-con-tormalina-nera', 'orgone-pendolo-tormalina-nera-sfaccettata-appuntito', 'roll-on-mix-oli-essenziali-hope-hare-cavaliere-di-spade'
        assign famiglia = 'tormalina-nera'
      when 'tormalina-nera-grezza'
        assign famiglia = 'tormalina-nera'
    endcase
  endif
  if dato == 'titolo'
    case famiglia
      when 'ametista'
        echo "Il libro dell’ametista"
      when 'quarzo-rosa'
        echo "Il libro del quarzo rosa"
      when 'selenite'
        echo "Il libro della selenite"
      when 'cristallo-di-rocca'
        echo "Il libro del cristallo di rocca"
      when 'lapislazzuli'
        echo "Il libro del lapislazzuli"
      when 'occhio-di-tigre'
        echo "Il libro dell’occhio di tigre"
      when 'ossidiana'
        echo "Il libro dell’ossidiana"
      when 'tormalina-nera'
        echo "Il libro della tormalina nera"
    endcase
  else
    echo famiglia
  endif
-%}
