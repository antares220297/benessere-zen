{%- liquid
  assign custom = product.metafields.custom
  assign pietre = custom.pietre.value
  assign pietra = pietre | first | default: custom.pietra.value
  assign pietra_cura = pietra.cura.value | default: pietra.cura | default: custom.cura.value | default: custom.cura
  assign use_text = ''
  if custom.come_si_usa != blank
    assign use_text = custom.come_si_usa | metafield_text | strip
  endif
  assign questions = ''
-%}
{%- capture care -%}
  {%- render 'bz-product-stone-care', pietre: pietre, pietra_cura: pietra_cura -%}
{%- endcapture -%}
{%- capture faq -%}
  {%- for index in (1..3) -%}
    {%- liquid
      assign question_key = 'faq_' | append: index | append: '_domanda'
      assign answer_key = 'faq_' | append: index | append: '_risposta'
      if custom[question_key] == blank or custom[answer_key] == blank
        continue
      endif
      assign question = custom[question_key] | metafield_text | strip
      assign answer = custom[answer_key] | metafield_text | strip
      if question == blank or answer == blank
        continue
      endif
      unless questions == blank
        assign questions = questions | append: ' · '
      endunless
      assign questions = questions | append: question
    -%}
    <div>
      <p class="bzs-benefit-title">{{ question | escape_once }}</p>
      <p>{{ answer | escape_once | newline_to_br }}</p>
    </div>
  {%- endfor -%}
{%- endcapture -%}
{%- if care != blank or use_text != blank or faq != blank -%}
  {%- capture line_break %}
{% endcapture -%}
  {%- liquid
    assign heading = 'Cura e domande'
    if care == blank and use_text == blank
      assign heading = 'Domande frequenti'
    elsif faq == blank
      if care == blank or use_text == blank
        assign heading = 'Come averne cura'
      endif
    endif

    assign preview = questions
    if care != blank
      assign first_paragraph = care | split: '<p>' | slice: 1, 1 | first | split: '</p>' | first
      assign preview = first_paragraph | replace: '<br />', ' ' | replace: line_break, ' ' | strip
      assign sentence_length = preview.size
      assign endings = '. ! ?' | split: ' '
      for ending in endings
        assign boundary = ending | append: ' '
        if preview contains boundary
          assign before_ending = preview | split: boundary | first
          assign length = before_ending.size | plus: 1
          if length < sentence_length
            assign sentence_length = length
          endif
        endif
      endfor
      assign preview = preview | slice: 0, sentence_length
    endif
  -%}
  <details class="bzs-item" open>
    <summary class="bzs-head">
      <h2 class="bzs-hd">{{ heading }}</h2>
      <svg class="bzs-ch" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.1" aria-hidden="true" focusable="false">
        <path d="m4 7 5 5 5-5"/>
      </svg>
      <span class="bzs-pv" aria-hidden="true"{% if preview == blank %} hidden{% endif %}>{{ preview | escape_once }}</span>
    </summary>
    <div class="bzs-prose">
      {{ care }}
      {%- if use_text != blank -%}
        <div>
          <p class="bzs-benefit-title">Come si usa</p>
          <p>{{ use_text | escape_once | newline_to_br }}</p>
        </div>
      {%- endif -%}
      {{ faq }}
    </div>
  </details>
{%- endif -%}
