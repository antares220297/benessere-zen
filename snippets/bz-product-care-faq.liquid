{%- liquid
  assign custom = product.metafields.custom
  assign pietre = custom.pietre.value
  assign pietra = pietre | first | default: custom.pietra.value
  assign custom_care = ''
  if custom.cura != blank
    assign custom_care = custom.cura | metafield_text | strip
  endif
  assign pietra_cura = pietra.cura.value | default: pietra.cura | default: custom_care
  assign use_text = ''
  if custom.come_si_usa != blank
    assign use_text = custom.come_si_usa | metafield_text | strip
  endif
  assign preview = 'Spedizione · Reso'
-%}
{%- capture care -%}
  {%- render 'bz-product-stone-care', pietre: pietre, pietra_cura: pietra_cura -%}
{%- endcapture -%}
{%- if care != blank -%}
  {%- assign preview = preview | prepend: 'Come averne cura · ' -%}
{%- endif -%}
{%- if use_text != blank -%}
  {%- assign preview = preview | append: ' · Come si usa' -%}
{%- endif -%}
{%- capture faq -%}
  {%- for index in (1..3) -%}
    {%- liquid
      assign question_key = 'faq_' | append: index | append: '_domanda'
      assign answer_key = 'faq_' | append: index | append: '_risposta'
      if custom[question_key] == blank or custom[answer_key] == blank
        continue
      endif
      assign question = custom[question_key] | metafield_text | strip
      assign answer = custom[answer_key] | metafield_text | strip
      if question == blank or answer == blank
        continue
      endif
      assign preview = preview | append: ' · ' | append: question
    -%}
    <h3>{{ question | escape_once }}</h3>
    <p>{{ answer | escape_once | newline_to_br }}</p>
  {%- endfor -%}
{%- endcapture -%}
<details class="bzs-item bb-care">
  <summary class="bzs-head">
    <h2 class="bzs-hd">Cura e domande</h2>
    {% render 'bb-icon', name: 'expand_more', icon_class: 'bzs-ch' %}
    <span class="bzs-pv" aria-hidden="true">{{ preview | escape_once }}</span>
  </summary>
  <div class="bzs-prose bb-faq">
    {%- if care != blank -%}
      <h3>Come averne cura</h3>
      {{ care }}
    {%- endif -%}
    <h3>Quanto costa la spedizione?</h3>
    <p>Spedizione Express {{ settings.bz_express_rate | default: '5,90' | escape }}&nbsp;€, gratuita da {{ ship_euros }}&nbsp;€ di ordine.</p>
    <h3>Posso fare il reso?</h3>
    <p>Puoi chiedere un reso entro 14 giorni dalla ricezione. Il prodotto va restituito non indossato, con cartellini e confezione. La spedizione del reso è a tuo carico. Se il reso è accettato, il rimborso arriva entro 10 giorni lavorativi. <a href="{{ shop.refund_policy.url | default: '/policies/refund-policy' | escape }}">Informativa sui rimborsi</a></p>
    {%- if use_text != blank -%}
      <h3>Come si usa</h3>
      <p>{{ use_text | escape_once | newline_to_br }}</p>
    {%- endif -%}
    {{ faq }}
  </div>
</details>
