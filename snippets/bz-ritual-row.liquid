<label class="bz-set__row">
  <input type="checkbox" checked data-bz-price="{{ rec.price }}" value="{{ rec.selected_or_first_available_variant.id }}">
  {%- if rec.featured_image != blank -%}
    {{ rec.featured_image | image_url: width: 140 | image_tag: alt: rec.title, width: 64, height: 64, loading: 'lazy' }}
  {%- endif -%}
  {%- assign row_name = rec.title | split: '|' | first | strip -%}
  <span>{{ row_name | escape }}{%- if rec.type != blank -%}<small>{{ rec.type | escape }}</small>{%- endif -%}</span>
  <span class="bz-price">{% render 'bz-money', cents: rec.price %}</span>
</label>
