{% comment %}
  Single hours source. part: boot | summary | footer | table
{% endcomment %}
{%- liquid
  assign mon = settings.bz_hours_mon
  assign tue = settings.bz_hours_tue
  assign wed = settings.bz_hours_wed
  assign thu = settings.bz_hours_thu
  assign fri = settings.bz_hours_fri
  assign sat = settings.bz_hours_sat
  assign sun = settings.bz_hours_sun
  assign note = settings.bz_sunday_note | default: 'Dal 1 al 24 dicembre aperti tutti i giorni, domenica e lunedì compresi'

  assign pretty_mon = mon | replace: ',', ' e ' | replace: '-', '–' | replace: '09:', '9:' | replace: '08:', '8:'
  assign pretty_thu = thu | replace: ',', ' e ' | replace: '-', '–' | replace: '09:', '9:' | replace: '08:', '8:'

  if mon == tue and tue == wed and wed == fri and fri == sat and mon != blank and thu != blank and thu != mon
    assign summary = 'Lun, mar, mer, ven, sab: ' | append: pretty_mon | append: '. Giovedì: ' | append: pretty_thu | append: '.'
    assign footer_line = 'lun, mar, mer, ven, sab ' | append: pretty_mon | append: ', gio ' | append: pretty_thu
  else
    assign summary = ''
    assign footer_line = ''
    assign labels = 'lun|mar|mer|gio|ven|sab' | split: '|'
    assign vals = mon | append: '|' | append: tue | append: '|' | append: wed | append: '|' | append: thu | append: '|' | append: fri | append: '|' | append: sat | split: '|'
    assign prev = ''
    assign names = ''
    for val in vals
      assign label = labels[forloop.index0]
      if val != blank and val == prev
        assign names = names | append: ', ' | append: label
      else
        if prev != blank
          assign prev_pretty = prev | replace: ',', ' e ' | replace: '-', '–' | replace: '09:', '9:' | replace: '08:', '8:'
          assign summary = summary | append: names | append: ': ' | append: prev_pretty | append: '. '
          assign footer_line = footer_line | append: names | append: ' ' | append: prev_pretty | append: ', '
        endif
        assign prev = val
        assign names = label
      endif
    endfor
    if prev != blank
      assign prev_pretty = prev | replace: ',', ' e ' | replace: '-', '–' | replace: '09:', '9:' | replace: '08:', '8:'
      assign summary = summary | append: names | append: ': ' | append: prev_pretty | append: '.'
      assign footer_line = footer_line | append: names | append: ' ' | append: prev_pretty
    endif
  endif
  if sun != blank
    assign pretty_sun = sun | replace: ',', ' e ' | replace: '-', '–' | replace: '09:', '9:'
    assign summary = summary | append: ' Domenica: ' | append: pretty_sun | append: '.'
    assign footer_line = footer_line | append: ', dom ' | append: pretty_sun
  endif

  if footer_line != blank
    assign footer_line = footer_line | strip | append: '. '
  endif
  if mon == blank
    assign summary = summary | strip | append: ' Lunedì chiuso.'
    assign footer_line = footer_line | append: 'Lunedì chiuso. '
  endif
  assign summary = summary | strip | append: ' ' | append: note | append: '.'
  assign footer_line = footer_line | append: note
-%}
{%- if part == 'boot' -%}
  <script type="application/json" id="bz-hours">
    {
      "note": {{ note | json }},
      "free": {{ settings.bz_free_shipping_threshold | default: 50 | at_least: 1 }},
      "express": {{ settings.bz_express_rate | default: '5,90' | json }},
      "days": [
        {{ sun | json }},
        {{ mon | json }},
        {{ tue | json }},
        {{ wed | json }},
        {{ thu | json }},
        {{ fri | json }},
        {{ sat | json }}
      ],
      "exceptions": {{ settings.bz_hours_exceptions | json }}
    }
  </script>
{%- elsif part == 'table' -%}
  <table class="shop-hours-table">
    <caption class="sr-only">Orari del negozio</caption>
    <tbody>
      {%- assign rows = 'mon:Lunedì,tue:Martedì,wed:Mercoledì,thu:Giovedì,fri:Venerdì,sat:Sabato,sun:Domenica' | split: ',' -%}
      {%- for row in rows -%}
        {%- liquid
          assign fields = row | split: ':'
          assign key = fields.first | prepend: 'bz_hours_'
          assign intervals = settings[key] | replace: ',', ' e ' | replace: '-', '–' | replace: '09:', '9:' | replace: '08:', '8:'
          assign day = forloop.index | modulo: 7
        -%}
        <tr data-shop-day="{{ day }}">
          <th scope="row">{{ fields.last }}</th>
          <td>{{ intervals | default: 'Chiuso' | escape }}</td>
        </tr>
      {%- endfor -%}
    </tbody>
  </table>
{%- elsif part == 'footer' -%}
  Orari: {{ footer_line | strip }}
{%- else -%}
  {{ summary | strip }}
{%- endif -%}
