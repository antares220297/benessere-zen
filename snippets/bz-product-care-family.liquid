{%- liquid
  assign kind = product.type | downcase | strip
  assign tags = product.tags | join: '|' | downcase | split: '|'
  assign handle = product.handle

  assign selenite_dish = false
  if handle contains 'selenite'
    if handle contains 'piatto' or handle contains 'ciotola' or handle contains 'piastra'
      assign selenite_dish = true
    endif
  endif
  assign smudge_spray = false
  if handle contains 'spray' and tags contains 'smudge'
    assign smudge_spray = true
  endif
  assign accessory = false
  assign soap = false
  if kind == 'cosmetici'
    if tags contains 'porta-saponette' or tags contains 'pietra lavica' or handle contains 'netta-lingua'
      assign accessory = true
    endif
    if tags contains 'saponette' or handle contains 'sapone-scrub-'
      assign soap = true
    endif
  endif

  if selenite_dish
    echo '7a'
  elsif smudge_spray or handle contains 'spray-per-ambienti' or handle contains 'diffusore-botanico' or handle contains 'diffusore-per-ambiente' or handle contains 'profumo-vapo-per-ambienti' or handle contains 'busta-profuma-armadio' or handle contains 'sali-da-bagno' or tags contains 'sali' or tags contains 'diffusori' or handle == 'lampadine-ricambio-per-lampade-di-sale'
    echo 'ripiego'
  elsif tags contains 'portacandela' or handle contains 'porta-candela' or handle contains 'portacandela'
    echo '7d'
  elsif handle == 'carta-aromatica-d-eritrea-con-scatola-serigrafata-in-metallo'
    echo '4'
  elsif tags contains 'brucia-incenso' or tags contains 'brucia-essenze' or handle contains 'brucia-incen' or handle contains 'bruciatore-' or handle == 'aromafume-aura-cleansing-set-dincensi'
    echo '4b'
  elsif tags contains 'lampade'
    echo '7b'
  elsif tags contains 'cuscini' or handle contains 'cuscino-termico'
    echo '7c'
  elsif kind == 'tè e tisane' and handle contains 'infusore'
    echo '8b'
  elsif accessory
    echo '5b'
  elsif soap
    echo '5a'
  elsif kind == 'candele' or kind == 'incensi e smudge' or tags contains 'incensi' or tags contains 'smudge'
    echo '4'
  elsif kind == 'cosmetici' and tags contains 'roll-on'
    echo '3'
  else
    case kind
      when 'pietre grezze', 'pietre burattate'
        echo '1'
      when 'bracciali', 'collane', 'ciondoli', 'mala'
        echo '2'
      when 'oli e profumi'
        if tags contains 'oli-massaggio' or handle contains 'roll-on' or handle contains 'profumo-in-olio-' or handle contains 'oli-profumati-corpo-' or handle contains 'olio-profumato-ayurveda-' or handle contains 'olio-profumato-naturale-'
          echo '3'
        else
          echo 'ripiego'
        endif
      when 'cosmetici'
        echo '5'
      when 'pendoli'
        echo '6'
      when 'oggettistica'
        echo '7e'
      when 'tè e tisane'
        echo '8'
      else
        echo 'ripiego'
    endcase
  endif
-%}
