{%- assign handles = 'gioielli-con-pietre,mala-tibetani,pietre-burattate,pietre-grezze,pendoli,incensi-e-brucia-incensi,candele-e-brucia-candele,statuette,cosmetica,cosmesi-corpo,prodotti-per-capelli,cura-della-persona,essenze-e-brucia-essenze,te-tisane' | split: ',' -%}
<ul class="bz-main-collections" role="list">
  {%- for handle in handles -%}
    {%- assign group = collections[handle] -%}
    {%- if group != blank -%}
      <li>
        <a href="{{ group.url }}">
          {%- if group.featured_image -%}
            {{ group.featured_image | image_url: width: 640 | image_tag: alt: '', widths: '300, 480, 640', sizes: '(min-width: 1024px) 300px, 45vw', loading: 'lazy' }}
          {%- endif -%}
          <span>{{ group.title | escape }}</span>
          {% render 'bz-icon', name: 'arrow_forward' %}
        </a>
      </li>
    {%- endif -%}
  {%- endfor -%}
</ul>
