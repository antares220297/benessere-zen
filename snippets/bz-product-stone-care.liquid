{%- for stone in pietre -%}
  {%- assign stone_index = forloop.index0 -%}
  {%- assign care = stone.cura.value | default: stone.cura -%}
  {%- if forloop.first -%}
    {%- assign care = pietra_cura -%}
  {%- endif -%}
  {%- if care == blank -%}{%- continue -%}{%- endif -%}

  {%- unless forloop.first -%}
    {%- if care == pietra_cura -%}{%- continue -%}{%- endif -%}
    {%- assign care_shown = false -%}
    {%- assign earlier_count = stone_index | minus: 1 -%}
    {%- for earlier_stone in pietre offset: 1 limit: earlier_count -%}
      {%- assign earlier_care = earlier_stone.cura.value | default: earlier_stone.cura -%}
      {%- if care == earlier_care -%}
        {%- assign care_shown = true -%}
        {%- break -%}
      {%- endif -%}
    {%- endfor -%}
    {%- if care_shown -%}{%- continue -%}{%- endif -%}
  {%- endunless -%}

  {%- if inline -%}
    {%- if care_shown_inline -%}<br>{%- endif -%}
    {{- care | escape_once | newline_to_br -}}
    {%- assign care_shown_inline = true -%}
    {%- continue -%}
  {%- endif -%}

  {%- assign next_index = stone_index | plus: 1 -%}
  {%- assign group_names = stone.nome.value | default: stone.nome -%}
  {%- assign group_count = 1 -%}
  {%- assign last_name = blank -%}
  {%- for next_stone in pietre offset: next_index -%}
    {%- assign next_care = next_stone.cura.value | default: next_stone.cura -%}
    {%- if care == next_care -%}
      {%- if last_name != blank -%}
        {%- assign group_names = group_names | append: ', ' | append: last_name -%}
      {%- endif -%}
      {%- assign last_name = next_stone.nome.value | default: next_stone.nome -%}
      {%- assign group_count = group_count | plus: 1 -%}
    {%- endif -%}
  {%- endfor -%}
  {%- if group_count > 1 -%}
    {%- assign group_names = group_names | append: ' e ' | append: last_name -%}
  {%- endif -%}
  {%- if group_count > 1 or stone_index > 0 -%}
    <h3>{{ group_names | escape }}</h3>
  {%- endif -%}
  {%- if stone_index == 0 -%}
    <p>{{ care | escape_once }}</p>
  {%- else -%}
    <p>{{ care | escape_once | newline_to_br }}</p>
  {%- endif -%}
{%- else -%}
  {%- if pietra_cura != blank -%}
    {%- if inline -%}{{ pietra_cura | escape_once | newline_to_br }}{%- else -%}<p>{{ pietra_cura | escape }}</p>{%- endif -%}
  {%- endif -%}
{%- endfor -%}
