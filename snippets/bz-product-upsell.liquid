{%- if product.available -%}
  {%- liquid
    assign handle = product.handle
    assign title_key = product.title | downcase
    assign tools = ''
    assign complements = ''
    assign line = ''
    assign stone = product.metafields.custom.pietre.value | first
    assign stone = stone | default: product.metafields.custom.pietra.value
    assign mineral = stone.system.handle | default: stone.handle
    case family
      when 'incensi'
        if title_key contains 'riflusso'
          assign tools = 'brucia-incenso-a-riflusso-bamboo-spezzato,brucia-incensi-a-riflusso-serine-cascata-ovale,brucia-incenso-riflusso-pietre'
          assign complements = 'incensi-masala-riflusso-legno-di-sandalo-e-vaniglia,incensi-masala-riflusso-oudh,aromatica-incensi-masala-riflusso-patchouli'
        elsif title_key contains 'coni' or handle contains 'in-coni'
          assign tools = 'brucia-incenso-loto-bastoncini-coni-10-cm,brucia-incenso-motivo-fiore-di-loto'
          assign complements = 'incenso-in-coni-sandalo,incenso-in-coni-ambra,incenso-in-coni-patchouli,incenso-in-coni-sangue-di-drago'
        elsif title_key contains 'mattoncin' or handle contains 'aromafume'
          assign tools = 'aromafume-exotic-incense-diffusore-rainbow-100-g-6-5x7-cm,aromafume-exotic-incense-diffusore-albero-della-vita'
          assign complements = 'mattoncini-dincenso-aromafume-franchincenso,mattoncini-dincenso-aromafume-royal-sandal,aromafume-mattoncini-di-incenso-nag-champa'
        else
          assign tools = 'ciotola-incenso-tripla-luna-legno-mango,portaincensi-hamsa-in-steatite-7-chakra,brucia-incenso-loto-bastoncini-coni-10-cm'
          if handle contains 'cosmos'
            assign complements = 'sagrada-madre-incenso-naturale-cosmos-venere,sagrada-madre-incenso-naturale-cosmos-giove,sagrada-madre-incenso-naturale-cosmos-sole'
          else
            assign line = product.title | split: '|' | first | split: ' - ' | first | downcase | strip
          endif
        endif
      when 'salvia-e-smudge'
        assign tools = 'trippiede-cobra-piccolo-con-conchiglia-abalone-halitois-multicolore,supporto-per-palo-santo-smudge-e-incensi-grigio-fiore-di-loto,supporto-per-palo-santo-e-incensi-mandala-sabbia-e-grigio'
        assign complements = 'smudge-salvia-bianca-con-cedro,smudge-di-salvia-bianca-con-yerba-santa-s-per-24-in-espositore,smudge-stick-salvia-bianca'
      when 'palo-santo'
        assign tools = 'porta-incenso-ceramica-bianco-palo-santo,bruciatore-palo-santo-loto-multicolore'
        assign complements = 'palo-santo-naturale-in-stick-purificazione-e-aromaterapia'
      when 'oli-e-profumi'
        assign tools = 'brucia-essenze-rosa-in-ceramica-cuore,brucia-essenze-albero-della-vita-ceramica-turchese,brucia-essenze-pietra-ollare-buddha'
        if handle contains 'banjara'
          assign complements = 'fragranza-banjara-10ml-legno-di-sandalo,fragranza-banjara-10ml-patchouli,fragranza-banjara-10ml-palo-santo,fragranza-banjara-nag-champa'
        elsif handle contains 'song-of-india'
          assign complements = 'olio-essenziale-bergamotto-song-of-india-10ml,olio-essenziale-neroli-song-of-india-10-ml,olio-essenziale-vaniglia-song-of-india-10-ml'
        elsif handle contains 'esoteric-collection'
          assign complements = 'olio-aromatico-esoteric-collection-boho-dreams,olio-aromatico-esoteric-collection-buona-fortuna,olio-aromatico-esoteric-collection-occhio-della-provvidenza'
        else
          assign line = product.title | split: '|' | first | split: ' - ' | first | downcase | strip
        endif
      when 'candele'
        if handle contains 'da-tavola'
          assign tools = 'portacandela-in-vetro-per-candela-da-tavola'
        else
          assign tools = 'portacandele-vetro-loto-smerigliato,portacandela-in-vetro-smerigliato-interno-metallizzato-albero-della-vita'
        endif
        if handle contains 'celestial-magic'
          assign complements = 'celestial-magic-candela-profumata-incantesimo-polvere-di-luna,celestial-magic-candela-profumata-vibrazioni-magiche'
        endif
    endcase
    assign use_mineral = false
    if tools == blank and mineral != blank and family != 'amuleti'
      assign use_mineral = true
      assign tools = 'piatto-di-ricarica-in-selenite-10-cm-albero-della-vita,ciotola-di-ricarica-in-selenite-10-cm-cuore,piatto-di-ricarica-in-selenite-10-cm-mandala'
    endif

    assign first = blank
    assign second = blank
    if tools != blank
      assign tool_handles = tools | split: ','
      for candidate in tool_handles
        assign item = all_products[candidate]
        if item.available and item.id != product.id and item.featured_image
          assign first = item
          break
        endif
      endfor
      if first != blank
        assign complement_handles = complements | split: ','
        for candidate in complement_handles
          assign item = all_products[candidate]
          if item.available and item.id != product.id and item.id != first.id and item.featured_image
            assign second = item
            break
          endif
        endfor

        if second == blank and complements == blank
          for col in product.collections
            unless col.handle == 'all' or col.handle == 'frontpage'
              for item in col.products
                unless item.available and item.id != product.id and item.id != first.id and item.featured_image
                  continue
                endunless
                if use_mineral
                  assign item_stone = item.metafields.custom.pietre.value | first
                  assign item_stone = item_stone | default: item.metafields.custom.pietra.value
                  assign item_mineral = item_stone.system.handle | default: item_stone.handle
                  if item_mineral == mineral
                    assign second = item
                  endif
                else
                  capture item_family
                    render 'bz-libro-famiglia', product: item
                  endcapture
                  assign item_line = item.title | split: '|' | first | split: ' - ' | first | downcase | strip
                  if item_family == family
                    if item_line == line or family == 'candele'
                      assign second = item
                    endif
                  endif
                endif
                if second != blank
                  break
                endif
              endfor
            endunless
            if second != blank
              break
            endif
          endfor
        endif
      endif
    elsif recommendations.performed
      for item in recommendations.products
        if item.available and item.id != product.id and item.featured_image
          if first == blank
            assign first = item
          elsif item.id != first.id
            assign second = item
            break
          endif
        endif
      endfor
    else
      assign rec_url = routes.product_recommendations_url | append: '?section_id=' | append: section.id | append: '&product_id=' | append: product.id | append: '&limit=10&intent=complementary'
    endif
  -%}
  {%- if first.id and second.id and product.featured_image -%}
    {%- liquid
      assign first_variant = first.first_available_variant
      assign second_variant = second.first_available_variant
      assign paired_price = first_variant.price | plus: second_variant.price
      assign total = paired_price | plus: current.price
      assign reduced = total | times: 0.9 | round
    -%}
    <aside class="bz-upsell bz-upsell--colonna" aria-label="Completa il rituale" data-paired-price="{{ paired_price }}"{% unless current.available %} hidden{% endunless %}>
      <p class="bz-upsell__label">Completa <em>il rituale</em></p>
      <ul class="bz-upsell__list" role="list">
        {%- for row in (1..3) -%}
          {%- liquid
            if forloop.first
              assign item = product
              assign variant = current
            elsif row == 2
              assign item = first
              assign variant = first_variant
            else
              assign item = second
              assign variant = second_variant
            endif
            capture name
              render 'bz-product-name', product: item
            endcapture
            assign storefront_name = item.metafields.custom.nome_vetrina.value | strip
            assign subtitle = item.metafields.custom.variante_vetrina.value | strip
            if forloop.first and product.variants.size > 1
              assign subtitle = variant.title
            endif
          -%}
          <li class="bz-upsell__item" data-upsell-handle="{{ item.handle }}"{% if storefront_name == blank %} data-upsell-title-fallback{% endif %}>
            <figure class="bz-upsell__thumb">{{ item.featured_image | image_url: width: 96, height: 96, crop: 'center' | image_tag: width: 48, height: 48, alt: '', loading: 'lazy' }}</figure>
            <div class="bz-upsell__text">
              <span class="bz-upsell__name">{{ name | escape }}</span>
              {% if forloop.first %}
                <span class="bz-upsell__sub"><span{% if product.variants.size > 1 %} data-bz-upsell-variant{% endif %}>{% if subtitle != blank %}{{ subtitle | escape }} · {% endif %}</span><span class="bz-upsell__current">questo prodotto</span></span>
              {% elsif subtitle != blank %}
                <span class="bz-upsell__sub">{{ subtitle | escape }}</span>
              {% endif %}
            </div>
            <span class="bz-upsell__price"{% if forloop.first %} data-bz-upsell-price{% endif %}>{% render 'bz-money', cents: variant.price %}</span>
            {% if forloop.first == false and variant.available %}
              <button class="bz-upsell__add" type="button" data-upsell-variant="{{ variant.id }}" aria-pressed="false" aria-label="Aggiungi al carrello: {{ name | escape }}{% if subtitle != blank %} {{ subtitle | escape }}{% endif %}">
                <svg class="bz-upsell__icon-plus" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><path d="M5 12h14m-7-7v14"/></svg>
                <svg class="bz-upsell__icon-check" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M5 11 10 16 19 6"/></svg>
              </button>
            {% endif %}
          </li>
        {%- endfor -%}
      </ul>
      <div class="bz-upsell__row">
        <span class="bz-upsell__caption">i tre insieme</span>
        <p class="bz-upsell__prices">
          {% if section.settings.mostra_sconto_insieme %}
            <s data-bz-upsell-full>{% render 'bz-money', cents: total %}</s>
            <span data-bz-upsell-reduced>{% render 'bz-money', cents: reduced %}</span>
          {% else %}
            <span data-bz-upsell-full>{% render 'bz-money', cents: total %}</span>
          {% endif %}
        </p>
      </div>
      <button class="bz-upsell__cta" type="button">Aggiungi tutti e tre</button>
      <p class="bz-upsell__status" role="alert" hidden></p>
    </aside>
  {%- elsif rec_url != blank -%}
    <div hidden data-bz-upsell-url="{{ rec_url | escape }}"></div>
  {%- endif -%}
{%- endif -%}
