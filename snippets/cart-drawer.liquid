{% comment %}
  Cart drawer rendered by sections/cart-drawer.liquid.
  The header loads that section with ?sections=cart-drawer, and cart/change.js
  replaces #CartDrawer inner HTML from the same response. This markup is both paths.
{% endcomment %}
{%- liquid
  assign threshold_euros = settings.bz_free_shipping_threshold | default: 50 | plus: 0
  if threshold_euros <= 0
    assign threshold_euros = 50
  endif
  assign threshold_cents = threshold_euros | times: 100
  assign remaining = threshold_cents | minus: cart.total_price
  assign progress = 100
  if threshold_cents > 0 and cart.total_price < threshold_cents
    assign progress = cart.total_price | times: 100 | divided_by: threshold_cents
  endif
  assign seed = cart.items.first.product
  assign cart_ids = cart.items | map: 'product_id' | join: ',' | prepend: ',' | append: ','
-%}
<div
  id="CartDrawer"
  class="bz-drawer"
  x-data="xCart"
  x-init="$store.xMiniCart.type = 'drawer'"
  x-show="$store.xMiniCart.open"
  x-cloak
  @keydown.escape.window="$store.xMiniCart.hideCart()"
>
  <div id="CartDrawer-Overlay" class="bz-drawer__scrim" data-bz-close></div>
  <div id="update-cart" class="bz-drawer__panel" role="dialog" aria-modal="true" aria-label="Il tuo carrello" tabindex="-1">
    <header class="bz-drawer__head">
      <h3>Il tuo carrello</h3>
      <button id="CloseCart" class="bz-drawer__close" type="button" data-bz-close aria-label="Chiudi">×</button>
    </header>

    {%- if cart == empty -%}
      <p class="bz-drawer__empty">Il carrello è vuoto.</p>
      <a class="bz-drawer__go bz-drawer__shop" href="/collections/all">Continua lo shopping</a>
    {%- else -%}
      <div class="bz-drawer__ship bz-ship">
        {%- if remaining > 0 -%}
          <p class="bz-ship__text">Ti mancano <b>{% render 'bz-money', cents: remaining %}</b> per la spedizione gratuita</p>
        {%- else -%}
          <p class="bz-ship__text">Spedizione gratuita</p>
        {%- endif -%}
        <div class="bz-ship__track" aria-hidden="true">
          <i style="width: {{ progress }}%"></i>
          <span class="bz-ship__mark">
            <svg viewBox="0 0 24 24"><path d="M2 7h12v9H2zM14 10h4l3 3v3h-7"/><circle cx="6" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/></svg>
          </span>
        </div>
      </div>

      <div class="bz-drawer__scroll">
      <div class="bz-drawer__items">
        {%- for item in cart.items -%}
          <article class="cart-item bz-drawer__item" data-key="{{ item.key }}">
            <a href="{{ item.url }}">
              {%- if item.image -%}
                <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.product.title | escape }}" width="76" height="76">
              {%- endif -%}
            </a>
            <div class="bz-drawer__copy">
              <a href="{{ item.url }}">{{ item.product.title | escape }}</a>
              {%- if item.variant.title != blank and item.variant.title != 'Default Title' -%}
                <small class="bz-drawer__variant">{{ item.variant.title | escape }}</small>
              {%- endif -%}
              <div class="bz-drawer__qty">
                <button type="button" data-bz-qty="-1" aria-label="Meno">−</button>
                <input class="bz-drawer__qty-input" id="cart-qty-{{ item.key }}" type="text" inputmode="numeric" value="{{ item.quantity }}" aria-label="Quantità">
                <button type="button" data-bz-qty="1" aria-label="Più">+</button>
                <button type="button" data-bz-remove hidden>Rimuovi</button>
              </div>
            </div>
            <span class="bz-line-price">
              {% render 'bz-money', cents: item.final_line_price %}
              {%- if item.quantity > 1 -%}
                <small class="bz-line-price__each">{% render 'bz-money', cents: item.final_price %} cad.</small>
              {%- endif -%}
            </span>
            <span id="loading-{{ item.key }}" hidden></span>
          </article>
        {%- endfor -%}
      </div>

      <div class="bz-drawer__upsell" data-bz-upsell data-product-id="{{ seed.id }}">
        <h4>Si abbina bene</h4>
        <div data-bz-upsell-list>
          {%- assign upsell_count = 0 -%}
          {%- if recommendations.performed and recommendations.products_count > 0 -%}
            {%- for product in recommendations.products limit: 4 -%}
              {%- assign pid = product.id | prepend: ',' | append: ',' -%}
              {%- unless cart_ids contains pid -%}
                {%- if upsell_count < 2 and product.available -%}
                  {%- assign upsell_count = upsell_count | plus: 1 -%}
                  <div class="bz-upsell">
                    <a href="{{ product.url }}">
                      {%- if product.featured_image -%}
                        <img src="{{ product.featured_image | image_url: width: 120 }}" alt="{{ product.title | escape }}" width="48" height="48">
                      {%- endif -%}
                    </a>
                    <a href="{{ product.url }}">{{ product.title | escape }}</a>
                    <span>{% render 'bz-money', cents: product.price %}</span>
                    <button type="button" class="bz-drawer__plus" data-bz-upsell-add="{{ product.selected_or_first_available_variant.id }}" aria-label="Aggiungi {{ product.title | escape }}">+</button>
                  </div>
                {%- endif -%}
              {%- endunless -%}
            {%- endfor -%}
          {%- endif -%}
          {%- if upsell_count < 2 and settings.cart_upsell_product_list != blank -%}
            {%- for product in settings.cart_upsell_product_list -%}
              {%- assign pid = product.id | prepend: ',' | append: ',' -%}
              {%- unless cart_ids contains pid -%}
                {%- if upsell_count < 2 and product.available -%}
                  {%- assign upsell_count = upsell_count | plus: 1 -%}
                  <div class="bz-upsell">
                    <a href="{{ product.url }}">
                      {%- if product.featured_image -%}
                        <img src="{{ product.featured_image | image_url: width: 120 }}" alt="{{ product.title | escape }}" width="48" height="48">
                      {%- endif -%}
                    </a>
                    <a href="{{ product.url }}">{{ product.title | escape }}</a>
                    <span>{% render 'bz-money', cents: product.price %}</span>
                    <button type="button" class="bz-drawer__plus" data-bz-upsell-add="{{ product.selected_or_first_available_variant.id }}" aria-label="Aggiungi {{ product.title | escape }}">+</button>
                  </div>
                {%- endif -%}
              {%- endunless -%}
            {%- endfor -%}
          {%- endif -%}
          {%- if upsell_count < 2 and seed != blank -%}
            {%- for collection in seed.collections limit: 2 -%}
              {%- for product in collection.products limit: 8 -%}
                {%- assign pid = product.id | prepend: ',' | append: ',' -%}
                {%- unless cart_ids contains pid -%}
                {%- if upsell_count < 2 and product.id != seed.id and product.available -%}
                  {%- assign upsell_count = upsell_count | plus: 1 -%}
                  <div class="bz-upsell">
                    <a href="{{ product.url }}">
                      {%- if product.featured_image -%}
                        <img src="{{ product.featured_image | image_url: width: 120 }}" alt="{{ product.title | escape }}" width="48" height="48">
                      {%- endif -%}
                    </a>
                    <a href="{{ product.url }}">{{ product.title | escape }}</a>
                    <span>{% render 'bz-money', cents: product.price %}</span>
                    <button type="button" class="bz-drawer__plus" data-bz-upsell-add="{{ product.selected_or_first_available_variant.id }}" aria-label="Aggiungi {{ product.title | escape }}">+</button>
                  </div>
                {%- endif -%}
                {%- endunless -%}
              {%- endfor -%}
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>
      </div>

      <footer class="bz-drawer__foot">
        <p><span>Subtotale</span><strong>{% render 'bz-money', cents: cart.total_price %}</strong></p>
        {%- if remaining > 0 -%}
          <small>IVA inclusa. Mancano {% render 'bz-money', cents: remaining %} alla spedizione gratuita. Oppure ritiro gratuito in negozio.</small>
        {%- else -%}
          <small>IVA inclusa. La spedizione è gratuita. Oppure ritiro gratuito in negozio.</small>
        {%- endif -%}
        <form action="{{ routes.cart_url }}" method="post">
          <button id="checkout-submit" class="bz-drawer__go" type="submit" name="checkout">Vai al pagamento →</button>
        </form>
      </footer>
    {%- endif -%}
  </div>
</div>
