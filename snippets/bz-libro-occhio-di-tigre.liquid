<div class="pg pg--cover pg--hard" data-n="0" aria-hidden="true"><div class="cv"><img class="cv-img" src="{{ 'libro-copertina-comune.webp' | asset_url }}" alt="" width="768" height="1024" loading="lazy"><p class="cv-t">Dell’occhio di tigre</p></div></div>
