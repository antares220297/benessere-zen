<section class="plp-group" data-bz-group="{{ id }}" aria-labelledby="bz-plp-group-{{ id }}">
  <div class="plp-group-head">
    <h2 id="bz-plp-group-{{ id }}">{{ title | escape }}</h2>
    <span>{{ count }} {% if count == 1 %}prodotto{% else %}prodotti{% endif %}</span>
  </div>
  <div class="pgrid">{{ cards }}</div>
</section>
