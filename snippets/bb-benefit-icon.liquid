{%- comment -%}
  Output category|glyph. Match the earliest word, with the map order breaking ties.
  Python strips the roots before compiling them (including puro, pura and oli).
{%- endcomment -%}
{%- liquid
  assign generic_titles = 'nella tradizione|tradizione|benefici|proprietà' | split: '|'
  assign title_key = title | downcase | strip
  assign category = 'riserva'
  assign glyph = 'spa'
  assign categories = 'calma:sentiment_calm:pace,calm,relax,rilass,seren,tranquill,quiet,pausa,riposo,sonno,distens,stress|emozioni:favorite:emozion,emotiv,cuore,amor,empati,affett,romantic,dolcezz,gentilezz,compassion,autostima,amicizi|spirito:folded_hands:spiritual,meditaz,consapevol,elevaz,connession,chakra,preghier,sacr,divinit,preghi,devozion,yoga,mantra|protezione:shield:protez,protett,scudo,difes,negativ,malocchio,schermo|purificazione:air:purific,pulizi,purezz,puro,pura,sgombr,smudg,cleans|energia:sunny:energ,vital,carica,ricaric,forza,risvegl,spinta,coraggi,dinam,slancio,motivaz,ottimism,gioia,sole,solar,sicurezz,fiducia,determinaz|equilibrio:contrast:equilibr,armon,bilanc,centr,yin,yang|radicamento:park:radic,stabil,terra,ancor,grounding,stabilità|chiarezza:lightbulb:chiarezz,mental,focus,concentraz,lucid,mente,memori,studio,attenzion|intuizione:star_shine:intuiz,ispiraz,creativ,sogn,divinat,magia,magic,mistic,rinascit,rinnov,trasform,crescit,luna,lunar,percez|comunicazione:record_voice_over:comunica,dialog,eloquen,sincer,espressione di s,espressione sincer,espressione autentic|prosperita:diamond_shine:prosper,abbondanz,fortun,attraz,success,ricchezz,opportunit,manifest|profumo:fragrance:atmosfer,fragranz,profum,aroma,essenz,olio,oli,diffusion,fumo,combust,incens,ambient,fresc,profumaz|natura:eco:natural,artigian,ecolog,organic,biolog,certificat,vegan,estratt,karit,sesamo,curcuma,burro,pianta,erbe,idrat,nutri,pelle,delicat,morbid,ingredient,lavanda,arnica,vitamin,sebo,resina,botanic,camomill,aloe|qualita:workspace_premium:design,elegan,finitur,stile,versatil,formato,pratic,durat,qualit,material,resistent,precision,dettagli,estetic,compatibil,robust,capient' | split: '|'
  assign ascii_separators = '!"#$%&()*+,-./:;<=>?@[]^`{}~' | append: "'" | split: ''
  assign unicode_separators = '«|»|‹|›|‘|’|“|”|„|‚|‐|‑|‒|–|—|―|…|·|•|°|©|®|™|×|÷|€| | |⚓|⚙|️|🌊|🌺|🛡|🧘' | split: '|'
  assign backslash = '%5C' | url_decode
  assign tab = '%09' | url_decode
  assign fallback = phrase | default: title
  for pass in (1..2)
    assign candidate = fallback
    if pass == 1
      if title_key == blank or generic_titles contains title_key
        continue
      endif
      assign candidate = title_key
    endif
    assign candidate = candidate | downcase | newline_to_br | replace: '<br />', ' ' | strip_newlines | replace: '|', ' ' | replace: backslash, ' ' | replace: tab, ' '
    for separator in ascii_separators
      assign candidate = candidate | replace: separator, ' '
    endfor
    for separator in unicode_separators
      assign candidate = candidate | replace: separator, ' '
    endfor
    assign candidate = candidate | prepend: ' '
    assign best = candidate.size
    for entry in categories
      assign fields = entry | split: ':'
      assign roots = fields[2] | split: ','
      for root in roots
        assign needle = root | prepend: ' '
        unless candidate contains needle
          continue
        endunless
        assign start = candidate | split: needle | first | size
        assign prefix = candidate | slice: 0, needle.size
        if prefix == needle
          assign start = 0
        endif
        if start < best
          assign best = start
          assign category = fields[0]
          assign glyph = fields[1]
        endif
      endfor
      if best == 0
        break
      endif
    endfor
    if category != 'riserva'
      break
    endif
  endfor
-%}
{{- category -}}|{{- glyph -}}
