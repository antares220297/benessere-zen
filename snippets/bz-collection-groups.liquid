{%- comment -%}
  Map rows are label | child handles | Italian title fragments.
  Output is group count, visible card count, chips and sections, in that order.
{%- endcomment -%}
{%- liquid
  case collection.handle
    when 'cosmetica'
      assign map = 'Detergenti e scrub|latte-detergente|detergent,struc,acqua micellare,scrub;Tonici|tonico|tonic;Sieri|siero-viso|siero,sieri;Creme giorno e notte|crema-giorno|crema,creme;Contorno occhi|contorno-occhi|contorno occhi,borse e occhiaie;Maschere|maschera|mascher'
      assign keyword_priority = '1,2,3,5,6,4'
    when 'cosmesi-corpo'
      assign map = 'Oli e creme corpo|creme-e-latti-corpo|olio,oli ,crema,creme,latte;Scrub corpo|scrub-corpo|scrub,esfoliant;Balsami corpo|balsami-corpo|balsam;Mani e piedi|creme-mani-e-piedi|mani,piedi;Solari|solari|solare,solari,doposole,spf'
      assign keyword_priority = '2,3,4,5,1'
    when 'ayurveda'
      assign map = 'Cosmesi viso|cosmesi-viso-ayurvedica|viso;Cosmesi corpo|cosmesi-corpo-ayurvedica|corpo;Gel doccia|gel-doccia-ayurvedici|gel doccia,bagnoschiuma;Igiene e cura della persona|igiene-e-cura-della-persona-ayurvedica|deodorant,dentifric,igiene;Capelli|prodotti-per-capelli-ayurvedici,prodotti-per-capelli-ayur|capelli,shampoo;Oil pulling|oil-pulling|oil pulling,oil-pulling;Roll-on|roll-on-ayurvedici|roll-on,roll on;Saponi naturali|saponi-naturali-ayurvedici,saponi-naturali-ayur|sapon;Tè e tisane|te-e-tisane-ayurvediche|tè,tisan,infuso'
      assign keyword_priority = '3,4,5,6,7,8,9,1,2'
    when 'cura-della-persona'
      assign map = 'Bagnoschiuma|bagnoschiuma|bagnoschiuma,bagno schiuma,gel doccia;Deodoranti|deodoranti|deodorant;Sali da bagno|sali-da-bagno|sali da bagno,sale da bagno;Saponi naturali|saponi-naturali|sapon;Balsami labbra|balsamo-labbra|labbra,burrocacao'
    when 'prodotti-per-capelli'
      assign map = 'Shampoo||shampoo;Balsami||balsam,conditioner;Oli||olio,oli ;Maschere||mascher;Lozioni e trattamenti||lozion,siero,trattament'
    when 'essenze-e-brucia-essenze'
      assign map = 'Profumi in olio|profumi-in-olio|profum,olio;Roll-on viso e corpo|roll-on-viso-e-corpo|roll-on,roll on;Roll-on ai fiori di Bach|roll-on-ai-fiori-di-bach,roll-on-bach|bach;Diffusori per ambienti|diffusori-per-ambienti,diffusori|diffusor,brucia essenz,brucia-essenz,bruciaessenz'
      assign keyword_priority = '3,4,2,1'
    when 'te-tisane'
      assign map = 'Tè e tisane||tè,tisan,infuso,rooibos;Tazze|tazze|tazza,tazze'
      assign keyword_priority = '2,1'
    when 'oggettistica-e-idee-regalo'
      assign map = 'Statuette|statuette|statuett,statua;Lampade di sale|lampade-di-sale|lampada di sale,lampada al sale;Scatole portagioielli|scatole-porta-gioielli|scatola,portagioielli,porta gioielli;Cuscini per il benessere|cuscini-per-il-benessere|cuscin;Diffusori per ambienti|diffusori-per-ambienti,diffusori|diffusor,brucia essenz;Candele e bruciacandele|candele-e-brucia-candele|candela,candele;Incensi e smudge|incensi-e-brucia-incensi|incens,smudge,palo santo;Gioielli con pietre|gioielli-con-pietre|collana,bracciale,orecchin,ciondol;Pietre|pietre-burattate,pietre-grezze|burattat,pietra grezza,pietre grezze;Cosmesi viso|cosmetica|siero viso,crema viso,contorno occhi;Cosmesi corpo|cosmesi-corpo|crema corpo,scrub corpo,olio corpo;Tè e tisane|te-tisane|tè,tisan,infuso'
    else
      assign family_priority = true
      assign map = 'Contorno occhi||contorno occhi;Detergenti||detergent,struc;Tonici||tonic;Sieri||siero,sieri;Maschere||mascher;Scrub||scrub,esfoliant;Balsami||balsam;Saponi||sapon;Creme||crema,creme;Oli||olio,oli ;Candele||candela,candele;Incensi e smudge||incens,smudge,palo santo;Tazze||tazza,tazze;Tè e tisane||tè,tisan,infuso'
  endcase

  assign types = products | map: 'type' | uniq
  assign distinct_types = 0
  for type in types
    if type != blank
      assign distinct_types = distinct_types | plus: 1
    endif
  endfor
  assign by_type = false
  if generic and distinct_types >= 2
    assign by_type = true
    assign map = ''
  endif
  assign rows = map | split: ';'
  assign row_count = rows.size
  assign keyword_priority = keyword_priority | split: ','
  if keyword_priority == empty
    assign default_priority = ''
    for row in rows
      assign default_priority = default_priority | append: forloop.index
      unless forloop.last
        assign default_priority = default_priority | append: ','
      endunless
    endfor
    assign keyword_priority = default_priority | split: ','
  endif
  assign type_fallback = false
  if by_type or collection.handle == 'ayurveda'
    assign type_fallback = true
  endif
  assign department_urls = ''
  if departments
    for row in rows
      assign fields = row | split: '|'
      assign handles = fields[1] | split: ','
      assign child_url = ''
      for handle in handles
        assign child = collections[handle]
        if child.products_count > 0
          assign child_url = child.url
          break
        endif
      endfor
      assign department_urls = department_urls | append: child_url | append: '|'
    endfor
    assign department_urls = department_urls | append: 'end' | split: '|'
  endif
  assign visible_count = 0
  assign assignments = ''
-%}

{%- for product in products -%}
  {%- liquid
    assign key = 0
    if family_priority and row_count > 0
      capture family
        render 'bz-libro-famiglia', product: product, dato: 'catalogo'
      endcapture
      case family
        when 'incensi', 'brucia-incensi', 'palo-santo', 'salvia-e-smudge', 'carta-eritrea'
          for row in rows
            assign fields = row | split: '|'
            if fields.first == 'Incensi e smudge'
              assign key = forloop.index
              break
            endif
          endfor
      endcase
    endif
    if key == 0 and row_count > 0
      assign memberships = product.collections | map: 'handle'
      for row in rows
        assign position = forloop.index
        assign fields = row | split: '|'
        assign handles = fields[1] | split: ','
        for handle in handles
          if memberships contains handle
            assign key = position
            break
          endif
        endfor
        if key > 0
          break
        endif
      endfor

      if key == 0
        assign title = product.title | downcase | append: ' '
        for position in keyword_priority
          assign index = position | minus: 1
          if departments and department_urls[index] == blank
            continue
          endif
          assign fields = rows[index] | split: '|'
          assign keywords = fields[2] | split: ','
          for keyword in keywords
            if title contains keyword
              assign key = index | plus: 1
              break
            endif
          endfor
          if key > 0
            break
          endif
        endfor
      endif
    endif

    if key == 0 and type_fallback and product.type != blank
      for type in types
        if type == product.type
          assign key = row_count | plus: forloop.index
          break
        endif
      endfor
    endif
    assign assignments = assignments | append: key
    unless forloop.last
      assign assignments = assignments | append: ','
    endunless
  -%}
{%- endfor -%}

{%- liquid
  assign assignments = assignments | split: ','
  assign populated_groups = assignments | uniq | size
  assign last_key = row_count
  if type_fallback
    assign last_key = last_key | plus: types.size
  endif
  assign other_key = last_key | plus: 1
-%}
{%- if populated_groups >= 2 -%}
{%- capture chips -%}{%- endcapture -%}
{%- capture groups -%}
  {%- for position in (1..other_key) -%}
    {%- liquid
      assign key = position | append: ''
      if position == other_key
        assign key = '0'
      endif
      assign count = 0
      assign shown = 0
    -%}
    {%- capture cards -%}
      {%- for assignment in assignments -%}
        {%- if assignment == key -%}
          {%- assign count = count | plus: 1 -%}
          {%- if departments == false or shown < 12 -%}
            {%- assign shown = shown | plus: 1 -%}
            {%- assign card = products[forloop.index0] -%}
            {% render 'bz-product-card', card: card, style: 'plp' %}
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}
    {%- if count > 0 -%}
      {%- liquid
        assign visible_count = visible_count | plus: shown
        assign child_url = nil
        if position == other_key
          assign label = 'Altro'
        elsif position <= row_count
          assign index = position | minus: 1
          assign fields = rows[index] | split: '|'
          assign label = fields.first
          if departments
            assign child_url = department_urls[index]
          endif
        else
          assign index = position | minus: row_count | minus: 1
          assign label = types[index]
        endif
      -%}
      {%- capture chip -%}
        <button class="filter-group-option" type="button" data-bz-chip="{{ key }}" data-count="{{ shown }}" aria-pressed="false">{{ label | escape }} <small>{{ count }}</small></button>
      {%- endcapture -%}
      {%- assign chips = chips | append: chip -%}
      {% render 'bz-collection-group', id: key, title: label, count: count, shown: shown, cards: cards, child_url: child_url %}
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{{- populated_groups -}}<!--BZ:GROUPS-->{{- visible_count -}}<!--BZ:GROUPS-->{{- chips -}}<!--BZ:GROUPS-->{{- groups -}}
{%- endif -%}
