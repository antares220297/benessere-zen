{%- liquid
  assign nav = section.settings.menu
  if nav == blank or nav.links.size == 0
    assign nav = linklists['main-menu']
  endif
  if nav == blank or nav.links.size == 0
    assign nav = linklists['bz-menu-v2']
  endif
-%}
<header>
  <a class="brand" href="{{ routes.root_url }}">
    {%- if section.settings.logo != blank -%}
      {{ section.settings.logo | image_url: width: 160 | image_tag: alt: shop.name, loading: 'eager', widths: '80, 120, 160', width: 43, height: 43 }}
    {%- else -%}
      <img src="{{ 'shop-logo.png' | asset_url }}" alt="{{ shop.name | escape }}" width="43" height="43">
    {%- endif -%}
    <span>{{ section.settings.wordmark_lead | default: 'Benessere' | escape }} <em>{{ section.settings.wordmark_accent | default: 'Zen' | escape }}</em></span>
  </a>
  <nav class="main-nav" aria-label="{{ section.settings.menu_label | default: 'Menu principale' | escape }}">
    {%- for link in nav.links -%}
      <div class="nav-item">
        {%- if link.links.size > 0 -%}
          <a href="{{ link.url }}" data-vetrina="{{ forloop.index0 }}" aria-expanded="false" aria-controls="vetrina">{{ link.title | escape }}</a>
        {%- else -%}
          <a href="{{ link.url }}" {% if link.current %}aria-current="page"{% endif %}>{{ link.title | escape }}</a>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </nav>
  <div class="header-actions">
    <a href="{{ routes.search_url }}" aria-label="{{ section.settings.search_label | default: 'Cerca' | escape }}">{% render 'bz-icon', name: 'hdr-search' %}</a>
    <a href="{{ routes.account_url }}" aria-label="{{ section.settings.account_label | default: 'Account' | escape }}">{% render 'bz-icon', name: 'hdr-account' %}</a>
    <button type="button" data-cart-open aria-label="{{ section.settings.cart_label | default: 'Carrello' | escape }}">
      {% render 'bz-icon', name: 'hdr-bag' %}
      <span class="sr-only" data-cart-count>{{ cart.item_count }}</span>
    </button>
    <button class="menu-toggle" type="button" data-bz-burger aria-label="Apri menu" aria-expanded="false" aria-controls="bz-mobile">{% render 'bz-icon', name: 'menu' %}</button>
  </div>

  <section class="vetrina" id="vetrina" aria-label="Categorie del catalogo" hidden>
    <div class="vetrina-top">
      <a class="text-link" data-world-link href="{{ routes.root_url }}">Vedi tutto →</a>
      <button class="vetrina-close" type="button" aria-label="Chiudi menu">{% render 'bz-icon', name: 'close' %}</button>
    </div>
    {%- for link in nav.links -%}
      {%- if link.links.size > 0 -%}
        <div class="b-panel" data-world="{{ forloop.index0 }}" {% unless forloop.first %}hidden{% endunless %}>
          <nav class="b-mothers" aria-label="{{ link.title | escape }}">
            {%- for child in link.links -%}
              <div class="mother-row{% if forloop.first %} is-active{% endif %}">
                <a href="{% render 'bz-link', link: child %}">{{ child.title | escape }}</a>
                <button type="button" data-mother="{{ forloop.index0 }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}" aria-label="{{ child.title | escape }}">{% render 'bz-icon', name: 'chevron_right' %}</button>
              </div>
            {%- endfor -%}
          </nav>
          <div class="b-children">
            {%- for child in link.links -%}
              <div data-children="{{ forloop.index0 }}" {% unless forloop.first %}hidden{% endunless %}>
                {%- for grand in child.links -%}
                  <a class="m-child" href="{% render 'bz-link', link: grand %}">{{ grand.title | escape }}</a>
                {%- endfor -%}
                {%- if child.links.size == 0 -%}
                  <a class="m-child" href="{% render 'bz-link', link: child %}">Vedi tutto</a>
                {%- endif -%}
              </div>
            {%- endfor -%}
          </div>
          <div class="b-photo">
            {%- for child in link.links -%}
              {%- liquid
                assign photo_collection = child.object
                if photo_collection == blank or photo_collection.products_count == nil
                  assign photo_collection = blank
                endif
                assign photo = photo_collection.image | default: photo_collection.featured_image
                if photo == blank and photo_collection.products.first
                  assign photo = photo_collection.products.first.featured_image
                endif
              -%}
              <a class="photo-face" data-photo="{{ forloop.index0 }}" href="{% render 'bz-link', link: child %}" {% unless forloop.first %}hidden{% endunless %}>
                {%- if photo != blank -%}
                  {{ photo | image_url: width: 900 | image_tag: alt: child.title, loading: 'lazy', widths: '400, 700, 900', sizes: '380px' }}
                {%- endif -%}
                <div>
                  <h3>{{ child.title | escape }}</h3>
                  {%- if photo_collection.title != blank -%}
                    {%- capture min_cents -%}{% render 'bz-min-price', handle: photo_collection.handle %}{%- endcapture -%}
                    {%- assign min_cents = min_cents | strip -%}
                    <p>{%- if min_cents != blank -%}da {% render 'bz-money', cents: min_cents %}{% endif %}</p>
                  {%- endif -%}
                  <span class="btn outline">Vedi tutto →</span>
                </div>
              </a>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </section>
</header>

<nav class="mobile-nav menu-shade" id="bz-mobile" hidden aria-label="Menu mobile">
  <button class="menu-backdrop" type="button" aria-label="Chiudi menu"></button>
  <aside class="menu-dialog" role="dialog" aria-modal="true" aria-labelledby="mobile-title" tabindex="-1">
    <div class="menu-heading">
      <span id="mobile-title">Benessere <em>Zen</em></span>
      <button class="phone-close" type="button" aria-label="Chiudi menu">{% render 'bz-icon', name: 'close' %}</button>
    </div>
    <div class="mobile-content">
      <div class="phone-start">
        <form class="phone-search" action="{{ routes.search_url }}" method="get" role="search">
          <label class="sr-only" for="menu-search">Cerca</label>
          <div>
            <input id="menu-search" type="search" name="q" placeholder="Cerca">
            <button type="submit" aria-label="Cerca">{% render 'bz-icon', name: 'search' %}</button>
          </div>
        </form>
        <div class="phone-doors">
          {%- for link in nav.links -%}
            {%- if link.links.size > 0 -%}
              <button class="phone-door" type="button" data-door="{{ forloop.index0 }}">
                <span>{{ link.title | escape }}</span>
                {% render 'bz-icon', name: 'north_east' %}
              </button>
            {%- endif -%}
          {%- endfor -%}
        </div>
        <nav class="phone-links">
          {%- for link in nav.links -%}
            {%- if link.links.size == 0 -%}
              <a href="{{ link.url }}">{% render 'bz-icon', name: 'storefront' %}{{ link.title | escape }}</a>
            {%- endif -%}
          {%- endfor -%}
        </nav>
      </div>
      {%- for link in nav.links -%}
        {%- if link.links.size > 0 -%}
          <div class="phone-panel" data-panel="{{ forloop.index0 }}" hidden>
            <button class="phone-back" type="button">{% render 'bz-icon', name: 'arrow_back' %} {{ link.title | escape }}</button>
            <div class="phone-groups">
              {%- for child in link.links -%}
                <div class="phone-group">
                  {%- if child.links.size > 0 -%}
                    <button class="phone-row mother-row" type="button" aria-expanded="false">{{ child.title | escape }} {% render 'bz-icon', name: 'expand_more' %}</button>
                    <div class="phone-group-children" hidden>
                      {%- for grand in child.links -%}
                        <a href="{% render 'bz-link', link: grand %}">{{ grand.title | escape }}</a>
                      {%- endfor -%}
                    </div>
                  {%- else -%}
                    <a class="phone-row" href="{% render 'bz-link', link: child %}">{{ child.title | escape }} {% render 'bz-icon', name: 'north_east' %}</a>
                  {%- endif -%}
                </div>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
      <div class="phone-bottom">
        {% render 'bz-open-badge', variant: 'compact', linked: true %}
        <p>{{ settings.bz_address | default: 'Via Marcello Provenzali 1, 44042 Cento FE' }}</p>
      </div>
    </div>
  </aside>
</nav>

<div class="cart-overlay" hidden>
  <button class="backdrop" type="button" data-cart-close aria-label="Chiudi carrello"></button>
  <aside class="drawer" role="dialog" aria-modal="true" aria-label="Il tuo carrello" tabindex="-1">
    <button class="close" type="button" data-cart-close aria-label="Chiudi carrello">×</button>
    <h2>Il tuo <em>carrello</em></h2>
    <div class="shipping" data-shipping>
      <p data-shipping-text>
        {%- assign goal = settings.bz_free_shipping | default: 50 | times: 100 -%}
        {%- assign missing = goal | minus: cart.total_price -%}
        {%- if cart.total_price >= goal -%}Spedizione gratuita{%- else -%}Ti mancano <strong>{% render 'bz-money', cents: missing %}</strong> per la spedizione gratuita{%- endif -%}
      </p>
      <div class="shipping-line">
        <div class="track" role="progressbar" aria-valuemin="0" aria-valuemax="{{ goal }}" aria-valuenow="{{ cart.total_price }}">
          <span style="transform:scaleX({{ cart.total_price | times: 1.0 | divided_by: goal | at_most: 1 }})"></span>
        </div>
        <span>{{ settings.bz_free_shipping | default: 50 }} €</span>
      </div>
    </div>
    <div data-cart-rows>
      {%- for item in cart.items -%}
        <div class="cart-row">
          {%- if item.image -%}
            {{ item.image | image_url: width: 200 | image_tag: alt: item.product.title, loading: 'lazy', width: 90, height: 90 }}
          {%- endif -%}
          <div>
            <a href="{{ item.url }}">{{ item.product.title | escape }}</a>
            <p>{{ item.quantity }} × {% render 'bz-money', cents: item.final_price %}</p>
          </div>
        </div>
      {%- else -%}
        <p>Il carrello è vuoto.</p>
      {%- endfor -%}
    </div>
    <div class="cart-total"><span>Totale</span><strong data-cart-total>{% render 'bz-money', cents: cart.total_price %}</strong></div>
    <a class="btn gold" href="{{ routes.cart_url }}/checkout">Vai al pagamento →</a>
    <a class="text-link" href="{{ routes.cart_url }}">Modifica il carrello</a>
  </aside>
</div>

{% render 'bz-hours', part: 'boot' %}
<script>
  window.BZ = {
    add: {{ routes.cart_add_url | append: '.js' | json }},
    cart: {{ routes.cart_url | append: '.js' | json }},
    change: {{ routes.cart_change_url | append: '.js' | json }}
  };
</script>

{% schema %}
{
  "name": "Intestazione",
  "class": "bz-header-section",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "text", "id": "wordmark_lead", "label": "Prima parola", "default": "Benessere" },
    { "type": "text", "id": "wordmark_accent", "label": "Seconda parola", "default": "Zen" },
    { "type": "text", "id": "shop_label", "label": "Testo del link negozio", "default": "Il negozio" },
    { "type": "url", "id": "shop_url", "label": "Pagina del negozio" },
    { "type": "text", "id": "account_label", "label": "Etichetta account", "default": "Account" },
    { "type": "text", "id": "wishlist_label", "label": "Etichetta preferiti", "default": "Preferiti" },
    { "type": "url", "id": "wishlist_url", "label": "Pagina preferiti" },
    { "type": "text", "id": "cart_label", "label": "Etichetta carrello", "default": "Carrello" },
    { "type": "text", "id": "menu_label", "label": "Etichetta del menu", "default": "Menu principale" },
    { "type": "link_list", "id": "menu", "label": "Menu" },
    { "type": "text", "id": "search_label", "label": "Etichetta della ricerca", "default": "Cerca" },
    { "type": "textarea", "id": "placeholder_words", "label": "Parole" },
    { "type": "text", "id": "placeholder_before", "label": "Prima del segnaposto" },
    { "type": "text", "id": "placeholder_after", "label": "Dopo il segnaposto" },
    { "type": "text", "id": "queries_title", "label": "Titolo ricerche" },
    { "type": "text", "id": "stones_title", "label": "Titolo pietre" },
    { "type": "text", "id": "results_title", "label": "Titolo risultati" },
    { "type": "text", "id": "results_link", "label": "Link risultati" },
    { "type": "collection", "id": "search_collection", "label": "Collezione di ricerca" }
  ],
  "blocks": [
    { "type": "link", "name": "Link", "settings": [
      { "type": "text", "id": "label", "label": "Etichetta" },
      { "type": "url", "id": "link", "label": "Link" },
      { "type": "text", "id": "style", "label": "Stile" }
    ] },
    { "type": "query", "name": "Ricerca", "settings": [ { "type": "text", "id": "label", "label": "Etichetta" } ] },
    { "type": "stone", "name": "Pietra", "settings": [ { "type": "text", "id": "label", "label": "Etichetta" } ] }
  ]
}
{% endschema %}
