{{ 'bz-officina.css' | asset_url | stylesheet_tag }}
<script src="{{ 'bz-officina.js' | asset_url }}" defer></script>

{%- if section.blocks.size > 0 -%}
  {%- liquid
    assign first = section.blocks.first
    assign title_id = 'officina-title-' | append: section.id
    assign panel_id = 'officina-panel-' | append: section.id
    assign tab_prefix = 'officina-tab-' | append: section.id | append: '-'
  -%}

  {%- capture chapter_templates -%}
    {%- for block in section.blocks -%}
      {%- assign collection = block.settings.collection -%}
      {%- capture cards -%}
        {%- assign count = 0 -%}
        {%- assign shown = '|' -%}
        {%- if collection != blank -%}
          {%- for product in block.settings.products -%}
            {%- assign collection_handles = product.collections | map: 'handle' -%}
            {%- if collection_handles contains collection.handle -%}
              {% render 'bz-product-card', card: product, style: 'grid' %}
              {%- assign shown = shown | append: product.handle | append: '|' -%}
              {%- assign count = count | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}

          {%- comment -%}Fill gaps with available products first, then include sold-out products if needed.{%- endcomment -%}
          {%- if count < 3 -%}
            {%- assign stock_order = 'available,sold-out' | split: ',' -%}
            {%- for stock in stock_order -%}
              {%- for product in collection.products -%}
                {%- if count == 3 -%}{%- break -%}{%- endif -%}
                {%- if stock == 'available' and product.available == false -%}{%- continue -%}{%- endif -%}
                {%- assign handle_key = product.handle | prepend: '|' | append: '|' -%}
                {%- unless shown contains handle_key -%}
                  {% render 'bz-product-card', card: product, style: 'grid' %}
                  {%- assign shown = shown | append: product.handle | append: '|' -%}
                  {%- assign count = count | plus: 1 -%}
                {%- endunless -%}
              {%- endfor -%}
              {%- if count == 3 -%}{%- break -%}{%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        {%- endif -%}
      {%- endcapture -%}
      {%- if forloop.first -%}{%- assign initial_cards = cards -%}{%- endif -%}
      <template data-officina-products>{{ cards }}</template>
    {%- endfor -%}
  {%- endcapture -%}

  <section class="bz-officina" id="officina" data-bz-officina aria-labelledby="{{ title_id }}" style="--officina-veil: {{ first.settings.veil }}">
    <div class="bz-officina-veil" aria-hidden="true"></div>
    <div class="bz-sh">
      <h2 id="{{ title_id }}" class="bz-ds-reveal is-in">{{ section.settings.heading | escape }} <em>{{ section.settings.heading_accent | escape }}</em></h2>
    </div>
    <div class="bz-officina-layout">
      <div class="bz-pills" role="tablist" aria-label="Capitoli dell'officina del corpo">
        {%- for block in section.blocks -%}
          <button
            type="button"
            role="tab"
            id="{{ tab_prefix }}{{ block.id }}"
            aria-controls="{{ panel_id }}"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
            data-scene="{{ block.settings.scene | asset_url | escape }}"
            data-alt="{{ block.settings.alt | escape }}"
            data-veil="{{ block.settings.veil }}"
            data-caption="{{ block.settings.caption | escape }}"
            data-collection-url="{{ block.settings.collection.url | escape }}"
            {{ block.shopify_attributes }}
          >{{ block.settings.label | escape }}</button>
        {%- endfor -%}
      </div>
      <div id="{{ panel_id }}" role="tabpanel" aria-labelledby="{{ tab_prefix }}{{ first.id }}" tabindex="0">
        <figure class="bz-officina-stage">
          <img class="bz-officina-scene" src="{{ first.settings.scene | asset_url | escape }}" alt="{{ first.settings.alt | escape }}" loading="lazy" decoding="async" draggable="false">
          <figcaption class="bz-officina-cap">
            <h3><a{% if first.settings.collection != blank %} href="{{ first.settings.collection.url | escape }}"{% endif %}>{{ first.settings.label | escape }}</a></h3>
            <p>{{ first.settings.caption | escape }}</p>
          </figcaption>
        </figure>
        <div class="bz-officina-prods">{{ initial_cards }}</div>
      </div>
      <a class="bz-row-link" href="/collections/ayurveda">
        Tutta l'Ayurveda
        <svg viewBox="0 -960 960 960" class="bz-ico bz-ico--sm" aria-hidden="true" focusable="false" fill="currentColor"><path d="M647-440H160v-80h487L423-744l57-56 320 320-320 320-57-56 224-224Z"></path></svg>
      </a>
    </div>
    {{ chapter_templates }}
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Officina del corpo",
  "limit": 1,
  "settings": [
    {"type": "text", "id": "heading", "label": "Titolo", "default": "L'officina del"},
    {"type": "text", "id": "heading_accent", "label": "Corsivo", "default": "corpo"}
  ],
  "blocks": [
    { "type": "chapter", "name": "Capitolo", "settings": [
      {"type": "text", "id": "label", "label": "Titolo", "default": "Olio"},
      {"type": "collection", "id": "collection", "label": "Collezione"},
      {"type": "product_list", "id": "products", "label": "Prodotti preferiti", "limit": 3},
      {"type": "color", "id": "veil", "label": "Velatura", "default": "#3a281c"},
      {"type": "text", "id": "caption", "label": "Didascalia", "default": "Si lascia sui polsi, e resta sulla pelle per tutta la sera."},
      {"type": "text", "id": "alt", "label": "Testo alternativo della scena", "default": "Un contagocce lascia cadere una goccia d'olio sul palmo di una mano"},
      {"type": "text", "id": "scene", "label": "Nome del file della scena", "default": "officina-scena-olio.webp"}
    ] }
  ],
  "max_blocks": 5,
  "presets": [
    { "name": "Officina del corpo", "blocks": [
      {"type": "chapter", "settings": {"label": "Olio", "collection": "profumi-in-olio", "veil": "#3a281c", "caption": "Si lascia sui polsi, e resta sulla pelle per tutta la sera.", "alt": "Un contagocce lascia cadere una goccia d'olio sul palmo di una mano", "scene": "officina-scena-olio.webp"}},
      {"type": "chapter", "settings": {"label": "Bagno", "collection": "sali-da-bagno", "veil": "#1e272c", "caption": "I sali si sciolgono nell'acqua calda, quando si chiude la porta.", "alt": "Una mano versa i sali da una ciotola nell'acqua di una vasca di pietra", "scene": "officina-scena-bagno.webp"}},
      {"type": "chapter", "settings": {"label": "Candela", "collection": "candele-e-brucia-candele", "veil": "#3d2a16", "caption": "Si accende e la stanza cambia odore.", "alt": "Candela accesa in un bicchiere scuro accanto a due pietre viola", "scene": "officina-scena-candela.webp"}},
      {"type": "chapter", "settings": {"label": "Sapone", "collection": "saponi-naturali-ayurvedici", "veil": "#332415", "caption": "Il gesto di ogni mattina, con oli e spezie.", "alt": "Una saponetta bagnata su un portasapone in un lavabo di pietra", "scene": "officina-scena-sapone.webp"}},
      {"type": "chapter", "settings": {"label": "Tisana", "collection": "te-e-tisane-ayurvediche", "veil": "#2e3121", "caption": "Una tazza calda, quando si ha un momento solo per sé.", "alt": "Tazza fumante accanto a bastoncini di cannella", "scene": "officina-scena-tisana.webp"}}
    ] }
  ]
}
{% endschema %}
