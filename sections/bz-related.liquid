{{ 'bz-tokens.css' | asset_url | stylesheet_tag }}
{{ 'bz-home.css' | asset_url | stylesheet_tag }}
{{ 'bz-product.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign type_key = product.type | downcase | strip
  assign show_related = true
  if product != blank and product.available == false
    assign show_related = false
  endif
  assign related_collection = blank
  assign related_heading = 'Altri pezzi'
  assign related_accent = blank
  assign stone_name = blank
  if product != blank and product.metafields.custom.pietra.value != blank
    assign stone_name = product.metafields.custom.pietra.value.nome.value | default: product.metafields.custom.pietra.value.nome
    assign stone_text = stone_name | append: ''
    if stone_text contains 'Metaobject' or stone_text contains 'Drop'
      assign stone_name = blank
    endif
  endif
  if type_key contains 'mala'
    assign related_collection = collections['mala-tibetani']
    assign related_heading = 'Altri mala,'
    assign related_accent = 'stessi 108 grani'
  elsif product != blank
    for col in product.collections
      if related_collection == blank and col.handle != 'all' and col.handle != 'frontpage' and col.products_count > 1
        assign related_collection = col
      endif
    endfor
    if product.type != blank
      assign related_heading = 'Altri ' | append: type_key
      assign stone_fit = false
      if type_key contains 'braccial' or type_key contains 'ciondol' or type_key contains 'collan'
        assign stone_fit = true
      endif
      if stone_name != blank and stone_fit
        assign related_heading = related_heading | append: ' in ' | append: stone_name | downcase
      endif
    endif
  endif
  if related_collection == blank
    assign show_related = false
  endif
-%}
{%- if show_related -%}
<section class="bz bz-product">
  <div class="bz-related">
    <div class="bz-related__head">
      <h2>{{ related_heading | escape }}{% if related_accent != blank %}&nbsp;<em>{{ related_accent | escape }}</em>{% endif %}</h2>
      {%- if related_collection != blank -%}
        <a class="bz-picked__all" href="{{ related_collection.url }}">Vedi la collezione <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
      {%- endif -%}
    </div>
    <div class="bz-grid">
      {%- assign shown = 0 -%}
      {%- assign related_limit = section.settings.limit | default: 5 -%}
      {%- for item in related_collection.products -%}
        {%- if shown < related_limit and item.available -%}
          {%- unless product != blank and item.id == product.id -%}
            {% render 'bz-card', product: item %}
            {%- assign shown = shown | plus: 1 -%}
          {%- endunless -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Prodotti correlati",
  "class": "bz-home",
  "settings": [
    { "type": "range", "id": "limit", "min": 2, "max": 8, "step": 1, "label": "Numero", "default": 5 }
  ],
  "presets": [{ "name": "Prodotti correlati" }]
}
{% endschema %}
