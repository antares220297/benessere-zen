{{ 'bz-tokens.css' | asset_url | stylesheet_tag }}
{{ 'bz-home.css' | asset_url | stylesheet_tag }}
{{ 'bz-product.css' | asset_url | stylesheet_tag }}

{% render 'bz-wave', from: '#2a141b', to: '#141312' %}
<section class="bz bz-product">
  <div class="bz-related">
    {%- liquid
      assign related_collection = section.settings.collection
      assign related_heading = related_collection.title
      assign related_accent = ''
      assign mala_related = false
      if related_collection != blank and related_collection.handle == 'mala-tibetani'
        assign mala_related = true
      endif
      if product.type contains 'Mala'
        assign mala_related = true
      endif
      if mala_related
        assign related_heading = section.settings.heading
        if related_heading == blank
          assign related_heading = 'Altri mala,'
        endif
        assign related_accent = section.settings.heading_accent
        if related_accent == blank
          assign related_accent = 'stessi 108 grani'
        endif
      endif
    -%}
    <div class="bz-related__head">
      <h2>{{ related_heading | escape }}{%- if related_accent != blank -%} <em>{{ related_accent | escape }}</em>{%- endif -%}</h2>
      {%- if section.settings.link_label != blank -%}
        <a class="bz-picked__all" href="{{ section.settings.collection.url }}">{{ section.settings.link_label | escape }} <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
      {%- endif -%}
    </div>
    <div class="bz-grid">
      {%- if section.settings.collection != blank -%}
        {%- assign shown = 0 -%}
        {%- assign room = section.settings.limit | plus: 1 -%}
        {%- for item in section.settings.collection.products limit: room -%}
          {%- unless product != blank and item.id == product.id -%}
            {% render 'bz-card', product: item %}
            {%- assign shown = shown | plus: 1 -%}
          {%- endunless -%}
          {%- if shown == section.settings.limit -%}
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Prodotti correlati",
  "class": "bz-home",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titolo", "default": "Altri mala," },
    { "type": "text", "id": "heading_accent", "label": "Corsivo", "default": "stessi 108 grani" },
    { "type": "text", "id": "link_label", "label": "Link", "default": "Tutti i mala" },
    { "type": "collection", "id": "collection", "label": "Collezione" },
    { "type": "range", "id": "limit", "min": 2, "max": 8, "step": 1, "label": "Numero", "default": 5 }
  ],
  "presets": [{ "name": "Prodotti correlati" }]
}
{% endschema %}
