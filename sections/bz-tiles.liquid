{{ 'bz-tokens.css' | asset_url | stylesheet_tag }}
{{ 'bz-home.css' | asset_url | stylesheet_tag }}
{{ 'bz-pages.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign bz_tiles_any = false
  for block in section.blocks
    if block.settings.collection != blank and block.settings.collection.products_count > 0
      assign bz_tiles_any = true
    endif
  endfor
-%}
{%- if bz_tiles_any -%}
<section class="bz bz-pages bz-tiles">
  {%- if section.settings.heading != blank -%}<h2 class="bz-reveal">{{ section.settings.heading | escape }}</h2>{%- endif -%}
  <div class="bz-tiles__grid">
    {%- for block in section.blocks -%}
      {%- if block.settings.collection != blank and block.settings.collection.products_count > 0 -%}
        {%- assign shot = block.settings.image | default: block.settings.collection.image | default: block.settings.collection.products.first.featured_image -%}
        <a class="bz-ptile bz-reveal" href="{{ block.settings.collection.url }}" {{ block.shopify_attributes }}>
          {%- if shot -%}{{ shot | image_url: width: 800 | image_tag: alt: block.settings.label, loading: 'lazy', widths: '320, 480, 800', sizes: '(min-width: 860px) 30vw, 46vw' }}{%- endif -%}
          <span>{{ block.settings.label | default: block.settings.collection.title | escape }}</span>
        </a>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>
<script src="{{ 'bz-pages.js' | asset_url }}" defer></script>
{%- endif -%}
{% schema %}
{
  "name": "Tessere collezione",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titolo" }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tessera",
      "settings": [
        { "type": "text", "id": "label", "label": "Nome" },
        { "type": "collection", "id": "collection", "label": "Collezione" },
        { "type": "image_picker", "id": "image", "label": "Foto" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "Tessere collezione" }]
}
{% endschema %}
