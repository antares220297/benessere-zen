<section class="ritual-section" id="ritual" data-bundle="{% if section.settings.bundle_discount %}true{% else %}false{% endif %}">
  {%- for block in section.blocks -%}
    <div class="ritual-bg{% if forloop.first %} on{% endif %}" data-tone="{{ forloop.index0 }}" aria-hidden="true"></div>
  {%- endfor -%}
  <div class="bz-sh">
    <h2>{{ section.settings.heading | escape }} <em>{{ section.settings.heading_accent | escape }}</em></h2>
    <div class="bz-pills" role="group" aria-label="Scegli un set">
      {%- for block in section.blocks -%}
        <button type="button" data-set="{{ forloop.index0 }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}">{{ block.settings.label | escape }}</button>
      {%- endfor -%}
    </div>
  </div>
  {%- for block in section.blocks -%}
    <div class="ritual-grid" data-ritual-set="{{ forloop.index0 }}" {% unless forloop.first %}hidden{% endunless %}>
      <div class="ritual-list">
        <div>
          {%- for key in (1..3) -%}
            {%- liquid
              if key == 1
                assign product = block.settings.product_1
              elsif key == 2
                assign product = block.settings.product_2
              else
                assign product = block.settings.product_3
              endif
            -%}
            {%- if product != blank and product.title != blank -%}
              {%- assign variant = product.selected_or_first_available_variant -%}
              <label class="ritual-row{% unless product.available %} is-unavailable{% endunless %}">
                <input class="sr-only" type="checkbox" {% if product.available %}checked data-variant="{{ variant.id }}" data-price="{{ variant.price }}"{% else %}disabled{% endif %} aria-label="Includi nel set: {{ product.title | escape }}">
                <span class="set-check">{% render 'bz-icon', name: 'check' %}</span>
                {%- if product.featured_image -%}
                  {{ product.featured_image | image_url: width: 160 | image_tag: alt: '', loading: 'lazy', width: 56, height: 56 }}
                {%- endif -%}
                <span>
                  <span class="ritual-product">{{ product.title | escape }}</span>
                  <span class="row-price">{% render 'bz-money', cents: product.price %}</span>
                </span>
              </label>
            {%- endif -%}
          {%- endfor -%}
        </div>
        <div class="ritual-total">
          <div>
            <small class="ritual-count"></small>
            <div class="ritual-sum price"></div>
            <p class="ritual-saving" hidden></p>
          </div>
          <button class="btn gold" type="button" data-add-ritual>Aggiungi al carrello →</button>
        </div>
        <div class="ritual-shipping">
          <p class="ritual-shipping-text"></p>
          <div class="track" role="progressbar" aria-label="Verso la spedizione gratuita" aria-valuemin="0" aria-valuemax="50">
            <span class="ritual-progress"></span>
          </div>
        </div>
      </div>
      <div class="ritual-visual">
        {%- liquid
          assign shot = block.settings.image
          assign asset = block.settings.image_asset
        -%}
        {%- if shot != blank -%}
          {{ shot | image_url: width: 1600 | image_tag: alt: block.settings.label, loading: 'lazy', class: 'ritual-shot', widths: '600, 1000, 1600', sizes: '(min-width: 900px) 50vw, 100vw' }}
        {%- elsif asset != blank -%}
          <img class="ritual-shot" src="{{ asset | asset_url }}" alt="{{ block.settings.label | escape }}" width="1600" height="1200" loading="lazy">
        {%- endif -%}
        <div class="ritual-caption">
          <h3>Il set <em>{{ block.settings.label | escape }}</em></h3>
          <p>{{ block.settings.caption | escape }}</p>
        </div>
      </div>
    </div>
  {%- endfor -%}
</section>
{% schema %}
{
  "name": "Rituale home",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titolo", "default": "Completa" },
    { "type": "text", "id": "heading_accent", "label": "Corsivo", "default": "il rituale" },
    { "type": "checkbox", "id": "bundle_discount", "label": "Sconto bundle 10% attivo", "info": "Mostra «10% in meno» solo se tutti i pezzi sono selezionati e questo sconto è davvero configurato (per esempio con Shopify Bundles). Spento: si vede solo la somma.", "default": false }
  ],
  "blocks": [
    { "type": "set", "name": "Set", "settings": [
      { "type": "text", "id": "label", "label": "Nome", "default": "Serenità" },
      { "type": "text", "id": "caption", "label": "Didascalia" },
      { "type": "image_picker", "id": "image", "label": "Foto" },
      { "type": "text", "id": "image_asset", "label": "Nome file in assets, se non c'è una foto", "default": "bz-rituale-serenita.jpg" },
      { "type": "product", "id": "product_1", "label": "Pezzo 1" },
      { "type": "product", "id": "product_2", "label": "Pezzo 2" },
      { "type": "product", "id": "product_3", "label": "Pezzo 3" }
    ] }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "Completa il rituale" }]
}
{% endschema %}
