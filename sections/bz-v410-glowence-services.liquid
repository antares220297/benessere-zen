{{ 'bz-tokens.css' | asset_url | stylesheet_tag }}
{{ 'bz-home.css' | asset_url | stylesheet_tag }}
{{ 'bz-v410-glowence-services.css' | asset_url | stylesheet_tag }}

<section class="bz bz-v410-services"{% if section.settings.heading != blank or section.settings.heading_accent != blank %} aria-labelledby="BzServicesTitle-{{ section.id }}"{% endif %}>
  {%- if section.settings.heading != blank or section.settings.heading_accent != blank -%}
    <h2 class="bz-reveal" id="BzServicesTitle-{{ section.id }}">
      {{- section.settings.heading | escape -}}
      {%- if section.settings.heading_accent != blank %} <em>{{ section.settings.heading_accent | escape }}</em>{%- endif -%}
    </h2>
  {%- endif -%}
  {%- if section.settings.intro != blank -%}
    <p class="bz-v410-services__intro bz-reveal">{{ section.settings.intro | escape | newline_to_br }}</p>
  {%- endif -%}

  <div class="bz-v410-services__row">
    {%- for block in section.blocks -%}
      {%- if block.type == 'card' -%}
        <article class="bz-v410-services__card bz-reveal" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {%- liquid
              assign bz_alt = block.settings.image_alt | strip
              if bz_alt == blank
                assign bz_alt = block.settings.title | strip
              endif
            -%}
            <div class="bz-v410-services__still">
              {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: bz_alt, class: 'bz-v410-services__img', widths: '340, 480, 680, 800', sizes: '(max-width: 420px) 82vw, 340px' }}
            </div>
          {%- endif -%}
          {%- if block.settings.title != blank -%}
            <h3>{{ block.settings.title | escape }}</h3>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <p>{{ block.settings.text | escape | newline_to_br }}</p>
          {%- endif -%}
          {%- if block.settings.cta_label != blank -%}
            {%- liquid
              assign bz_href = block.settings.cta_link
              if bz_href == blank
                assign bz_href = section.settings.fallback_link
              endif
            -%}
            {%- if bz_href != blank -%}
              <a class="bz-btn bz-btn--line" href="{{ bz_href }}">{{ block.settings.cta_label | escape }}</a>
            {%- else -%}
              <span class="bz-btn bz-btn--line">{{ block.settings.cta_label | escape }}</span>
            {%- endif -%}
          {%- endif -%}
        </article>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

<script src="{{ 'bz-pages.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Consigli in negozio",
  "class": "bz-home",
  "enabled_on": { "templates": ["page"] },
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titolo",
      "default": "In negozio"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Titolo in corsivo",
      "default": "con Simona"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Introduzione",
      "default": "Due consigli che si chiedono al banco, a Cento. Niente sedute e niente listino."
    },
    {
      "type": "url",
      "id": "fallback_link",
      "label": "Link di riserva",
      "info": "Si usa quando la scheda non ha un link proprio."
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Scheda",
      "settings": [
        { "type": "text", "id": "title", "label": "Titolo" },
        { "type": "textarea", "id": "text", "label": "Testo" },
        { "type": "image_picker", "id": "image", "label": "Immagine", "info": "Se è vuota, la scheda non mostra un riquadro." },
        { "type": "text", "id": "image_alt", "label": "Testo alternativo" },
        { "type": "text", "id": "cta_label", "label": "Etichetta" },
        { "type": "url", "id": "cta_link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Consigli in negozio",
      "settings": {
        "heading": "In negozio",
        "heading_accent": "con Simona",
        "intro": "Due consigli che si chiedono al banco, a Cento. Niente sedute e niente listino."
      },
      "blocks": [
        {
          "type": "card",
          "settings": {
            "title": "Dosha",
            "text": "In negozio si può chiedere un consiglio sui tre dosha, per scegliere un olio, un tè, un gesto. Non è una diagnosi e non sostituisce un medico.",
            "cta_label": "Vieni in negozio"
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "Chakra",
            "text": "Un consiglio sui chakra, a partire da quello che porti già. È la tradizione del banco, non una terapia.",
            "cta_label": "Vieni in negozio"
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "Una pratica di tanti anni",
            "text": "Per oltre trent’anni Simona ha lavorato con il massaggio ayurvedico e con il Reiki. Non è un servizio che si prenota oggi in bottega.",
            "cta_label": "Scrivici"
          }
        }
      ]
    }
  ]
}
{% endschema %}
