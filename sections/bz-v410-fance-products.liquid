{%- liquid
  assign limit = section.settings.limit | default: 8 | plus: 0
  assign grid_tag = section.settings.tag | strip
  assign grid_type = section.settings.product_type | strip
  assign grid_use_blocks = false
  assign grid_from_block = false
  assign grid_cards = ''
  assign shown = 0
  assign grid_collection = false
  assign grid_show_heading = true
  if section.settings.show_heading == false
    assign grid_show_heading = false
  endif

  for block in section.blocks
    if block.type == 'product' and block.settings.product != blank
      assign grid_use_blocks = true
      break
    endif
  endfor

  unless grid_use_blocks
    if section.settings.collection != blank
      assign grid_collection = section.settings.collection
    elsif collection != blank
      assign grid_collection = collection
    endif
  endunless
-%}

{%- if grid_use_blocks -%}
  {%- for block in section.blocks -%}
    {%- assign product = block.settings.product -%}
    {%- if product != blank and shown < limit -%}
      {%- liquid
        assign grid_pass = true
        if grid_tag != blank
          unless product.tags contains grid_tag
            assign grid_pass = false
          endunless
        endif
        if grid_pass and grid_type != blank
          assign grid_type_now = product.type | strip
          if grid_type_now != grid_type
            assign grid_pass = false
          endif
        endif
        if grid_pass and section.settings.skip_sold_out and product.available == false
          assign grid_pass = false
        endif
        assign grid_from_block = true
      -%}
      {%- if grid_pass -%}
        {%- liquid
          if shown == 0
            assign grid_loading = 'eager'
          else
            assign grid_loading = 'lazy'
          endif
          assign photo_alt = product.featured_image.alt | default: product.title
          assign grid_variant = product.selected_or_first_available_variant
        -%}
        {%- capture grid_card -%}
<article class="bz-v410-grid__card{% unless product.available %} is-sold{% endunless %}"{% if grid_from_block %} {{ block.shopify_attributes }}{% endif %}>
  <a class="bz-v410-grid__photo" href="{{ product.url }}"{% if product.featured_image == blank %} aria-label="{{ product.title | escape }}"{% endif %}>
    {%- if grid_variant != blank and grid_variant.inventory_management != blank and grid_variant.inventory_quantity == 1 and product.available -%}
      <span class="bz-v410-grid__badge">Ultimo pezzo</span>
    {%- endif -%}
    {%- if product.featured_image != blank -%}
      {{ product.featured_image | image_url: width: 800 | image_tag: alt: photo_alt, class: 'bz-v410-grid__img', widths: '240, 360, 480, 640, 800', sizes: '(min-width: 900px) 25vw, 46vw', loading: grid_loading, width: product.featured_image.width, height: product.featured_image.height }}
    {%- endif -%}
  </a>
  <div class="bz-v410-grid__panel">
    <a class="bz-v410-grid__name" href="{{ product.url }}">{{ product.title | escape }}</a>
    <p class="bz-v410-grid__price">{% render 'bz-money', cents: product.price %}</p>
    {%- if product.available -%}
      <form class="bz-v410-grid__form" action="{{ routes.cart_add_url }}" method="post">
        {%- if product.has_only_default_variant -%}
          <input type="hidden" name="id" value="{{ grid_variant.id }}">
          <button class="bz-v410-grid__add" type="submit" aria-label="Aggiungi {{ product.title | escape }}">Aggiungi</button>
        {%- else -%}
          <select class="bz-v410-grid__select" name="id" aria-label="Variante di {{ product.title | escape }}">
            {%- for variant in product.variants -%}
              <option value="{{ variant.id }}"{% if grid_variant != blank and variant.id == grid_variant.id %} selected{% endif %}{% unless variant.available %} disabled{% endunless %}>{{ variant.title | escape }}{% unless variant.available %} esaurito{% endunless %}</option>
            {%- endfor -%}
          </select>
          <button class="bz-v410-grid__add" type="submit">Aggiungi</button>
        {%- endif -%}
      </form>
    {%- else -%}
      <p class="bz-v410-grid__sold">Esaurito</p>
    {%- endif -%}
  </div>
</article>
        {%- endcapture -%}
        {%- liquid
          assign grid_cards = grid_cards | append: grid_card
          assign shown = shown | plus: 1
        -%}
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
  {%- if shown > 0 -%}
    {{ 'bz-tokens.css' | asset_url | stylesheet_tag }}
    {{ 'bz-home.css' | asset_url | stylesheet_tag }}
    {{ 'bz-v410-fance-products.css' | asset_url | stylesheet_tag }}
    <section class="bz bz-v410-grid" id="bz-v410-{{ section.id }}"{% if grid_show_heading and section.settings.heading != blank %} aria-labelledby="bz-v410-h-{{ section.id }}"{% endif %}>
      {%- if grid_show_heading and section.settings.heading != blank -%}
        <div class="bz-v410-grid__head">
          <h2 class="bz-reveal" id="bz-v410-h-{{ section.id }}">{{ section.settings.heading | escape }}{%- if section.settings.heading_accent != blank %} <em>{{ section.settings.heading_accent | escape }}</em>{%- endif -%}</h2>
          {%- if section.settings.link_label != blank and section.settings.link != blank -%}
            <a class="bz-btn bz-btn--line" href="{{ section.settings.link }}">{{ section.settings.link_label | escape }}</a>
          {%- endif -%}
        </div>
      {%- elsif section.settings.link_label != blank and section.settings.link != blank -%}
        <div class="bz-v410-grid__head">
          <a class="bz-btn bz-btn--line" href="{{ section.settings.link }}">{{ section.settings.link_label | escape }}</a>
        </div>
      {%- endif -%}
      <div class="bz-v410-grid__list">{{ grid_cards }}</div>
    </section>
    <script src="{{ 'bz-pages.js' | asset_url }}" defer></script>
  {%- endif -%}
{%- elsif grid_collection != blank and section.settings.paginate -%}
  {%- paginate grid_collection.products by limit -%}
    {%- for product in grid_collection.products -%}
      {%- if shown < limit -%}
        {%- liquid
          assign grid_pass = true
          if grid_tag != blank
            unless product.tags contains grid_tag
              assign grid_pass = false
            endunless
          endif
          if grid_pass and grid_type != blank
            assign grid_type_now = product.type | strip
            if grid_type_now != grid_type
              assign grid_pass = false
            endif
          endif
          if grid_pass and section.settings.skip_sold_out and product.available == false
            assign grid_pass = false
          endif
        -%}
        {%- if grid_pass -%}
          {%- liquid
            if shown == 0
              assign grid_loading = 'eager'
            else
              assign grid_loading = 'lazy'
            endif
            assign photo_alt = product.featured_image.alt | default: product.title
            assign grid_variant = product.selected_or_first_available_variant
          -%}
          {%- capture grid_card -%}
<article class="bz-v410-grid__card{% unless product.available %} is-sold{% endunless %}">
  <a class="bz-v410-grid__photo" href="{{ product.url }}"{% if product.featured_image == blank %} aria-label="{{ product.title | escape }}"{% endif %}>
    {%- if grid_variant != blank and grid_variant.inventory_management != blank and grid_variant.inventory_quantity == 1 and product.available -%}
      <span class="bz-v410-grid__badge">Ultimo pezzo</span>
    {%- endif -%}
    {%- if product.featured_image != blank -%}
      {{ product.featured_image | image_url: width: 800 | image_tag: alt: photo_alt, class: 'bz-v410-grid__img', widths: '240, 360, 480, 640, 800', sizes: '(min-width: 900px) 25vw, 46vw', loading: grid_loading, width: product.featured_image.width, height: product.featured_image.height }}
    {%- endif -%}
  </a>
  <div class="bz-v410-grid__panel">
    <a class="bz-v410-grid__name" href="{{ product.url }}">{{ product.title | escape }}</a>
    <p class="bz-v410-grid__price">{% render 'bz-money', cents: product.price %}</p>
    {%- if product.available -%}
      <form class="bz-v410-grid__form" action="{{ routes.cart_add_url }}" method="post">
        {%- if product.has_only_default_variant -%}
          <input type="hidden" name="id" value="{{ grid_variant.id }}">
          <button class="bz-v410-grid__add" type="submit" aria-label="Aggiungi {{ product.title | escape }}">Aggiungi</button>
        {%- else -%}
          <select class="bz-v410-grid__select" name="id" aria-label="Variante di {{ product.title | escape }}">
            {%- for variant in product.variants -%}
              <option value="{{ variant.id }}"{% if grid_variant != blank and variant.id == grid_variant.id %} selected{% endif %}{% unless variant.available %} disabled{% endunless %}>{{ variant.title | escape }}{% unless variant.available %} esaurito{% endunless %}</option>
            {%- endfor -%}
          </select>
          <button class="bz-v410-grid__add" type="submit">Aggiungi</button>
        {%- endif -%}
      </form>
    {%- else -%}
      <p class="bz-v410-grid__sold">Esaurito</p>
    {%- endif -%}
  </div>
</article>
          {%- endcapture -%}
          {%- liquid
            assign grid_cards = grid_cards | append: grid_card
            assign shown = shown | plus: 1
          -%}
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
    {%- liquid
      assign grid_page_empty = false
      if shown == 0 and grid_collection.products_count > 0
        assign grid_page_empty = true
      endif
    -%}
    {%- if shown > 0 or grid_page_empty -%}
      {{ 'bz-tokens.css' | asset_url | stylesheet_tag }}
      {{ 'bz-home.css' | asset_url | stylesheet_tag }}
      {{ 'bz-v410-fance-products.css' | asset_url | stylesheet_tag }}
      <section class="bz bz-v410-grid" id="bz-v410-{{ section.id }}"{% if grid_show_heading and section.settings.heading != blank %} aria-labelledby="bz-v410-h-{{ section.id }}"{% endif %}>
        {%- if grid_show_heading and section.settings.heading != blank -%}
          <div class="bz-v410-grid__head">
            <h2 class="bz-reveal" id="bz-v410-h-{{ section.id }}">{{ section.settings.heading | escape }}{%- if section.settings.heading_accent != blank %} <em>{{ section.settings.heading_accent | escape }}</em>{%- endif -%}</h2>
            {%- if section.settings.link_label != blank and section.settings.link != blank -%}
              <a class="bz-btn bz-btn--line" href="{{ section.settings.link }}">{{ section.settings.link_label | escape }}</a>
            {%- endif -%}
          </div>
        {%- elsif section.settings.link_label != blank and section.settings.link != blank -%}
          <div class="bz-v410-grid__head">
            <a class="bz-btn bz-btn--line" href="{{ section.settings.link }}">{{ section.settings.link_label | escape }}</a>
          </div>
        {%- endif -%}
        {%- if shown > 0 -%}
          <div class="bz-v410-grid__list">{{ grid_cards }}</div>
        {%- else -%}
          <p class="bz-v410-grid__empty">Nessun pezzo in questa pagina.</p>
        {%- endif -%}
        {%- if paginate.pages > 1 -%}
          <nav class="bz-v410-grid__pages" aria-label="Paginazione">
            {%- if paginate.previous -%}
              <a href="{{ paginate.previous.url }}#bz-v410-{{ section.id }}" rel="prev">Precedente</a>
            {%- endif -%}
            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}
                <a href="{{ part.url }}#bz-v410-{{ section.id }}">{{ part.title }}</a>
              {%- elsif part.title == paginate.current_page -%}
                <span aria-current="page">{{ part.title }}</span>
              {%- else -%}
                <span>{{ part.title }}</span>
              {%- endif -%}
            {%- endfor -%}
            {%- if paginate.next -%}
              <a href="{{ paginate.next.url }}#bz-v410-{{ section.id }}" rel="next">Successiva</a>
            {%- endif -%}
          </nav>
        {%- endif -%}
      </section>
      <script src="{{ 'bz-pages.js' | asset_url }}" defer></script>
    {%- endif -%}
  {%- endpaginate -%}
