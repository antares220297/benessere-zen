{% schema %}
{
  "name": "Griglia prodotti",
  "class": "bz-home",
  "enabled_on": {
    "templates": ["index", "collection"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "show_heading",
      "label": "Mostra il titolo",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titolo",
      "default": "Pezzi",
      "info": "Se «Mostra il titolo» è spento, il titolo non compare. Utile in pagina collezione, dove il nome è già sopra."
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Titolo in corsivo",
      "default": "da vicino"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Testo del link",
      "default": "Vedi tutti"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collezione",
      "info": "Se è vuota, nella pagina collezione usiamo la collezione aperta. Se almeno un blocco ha un prodotto, i blocchi sostituiscono la collezione."
    },
    {
      "type": "text",
      "id": "tag",
      "label": "Tag",
      "info": "Vuoto: tutti i pezzi. Altrimenti solo i prodotti che hanno questo tag."
    },
    {
      "type": "text",
      "id": "product_type",
      "label": "Tipo prodotto",
      "info": "Vuoto: tutti i tipi. Altrimenti solo i prodotti il cui tipo è uguale a questo testo."
    },
    {
      "type": "range",
      "id": "limit",
      "min": 4,
      "max": 16,
      "step": 1,
      "label": "Numero di pezzi",
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "paginate",
      "label": "Dividi la collezione in pagine",
      "default": false,
      "info": "Solo per la collezione. I blocchi prodotto non si paginano: Shopify non può paginare un elenco di blocchi."
    },
    {
      "type": "checkbox",
      "id": "skip_sold_out",
      "label": "Salta i pezzi esauriti",
      "default": false,
      "info": "Spento: i pezzi esauriti restano in griglia, anche in pagina collezione."
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Prodotto",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Prodotto"
        }
      ]
    }
  ],
  "max_blocks": 16,
  "presets": [
    {
      "name": "Griglia prodotti"
    }
  ]
}
{% endschema %}
