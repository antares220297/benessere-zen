{%- if section.blocks.size > 0 -%}
  {{ 'bz-ayurveda-timeline.css' | asset_url | stylesheet_tag }}
  <section id="storia" class="ayt" aria-labelledby="ayt-heading-{{ section.id }}"
    data-curve="{{ section.settings.curve_width }}" data-disable-sticky="{{ section.settings.disable_sticky }}"
    style="--ayt-stages: {{ section.blocks.size }}; --ayt-gold: {{ section.settings.line_color }};">
    <script>
      (() => {
        if (!window.IntersectionObserver || !window.ResizeObserver) return;
        const timeline = document.currentScript.parentElement;
        const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
        const forced = new URLSearchParams(location.search).get('static') === '1';
        const desktop = matchMedia('(min-width: 900px)').matches;
        timeline.dataset.mode = reduced || forced || (desktop && timeline.dataset.disableSticky === 'true')
          ? 'static' : desktop ? 'scrolly' : 'flow';
      })();
    </script>
    <div class="ayt-head-row">
      <h2 id="ayt-heading-{{ section.id }}">{{ section.settings.heading }}</h2>
    </div>
    <div class="ayt-track">
      <div class="ayt-rail" aria-hidden="true">
        <svg class="ayt-svg" focusable="false" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <linearGradient id="ayt-grad-{{ section.id }}" gradientUnits="userSpaceOnUse" x1="0" x2="0" y1="0" y2="1000">
              <stop offset="0" stop-color="#e3cb95"/>
              <stop offset=".55" stop-color="{{ section.settings.line_color }}"/>
              <stop offset="1" stop-color="#a8864f"/>
            </linearGradient>
          </defs>
          <path class="ayt-p-base" d=""/>
          <path class="ayt-p-glow" d=""/>
          <path class="ayt-p-line" d="" stroke="url(#ayt-grad-{{ section.id }})"/>
        </svg>
        {%- for block in section.blocks -%}
          <span class="ayt-med"><span>{{ block.settings.numeral | escape }}</span></span>
        {%- endfor -%}
        <span class="ayt-end"></span>
        <span class="ayt-headdot"></span>
      </div>
      <div class="ayt-media">
        <div class="ayt-sticky">
          <div class="ayt-frame">
            {%- for block in section.blocks -%}
              <div class="ayt-slide" data-i="{{ forloop.index0 }}"{% unless forloop.first %} aria-hidden="true"{% endunless %}>
                {% render 'bz-ayt-image', image: block.settings.image, painting: block.settings.painting, alt: block.settings.image_alt %}
              </div>
            {%- endfor -%}
          </div>
          <p class="ayt-caps" aria-hidden="true">
            {%- for block in section.blocks -%}
              <span class="ayt-cap{% if forloop.first %} is-on{% endif %}"><b>{{ block.settings.numeral | escape }}</b><i>{{ block.settings.title | escape }}</i></span>
            {%- endfor -%}
            <span class="ayt-count"><span class="ayt-bar"></span></span>
          </p>
        </div>
      </div>
      {%- for block in section.blocks -%}
        <article class="ayt-stage" style="--i: {{ forloop.index }};" aria-labelledby="ayt-title-{{ block.id }}" {{ block.shopify_attributes }}>
          <figure class="ayt-fig">
            {% render 'bz-ayt-image', image: block.settings.image, painting: block.settings.painting, alt: block.settings.image_alt %}
          </figure>
          <div class="ayt-txt">
            <span class="ayt-ghost" aria-hidden="true">{{ block.settings.numeral | escape }}</span>
            <p class="ayt-when">{{ block.settings.date | escape }}</p>
            <h3 id="ayt-title-{{ block.id }}">{{ block.settings.title | escape }}</h3>
            <div class="ayt-body">{{ block.settings.body }}</div>
          </div>
        </article>
      {%- endfor -%}
    </div>
  </section>
  <script src="{{ 'bz-ayurveda-timeline.js' | asset_url }}" defer></script>
{%- endif -%}

{% schema %}
{
  "name": "Storia dell’Ayurveda",
  "class": "bz-ayt-section",
  "max_blocks": 8,
  "settings": [
    { "type": "inline_richtext", "id": "heading", "label": "Titolo", "default": "Una storia <em>di millenni</em>" },
    { "type": "color", "id": "line_color", "label": "Colore del filo", "default": "#c9a96e" },
    { "type": "range", "id": "curve_width", "label": "Ampiezza della curva", "min": 0, "max": 150, "step": 5, "unit": "%", "default": 100 },
    { "type": "checkbox", "id": "disable_sticky", "label": "Disattiva lo scorrimento su desktop", "default": false }
  ],
  "blocks": [
    {
      "type": "stage",
      "name": "Tappa",
      "settings": [
        { "type": "text", "id": "date", "label": "Data" },
        { "type": "text", "id": "title", "label": "Titolo" },
        { "type": "richtext", "id": "body", "label": "Testo" },
        { "type": "image_picker", "id": "image", "label": "Immagine" },
        { "type": "text", "id": "numeral", "label": "Numero romano" },
        { "type": "text", "id": "image_alt", "label": "Descrizione della tavola predefinita" },
        {
          "type": "select", "id": "painting", "label": "Tavola predefinita", "default": "tappa-1-atharvaveda",
          "options": [
            { "value": "tappa-1-atharvaveda", "label": "Atharvaveda" },
            { "value": "tappa-2-charaka", "label": "Charaka" },
            { "value": "tappa-3-sushruta", "label": "Sushruta" },
            { "value": "tappa-4-vagbhata", "label": "Vagbhata" }
          ]
        }
      ]
    }
  ],
  "presets": [{ "name": "Storia dell’Ayurveda" }]
}
{% endschema %}
