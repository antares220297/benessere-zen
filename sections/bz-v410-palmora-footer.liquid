{{ 'bz-tokens.css' | asset_url | stylesheet_tag }}
{{ 'bz-home.css' | asset_url | stylesheet_tag }}
{{ 'bz-v410-palmora-footer.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign wordmark = section.settings.wordmark | strip
  if wordmark == blank
    assign wordmark = 'Benessere Zen'
  endif

  assign raw_address = section.settings.address | strip
  assign street = raw_address
  assign postal = ''
  assign city = ''
  assign region = ''
  if raw_address != blank
    assign addr_bits = raw_address | split: ','
    assign street = addr_bits | first | strip
    assign tail = raw_address | remove_first: street | remove_first: ',' | strip
    assign tail_words = tail | split: ' '
    assign postal = tail_words | first | default: '' | strip
    if tail_words.size > 1
      assign city = tail_words[1] | strip
    endif
    if tail contains '('
      assign region = tail | split: '(' | last | split: ')' | first | strip
    endif
  endif

  if section.settings.logo != blank
    assign ld_image = section.settings.logo | image_url: width: 400
  else
    assign ld_image = 'shop-logo.png' | asset_url
  endif
  unless ld_image contains '://'
    if ld_image contains '//'
      assign ld_image = ld_image | prepend: 'https:'
    endif
  endunless

  assign phone_href = section.settings.phone | strip | replace: ' ', ''
-%}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": {{ wordmark | json }},
  "url": {{ shop.url | json }},
  "image": {{ ld_image | json }}
  {%- if section.settings.phone != blank -%}
  ,"telephone": {{ section.settings.phone | json }}
  {%- endif -%}
  {%- if section.settings.email != blank -%}
  ,"email": {{ section.settings.email | json }}
  {%- endif -%}
  {%- if raw_address != blank -%}
  ,"address": {
    "@type": "PostalAddress",
    "streetAddress": {{ street | json }},
    "postalCode": {{ postal | json }},
    "addressLocality": {{ city | json }},
    "addressRegion": {{ region | json }},
    "addressCountry": "IT"
  }
  {%- endif -%}
}
</script>

<footer class="bz bz-v410-footer">
  {%- if wordmark != blank -%}
    <a class="bz-v410-footer__word" href="{{ routes.root_url }}">{{ wordmark | escape }}</a>
  {%- endif -%}

  <div class="bz-v410-footer__cols">
    <div class="bz-v410-footer__contact">
      {%- if section.settings.logo != blank -%}
        {{ section.settings.logo | image_url: width: 96 | image_tag: alt: '', width: 48, height: 48, class: 'bz-v410-footer__logo', loading: 'lazy' }}
      {%- else -%}
        <img class="bz-v410-footer__logo" src="{{ 'shop-logo.png' | asset_url }}" alt="" width="48" height="48">
      {%- endif -%}

      {%- if raw_address != blank -%}
        <p class="bz-v410-footer__address">{{ raw_address | escape }}</p>
      {%- endif -%}

      {%- if section.settings.phone != blank -%}
        <a class="bz-v410-footer__tap" href="tel:{{ phone_href | escape }}">{{ section.settings.phone | escape }}</a>
      {%- endif -%}

      {%- if section.settings.email != blank -%}
        <a class="bz-v410-footer__tap" href="mailto:{{ section.settings.email | strip | escape }}">{{ section.settings.email | escape }}</a>
      {%- endif -%}

      {%- if section.settings.hours != blank -%}
        <p class="bz-v410-footer__hours">{{ section.settings.hours | escape }}</p>
      {%- endif -%}

      {%- if section.settings.note != blank -%}
        <p class="bz-v410-footer__note">{{ section.settings.note | escape }}</p>
      {%- endif -%}
    </div>

    <nav class="bz-v410-footer__menus" aria-label="Menu">
      {%- for block in section.blocks -%}
        {%- assign column_heading = block.settings.heading | downcase | strip -%}
        {%- if block.type == 'links' and column_heading != 'seguici' -%}
          <div class="bz-v410-footer__col" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}
              <h2 class="bz-v410-footer__heading">{{ block.settings.heading | escape }}</h2>
            {%- endif -%}
            <ul class="bz-v410-footer__list">
              {%- if block.settings.menu != blank -%}
                {%- for link in block.settings.menu.links -%}
                  {%- if link.title != blank -%}
                    <li>
                      {%- if link.url != blank -%}
                        <a class="bz-v410-footer__tap" href="{{ link.url }}">{{ link.title | escape }}</a>
                      {%- else -%}
                        <span class="bz-v410-footer__tap">{{ link.title | escape }}</span>
                      {%- endif -%}
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              {%- else -%}
                {%- assign keys = 'link_1,link_2,link_3,link_4' | split: ',' -%}
                {%- assign labels = 'label_1,label_2,label_3,label_4' | split: ',' -%}
                {%- for key in keys -%}
                  {%- assign label = block.settings[labels[forloop.index0]] -%}
                  {%- assign href = block.settings[key] -%}
                  {%- if label != blank -%}
                    <li>
                      {%- if href != blank -%}
                        <a class="bz-v410-footer__tap" href="{{ href }}">{{ label | escape }}</a>
                      {%- else -%}
                        <span class="bz-v410-footer__tap">{{ label | escape }}</span>
                      {%- endif -%}
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}
            </ul>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </nav>

    <div class="bz-v410-footer__social">
      {%- for block in section.blocks -%}
        {%- assign column_heading = block.settings.heading | downcase | strip -%}
        {%- if block.type == 'links' and column_heading == 'seguici' -%}
          <div class="bz-v410-footer__col" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}
              <h2 class="bz-v410-footer__heading">{{ block.settings.heading | escape }}</h2>
            {%- endif -%}
            <ul class="bz-v410-footer__list">
              {%- if settings.social_instagram_link != blank -%}
                <li><a class="bz-v410-footer__tap" href="{{ settings.social_instagram_link }}">Instagram</a></li>
              {%- endif -%}
              {%- if settings.social_facebook_link != blank -%}
                <li><a class="bz-v410-footer__tap" href="{{ settings.social_facebook_link }}">Facebook</a></li>
              {%- endif -%}
              {%- if settings.social_tiktok_link != blank -%}
                <li><a class="bz-v410-footer__tap" href="{{ settings.social_tiktok_link }}">TikTok</a></li>
              {%- endif -%}
              {%- if settings.social_youtube_link != blank -%}
                <li><a class="bz-v410-footer__tap" href="{{ settings.social_youtube_link }}">YouTube</a></li>
              {%- endif -%}
              {%- if settings.social_pinterest_link != blank -%}
                <li><a class="bz-v410-footer__tap" href="{{ settings.social_pinterest_link }}">Pinterest</a></li>
              {%- endif -%}
            </ul>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  {%- for block in section.blocks -%}
    {%- if block.type == 'payments' -%}
      <div class="bz-v410-footer__payments" {{ block.shopify_attributes }}>
        {%- if block.settings.heading != blank -%}
          <h2 class="bz-v410-footer__heading">{{ block.settings.heading | escape }}</h2>
        {%- endif -%}
        <p class="bz-v410-footer__methods">
          {%- assign pays = block.settings.methods | split: ',' -%}
          {%- for pay in pays -%}
            {%- assign pay_label = pay | strip -%}
            {%- if pay_label != blank -%}
              <span>{{ pay_label | escape }}</span>
            {%- endif -%}
          {%- endfor -%}
        </p>
      </div>
    {%- endif -%}
  {%- endfor -%}

  <div class="bz-v410-footer__bar">
    <p>© {{ 'now' | date: '%Y' }} {{ shop.name | escape }}{%- if section.settings.vat != blank %} · {{ section.settings.vat | escape }}{% endif -%}</p>
    <p>
      {%- if section.settings.privacy_link != blank -%}
        <a href="{{ section.settings.privacy_link }}">Privacy</a>
      {%- else -%}
        Privacy
      {%- endif -%}
      <span aria-hidden="true"> / </span>
      {%- if section.settings.terms_link != blank -%}
        <a href="{{ section.settings.terms_link }}">Termini di vendita</a>
      {%- else -%}
        Termini di vendita
      {%- endif -%}
    </p>
  </div>
</footer>

{% schema %}
{
  "name": "Piè di pagina",
  "class": "bz-home",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "text", "id": "wordmark", "label": "Nome", "default": "Benessere Zen" },
    { "type": "text", "id": "address", "label": "Indirizzo", "default": "Via Marcello Provenzali 1, 44042 Cento (FE)" },
    { "type": "text", "id": "phone", "label": "Telefono", "default": "+39 347 088 3168" },
    { "type": "text", "id": "email", "label": "Email", "default": "info@benesserezen.shop" },
    { "type": "textarea", "id": "hours", "label": "Orari", "default": "Lunedì, martedì, mercoledì, venerdì e sabato 9:30–12:30 e 16:00–19:30. Giovedì 9:00–13:00." },
    { "type": "text", "id": "note", "label": "Nota", "default": "Ogni pezzo è anche in negozio." },
    { "type": "text", "id": "vat", "label": "Partita IVA", "info": "Se è vuota, la riga legale non compare.", "default": "Benessere Zen di Balboni Simona, P. IVA 02091600383 (REA FE-257570). Sede legale Via Olindo Malagodi 2, 44042 Cento FE." },
    { "type": "url", "id": "privacy_link", "label": "Privacy" },
    { "type": "url", "id": "terms_link", "label": "Termini" }
  ],
  "blocks": [
    {
      "type": "links",
      "name": "Colonna",
