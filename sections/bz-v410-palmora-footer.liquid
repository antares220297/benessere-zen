        { "type": "text", "id": "heading", "label": "Titolo", "default": "Negozio", "info": "Se il titolo è Seguici, la colonna mostra solo i social compilati nel tema." },
        { "type": "link_list", "id": "menu", "label": "Menu" },
        { "type": "text", "id": "label_1", "label": "Voce 1" },
        { "type": "url", "id": "link_1", "label": "Link 1" },
        { "type": "text", "id": "label_2", "label": "Voce 2" },
        { "type": "url", "id": "link_2", "label": "Link 2" },
        { "type": "text", "id": "label_3", "label": "Voce 3" },
        { "type": "url", "id": "link_3", "label": "Link 3" },
        { "type": "text", "id": "label_4", "label": "Voce 4" },
        { "type": "url", "id": "link_4", "label": "Link 4" }
      ]
    },
    {
      "type": "payments",
      "name": "Pagamenti",
      "settings": [
        { "type": "text", "id": "heading", "label": "Titolo", "default": "Pagamenti" },
        { "type": "text", "id": "methods", "label": "Metodi, separati da virgola", "default": "American Express, Apple Pay, Google Pay, Maestro, Mastercard, PayPal, Shop Pay, Visa" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Piè di pagina",
      "blocks": [
        {
          "type": "links",
          "settings": {
            "heading": "Negozio",
            "label_1": "Gioielli con pietre",
            "label_2": "Mala tibetani",
            "label_3": "Pietre e cristalli",
            "label_4": "Incensi e palo santo"
          }
        },
        {
          "type": "links",
          "settings": {
            "heading": "Aiuto",
            "label_1": "Resi",
            "label_2": "Contatti"
          }
        },
        {
          "type": "links",
          "settings": {
