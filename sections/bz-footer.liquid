{{ 'bz-tokens.css' | asset_url | stylesheet_tag }}
{{ 'bz-bottom.css' | asset_url | stylesheet_tag }}

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": "Benessere Zen",
    "url": {{ shop.url | json }},
    "email": "info@benesserezen.shop",
    "telephone": "+39 347 088 3168",
    "image": {{ 'shop-logo.png' | asset_url | prepend: 'https:' | json }},
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Via Marcello Provenzali 1",
      "postalCode": "44042",
      "addressLocality": "Cento",
      "addressRegion": "FE",
      "addressCountry": "IT"
    },
    "openingHoursSpecification": [
      { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Friday", "Saturday"], "opens": "09:30", "closes": "12:30" },
      { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Friday", "Saturday"], "opens": "16:00", "closes": "19:30" },
      { "@type": "OpeningHoursSpecification", "dayOfWeek": "Thursday", "opens": "09:00", "closes": "13:00" }
    ]
  }
</script>
<footer class="bz bz-foot">
  <div class="bz-foot__grid">
    <div>
      <a class="bz-foot__brand" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
        {%- if section.settings.logo != blank -%}
          {{ section.settings.logo | image_url: width: 120 | image_tag: alt: '', width: 50, height: 50 }}
        {%- else -%}
          <img src="{{ 'shop-logo.png' | asset_url }}" alt="" width="50" height="50">
        {%- endif -%}
        <span class="bz-foot__word">{{ section.settings.word_first | escape }} <em>{{ section.settings.word_second | escape }}</em></span>
      </a>
      <p>{{ section.settings.about | escape }}</p>
    </div>
    {%- for block in section.blocks -%}
      <div {{ block.shopify_attributes }}>
        <h4>{{ block.settings.heading | escape }}</h4>
        {%- if block.type == 'links' -%}
          <ul>
            {%- assign column_heading = block.settings.heading | downcase | strip -%}
            {%- if column_heading == 'seguici' -%}
              {%- if settings.social_instagram_link != blank -%}
                <li><a href="{{ settings.social_instagram_link }}">Instagram</a></li>
              {%- endif -%}
              {%- if settings.social_facebook_link != blank -%}
                <li><a href="{{ settings.social_facebook_link }}">Facebook</a></li>
              {%- endif -%}
              {%- if settings.social_tiktok_link != blank -%}
                <li><a href="{{ settings.social_tiktok_link }}">TikTok</a></li>
              {%- endif -%}
              {%- if settings.social_youtube_link != blank -%}
                <li><a href="{{ settings.social_youtube_link }}">YouTube</a></li>
              {%- endif -%}
              {%- if settings.social_pinterest_link != blank -%}
                <li><a href="{{ settings.social_pinterest_link }}">Pinterest</a></li>
              {%- endif -%}
              {%- if settings.social_linkedin_link != blank -%}
                <li><a href="{{ settings.social_linkedin_link }}">LinkedIn</a></li>
              {%- endif -%}
              {%- if settings.social_twitter_link != blank -%}
                <li><a href="{{ settings.social_twitter_link }}">X</a></li>
              {%- endif -%}
              {%- if settings.social_snapchat_link != blank -%}
                <li><a href="{{ settings.social_snapchat_link }}">Snapchat</a></li>
              {%- endif -%}
              {%- if settings.social_tumblr_link != blank -%}
                <li><a href="{{ settings.social_tumblr_link }}">Tumblr</a></li>
              {%- endif -%}
              {%- if settings.social_vimeo_link != blank -%}
                <li><a href="{{ settings.social_vimeo_link }}">Vimeo</a></li>
              {%- endif -%}
            {%- elsif block.settings.menu != blank -%}
              {%- for link in block.settings.menu.links -%}
                {%- if link.title != blank -%}
                  <li>
                    {%- if link.url != blank -%}
                      <a href="{{ link.url }}">{{ link.title | escape }}</a>
                    {%- else -%}
                      {{ link.title | escape }}
                    {%- endif -%}
                  </li>
                {%- endif -%}
              {%- endfor -%}
            {%- else -%}
              {%- assign keys = 'link_1,link_2,link_3,link_4' | split: ',' -%}
              {%- assign labels = 'label_1,label_2,label_3,label_4' | split: ',' -%}
              {%- for key in keys -%}
                {%- assign label = block.settings[labels[forloop.index0]] -%}
                {%- assign href = block.settings[key] -%}
                {%- if label != blank -%}
                  <li>
                    {%- if href != blank -%}
                      <a href="{{ href }}">{{ label | escape }}</a>
                    {%- else -%}
                      {{ label | escape }}
                    {%- endif -%}
                  </li>
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}
          </ul>
        {%- else -%}
          <div class="bz-foot__pay">
            {%- assign pays = block.settings.methods | split: ',' -%}
            {%- for pay in pays -%}
              <span>{{ pay | strip | escape }}</span>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
  <div class="bz-foot__bar">
    <span>© {{ 'now' | date: '%Y' }} {{ shop.name | escape }}{% if section.settings.vat != blank %} · {{ section.settings.vat | escape }}{% endif %}</span>
    <span>
      {%- if section.settings.privacy_link != blank -%}<a href="{{ section.settings.privacy_link }}">Privacy</a>{%- else -%}Privacy{%- endif -%}
      · Cookie ·
      {%- if section.settings.terms_link != blank -%}<a href="{{ section.settings.terms_link }}">Termini di vendita</a>{%- else -%}Termini di vendita{%- endif -%}
    </span>
  </div>
</footer>

{% schema %}
{
  "name": "Piè di pagina",
  "class": "bz-home",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "text", "id": "word_first", "label": "Prima parola", "default": "Benessere" },
    { "type": "text", "id": "word_second", "label": "Seconda parola", "default": "Zen" },
    { "type": "textarea", "id": "about", "label": "Testo", "default": "Via Marcello Provenzali 1, 44042 Cento FE. Tel +39 347 088 3168. info@benesserezen.shop. Orari: lun, mar, mer, ven, sab 9:30-12:30 e 16:00-19:30, gio 9:00-13:00." },
    { "type": "text", "id": "vat", "label": "Partita IVA", "info": "Se è vuota, la riga legale non compare.", "default": "Benessere Zen di Balboni Simona, P. IVA 02091600383 (REA FE-257570). Sede legale Via Olindo Malagodi 2, 44042 Cento FE." },
    { "type": "url", "id": "privacy_link", "label": "Privacy" },
    { "type": "url", "id": "terms_link", "label": "Termini" }
  ],
  "blocks": [
    {
      "type": "links",
      "name": "Colonna",
      "settings": [
        { "type": "text", "id": "heading", "label": "Titolo", "default": "Negozio" },
        { "type": "link_list", "id": "menu", "label": "Menu" },
        { "type": "text", "id": "label_1", "label": "Voce 1" },
        { "type": "url", "id": "link_1", "label": "Link 1" },
        { "type": "text", "id": "label_2", "label": "Voce 2" },
        { "type": "url", "id": "link_2", "label": "Link 2" },
        { "type": "text", "id": "label_3", "label": "Voce 3" },
        { "type": "url", "id": "link_3", "label": "Link 3" },
        { "type": "text", "id": "label_4", "label": "Voce 4" },
        { "type": "url", "id": "link_4", "label": "Link 4" }
      ]
    },
    {
      "type": "payments",
      "name": "Pagamenti",
      "settings": [
        { "type": "text", "id": "heading", "label": "Titolo", "default": "Pagamenti" },
        { "type": "text", "id": "methods", "label": "Metodi, separati da virgola", "default": "American Express, Apple Pay, Google Pay, Maestro, Mastercard, PayPal, Shop Pay, Visa" }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [{ "name": "Piè di pagina" }]
}
{% endschema %}
