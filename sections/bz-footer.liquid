    { "type": "text", "id": "word_second", "label": "Seconda parola", "default": "Zen" },
    { "type": "textarea", "id": "about", "label": "Testo", "default": "Via Marcello Provenzali 1, 44042 Cento FE." },
    { "type": "text", "id": "vat", "label": "Riga legale", "default": "Benessere Zen di Balboni Simona, P. IVA 02091600383 (REA FE-257570). Sede legale Via Olindo Malagodi 2, 44042 Cento FE." },
    { "type": "url", "id": "privacy_link", "label": "Privacy" },
    { "type": "url", "id": "terms_link", "label": "Termini" }
  ],
  "blocks": [
    {
      "type": "links",
      "name": "Colonna",
      "settings": [
        { "type": "text", "id": "heading", "label": "Titolo", "default": "Negozio" },
        { "type": "link_list", "id": "menu", "label": "Menu", "info": "Se è compilato, sostituisce le voci scritte sotto." },
        { "type": "text", "id": "label_1", "label": "Voce 1" },
        { "type": "url", "id": "link_1", "label": "Link 1" },
        { "type": "text", "id": "label_2", "label": "Voce 2" },
        { "type": "url", "id": "link_2", "label": "Link 2" },
        { "type": "text", "id": "label_3", "label": "Voce 3" },
        { "type": "url", "id": "link_3", "label": "Link 3" },
        { "type": "text", "id": "label_4", "label": "Voce 4" },
        { "type": "url", "id": "link_4", "label": "Link 4" },
        { "type": "text", "id": "label_5", "label": "Voce 5" },
        { "type": "url", "id": "link_5", "label": "Link 5" },
        { "type": "text", "id": "label_6", "label": "Voce 6" },
        { "type": "url", "id": "link_6", "label": "Link 6" },
        { "type": "text", "id": "label_7", "label": "Voce 7" },
        { "type": "url", "id": "link_7", "label": "Link 7" },
        { "type": "text", "id": "label_8", "label": "Voce 8" },
        { "type": "url", "id": "link_8", "label": "Link 8" },
        { "type": "text", "id": "label_9", "label": "Voce 9" },
        { "type": "url", "id": "link_9", "label": "Link 9" },
        { "type": "text", "id": "label_10", "label": "Voce 10" },
        { "type": "url", "id": "link_10", "label": "Link 10" }
      ]
    },
    {
      "type": "payments",
      "name": "Pagamenti",
      "settings": [
        { "type": "text", "id": "heading", "label": "Titolo", "default": "Pagamenti" },
        { "type": "text", "id": "methods", "label": "Metodi, separati da virgola", "default": "American Express, Apple Pay, Google Pay, Maestro, Mastercard, PayPal, Shop Pay, Visa" }
      ]
    }
