<footer class="bz-foot">
  <div class="footer-main">
    <div>
      <a class="brand" href="{{ routes.root_url }}">
        {%- if section.settings.logo != blank -%}
          {{ section.settings.logo | image_url: width: 160 | image_tag: alt: '', loading: 'lazy', widths: '80, 120, 160', width: 43, height: 43 }}
        {%- else -%}
          <img src="{{ 'shop-logo.png' | asset_url }}" alt="" width="43" height="43" loading="lazy">
        {%- endif -%}
        <span>{{ section.settings.word_first | escape }} <em>{{ section.settings.word_second | escape }}</em></span>
      </a>
      <p>{{ settings.bz_address | default: 'Via Marcello Provenzali 1, 44042 Cento FE' }}</p>
      <p>Tel {{ settings.bz_phone | default: '+39 347 088 3168' }}<br>{{ settings.bz_email | default: 'info@benesserezen.shop' }}</p>
      <p>{% render 'bz-hours', part: 'footer' %}</p>
    </div>
    {%- for block in section.blocks -%}
        <details open {{ block.shopify_attributes }}>
          <summary>{{ block.settings.heading | escape }}</summary>
          {%- if block.type == 'payments' -%}
            {%- assign pays = block.settings.methods | split: ',' -%}
            {%- for pay in pays -%}
              <a href="{{ section.settings.terms_link | default: shop.terms_of_service.url }}">{{ pay | strip | escape }}</a>
            {%- endfor -%}
          {%- elsif block.settings.menu != blank and block.settings.menu.links.size > 0 -%}
            {%- for link in block.settings.menu.links -%}
              {%- if link.type == 'blog_link' or link.type == 'article_link' or link.url contains '/blogs/' -%}{%- continue -%}{%- endif -%}
              {% render 'bz-menu-link', url: link.url, label: link.title %}
            {%- endfor -%}
          {%- else -%}
            {%- for i in (1..10) -%}
              {%- assign label_key = 'label_' | append: i -%}
              {%- assign link_key = 'link_' | append: i -%}
              {%- assign label = block.settings[label_key] -%}
              {%- assign href = block.settings[link_key] -%}
              {%- if label != blank and href != blank -%}
                {%- if href contains '/blogs/' -%}{%- continue -%}{%- endif -%}
                {% render 'bz-menu-link', url: href, label: label, keep_label: true %}
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        </details>
    {%- endfor -%}
  </div>
  <div class="footer-bottom">
    <span>© {{ 'now' | date: '%Y' }} {{ shop.name | escape }}{% if section.settings.vat != blank %} · {{ section.settings.vat | escape }}{% endif %}</span>
    <span>
      {%- if section.settings.privacy_link != blank -%}<a href="{{ section.settings.privacy_link }}">Privacy</a>{%- else -%}Privacy{%- endif -%}
      · Cookie ·
      {%- if section.settings.terms_link != blank -%}<a href="{{ section.settings.terms_link }}">Termini di vendita</a>{%- else -%}Termini di vendita{%- endif -%}
      <br>
      <a href="/pages/chi-siamo?view=crediti-immagini">Crediti immagini</a>
    </span>
  </div>
</footer>
{% schema %}
