{{ 'bz-tokens.css' | asset_url | stylesheet_tag }}
{{ 'bz-bottom.css' | asset_url | stylesheet_tag }}

{% render 'bz-wave', from: '#141312', to: '#0d0c0b' %}
<footer class="bz bz-foot">
  <div class="bz-foot__grid">
    <div>
      <a class="bz-foot__brand" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
        {%- if section.settings.logo != blank -%}
          {{ section.settings.logo | image_url: width: 120 | image_tag: alt: '', width: 50, height: 50 }}
        {%- else -%}
          <img src="{{ 'shop-logo.png' | asset_url }}" alt="" width="50" height="50">
        {%- endif -%}
        <span class="bz-foot__word">{{ section.settings.word_first | escape }} <em>{{ section.settings.word_second | escape }}</em></span>
      </a>
      <p>{{ section.settings.about | escape }}</p>
    </div>
    {%- for block in section.blocks -%}
      <div {{ block.shopify_attributes }}>
        <h4>{{ block.settings.heading | escape }}</h4>
        {%- if block.type == 'links' -%}
          <ul>
            {%- if block.settings.menu != blank -%}
              {%- for link in block.settings.menu.links -%}
                <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
              {%- endfor -%}
            {%- else -%}
              {%- assign keys = 'link_1,link_2,link_3,link_4' | split: ',' -%}
              {%- assign labels = 'label_1,label_2,label_3,label_4' | split: ',' -%}
              {%- for key in keys -%}
                {%- assign label = block.settings[labels[forloop.index0]] -%}
                {%- if label != blank -%}
                  <li><a href="{{ block.settings[key] | default: '#' }}">{{ label | escape }}</a></li>
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}
          </ul>
        {%- else -%}
          <div class="bz-foot__pay">
            {%- assign pays = block.settings.methods | split: ',' -%}
            {%- for pay in pays -%}
              <span>{{ pay | strip | escape }}</span>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
  <div class="bz-foot__bar">
    <span>© {{ 'now' | date: '%Y' }} {{ shop.name | escape }}{% if section.settings.vat != blank %} · {{ section.settings.vat | escape }}{% endif %}</span>
    <span>
      {%- if section.settings.privacy_link != blank -%}<a href="{{ section.settings.privacy_link }}">Privacy</a>{%- else -%}Privacy{%- endif -%}
      · Cookie ·
      {%- if section.settings.terms_link != blank -%}<a href="{{ section.settings.terms_link }}">Termini di vendita</a>{%- else -%}Termini di vendita{%- endif -%}
    </span>
  </div>
</footer>

{% schema %}
{
  "name": "Piè di pagina",
  "class": "bz-home",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "text", "id": "word_first", "label": "Prima parola", "default": "Benessere" },
    { "type": "text", "id": "word_second", "label": "Seconda parola", "default": "Zen" },
    { "type": "textarea", "id": "about", "label": "Testo", "default": "Gioielli in pietra naturale, mala e oggetti per i tuoi rituali. Via Provenzali 1, Cento (FE)." },
    { "type": "text", "id": "vat", "label": "Partita IVA", "info": "Lascia il testo del mockup finché non inserisci la partita IVA vera.", "default": "P. IVA da inserire" },
    { "type": "url", "id": "privacy_link", "label": "Privacy" },
    { "type": "url", "id": "terms_link", "label": "Termini" }
  ],
  "blocks": [
    {
      "type": "links",
      "name": "Colonna",
      "settings": [
        { "type": "text", "id": "heading", "label": "Titolo", "default": "Negozio" },
        { "type": "link_list", "id": "menu", "label": "Menu" },
        { "type": "text", "id": "label_1", "label": "Voce 1" },
        { "type": "url", "id": "link_1", "label": "Link 1" },
        { "type": "text", "id": "label_2", "label": "Voce 2" },
        { "type": "url", "id": "link_2", "label": "Link 2" },
        { "type": "text", "id": "label_3", "label": "Voce 3" },
        { "type": "url", "id": "link_3", "label": "Link 3" },
        { "type": "text", "id": "label_4", "label": "Voce 4" },
        { "type": "url", "id": "link_4", "label": "Link 4" }
      ]
    },
    {
      "type": "payments",
      "name": "Pagamenti",
      "settings": [
        { "type": "text", "id": "heading", "label": "Titolo", "default": "Pagamenti" },
        { "type": "text", "id": "methods", "label": "Metodi, separati da virgola", "default": "Visa, Mastercard, PayPal, Apple Pay, Google Pay" }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [{ "name": "Piè di pagina" }]
}
{% endschema %}
