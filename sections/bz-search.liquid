{{ 'bz-tokens.css' | asset_url | stylesheet_tag }}
{{ 'bz-home.css' | asset_url | stylesheet_tag }}
{{ 'bz-search.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign page_size = section.settings.per_page | default: 16
  assign empty_text = section.settings.empty_text | default: 'Nessun pezzo con questo nome.'
  assign idle_text = section.settings.idle_text | default: 'Cerca un mala, una pietra, un ciondolo.'
  assign next_label = section.settings.next_label | default: 'Pagina successiva'
  assign picks = section.settings.collection
  if picks == blank
    assign picks = collections['gioielli-con-pietre']
  endif
-%}

{%- paginate search.results by page_size -%}
  <section class="bz bz-search" aria-labelledby="BzSearchTitle-{{ section.id }}">
    <form class="bz-search__form" action="{{ routes.search_url }}" method="get" role="search">
      <label class="bz-vh" for="BzSearchField-{{ section.id }}">Cerca</label>
      <input id="BzSearchField-{{ section.id }}" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Cerca…" aria-label="Cerca nel negozio" {% if search.terms == blank %}autofocus{% endif %} required>
      <input type="hidden" name="type" value="product">
      <input type="hidden" name="options[prefix]" value="last">
      <button type="submit">Cerca</button>
    </form>
    {%- if search.performed -%}
      <h1 id="BzSearchTitle-{{ section.id }}">{{ search.results_count }} {% if search.results_count == 1 %}risultato{% else %}risultati{% endif %} per <em>«{{ search.terms | escape }}»</em></h1>
      {%- if search.results_count > 0 -%}
        <div class="pgrid bz-catalog-grid">
          {%- for product in search.results -%}
            {%- if product.object_type == 'product' -%}
              {% render 'bz-product-card', card: product, style: 'plp' %}
            {%- endif -%}
          {%- endfor -%}
        </div>
        {%- if paginate.pages > 1 -%}
          <nav class="bz-search__pager" aria-label="Pagine dei risultati">
            {%- if paginate.previous -%}
              <a class="btn outline" href="{{ paginate.previous.url }}" rel="prev">Pagina precedente</a>
            {%- endif -%}
            <span>Pagina {{ paginate.current_page }} di {{ paginate.pages }}</span>
            {%- if paginate.next -%}
              <a class="btn outline" href="{{ paginate.next.url }}" rel="next">{{ next_label | escape }}</a>
            {%- endif -%}
          </nav>
        {%- endif -%}
      {%- else -%}
        <p>{{ empty_text | escape }}</p>
        {%- if picks != blank and picks.products_count > 0 -%}
          <p class="bz-search__suggest">Ti proponiamo</p>
          <div class="pgrid bz-search__suggestions">
            {%- assign shown = 0 -%}
            {%- for product in picks.products -%}
              {%- if shown < 3 and product.available -%}
                {% render 'bz-product-card', card: product, style: 'plp' %}
                {%- assign shown = shown | plus: 1 -%}
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      {%- endif -%}
    {%- else -%}
      <h1 id="BzSearchTitle-{{ section.id }}" class="bz-search__none">{{ idle_text | escape }}</h1>
      {%- if picks != blank and picks.products_count > 0 -%}
        <div class="pgrid bz-search__suggestions">
          {%- assign shown = 0 -%}
          {%- for product in picks.products -%}
            {%- if shown < 3 and product.available -%}
              {% render 'bz-product-card', card: product, style: 'plp' %}
              {%- assign shown = shown | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- endif -%}
  </section>
{%- endpaginate -%}

{% schema %}
{
  "name": "Ricerca",
  "class": "bz-home",
  "enabled_on": {
    "templates": ["search"]
  },
  "settings": [
    {
      "type": "text",
      "id": "empty_text",
      "label": "Nessun risultato",
      "default": "Nessun pezzo con questo nome."
    },
    {
      "type": "text",
      "id": "idle_text",
      "label": "Prima di una ricerca",
      "default": "Cerca un mala, una pietra, un ciondolo."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Pezzi sotto la ricerca",
      "info": "Fino a tre pezzi disponibili, quando non c'è ancora una ricerca o non torna nulla. Se è vuota, usiamo i gioielli con pietre."
    },
    {
      "type": "text",
      "id": "next_label",
      "label": "Pagina successiva",
      "default": "Pagina successiva"
    },
    {
      "type": "range",
      "id": "per_page",
      "min": 8,
      "max": 24,
      "step": 4,
      "label": "Pezzi per pagina",
      "default": 16
    }
  ],
  "presets": [
    { "name": "Ricerca" }
  ]
}
{% endschema %}
