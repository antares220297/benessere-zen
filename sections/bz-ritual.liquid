{%- if product == blank -%}
  {%- assign sets = section.blocks | where: 'type', 'set' -%}
  {%- if sets.size > 0 -%}
    {% render 'bz-ritual-sets', blocks: sets %}
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "Completa il rituale",
  "class": "bz-home",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titolo", "default": "Completa" },
    { "type": "text", "id": "heading_accent", "label": "Titolo in corsivo", "default": "il rituale" },
    { "type": "text", "id": "link_label", "label": "Link" },
    { "type": "url", "id": "link", "label": "Destinazione" },
    { "type": "checkbox", "id": "bundle_discount", "label": "Prezzo del prodotto bundle", "default": false },
    { "type": "checkbox", "id": "mostra_sconto_insieme", "label": "Mostra il −10% sul rituale", "info": "Accendilo solo dopo aver attivato lo sconto automatico nel negozio. Fino ad allora il totale resta la somma dei pezzi, senza prezzo barrato.", "default": false },
    { "type": "textarea", "id": "intro", "label": "Introduzione", "default": "Due o tre pezzi che stanno bene con questo." }
  ],
  "blocks": [
    {
      "type": "set",
      "name": "Set della home",
      "settings": [
        { "type": "text", "id": "label", "label": "Nome", "default": "Tutto nero" },
        { "type": "product", "id": "bundle_product", "label": "Prodotto bundle" },
        { "type": "product", "id": "product_1", "label": "Primo pezzo" },
        { "type": "product", "id": "product_2", "label": "Secondo pezzo" },
        { "type": "product", "id": "product_3", "label": "Terzo pezzo" },
        { "type": "image_picker", "id": "image", "label": "Foto" },
        { "type": "text", "id": "caption_title", "label": "Titolo foto", "default": "Pietre scure," },
        { "type": "text", "id": "caption_accent", "label": "Corsivo", "default": "da portare a strati" },
        { "type": "textarea", "id": "caption", "label": "Didascalia", "default": "Onice, tormalina e ossidiana: il mala lungo al collo, il bracciale e il ciondolo vicini." }
      ]
    },
    {
      "type": "type_rule",
      "name": "Per tipo di prodotto",
      "settings": [
        { "type": "text", "id": "product_type", "label": "Tipo prodotto", "info": "Uguale al campo Tipo, per esempio Bracciali. In pagina prodotto, se Search & Discovery non ha complementari, prendiamo un pezzo disponibile da ciascuna collezione." },
        { "type": "collection", "id": "collection_1", "label": "Prima collezione" },
        { "type": "collection", "id": "collection_2", "label": "Seconda collezione" }
      ]
    }
  ],
  "max_blocks": 16,
  "presets": [
    { "name": "Completa il rituale" }
  ]
}
{% endschema %}
