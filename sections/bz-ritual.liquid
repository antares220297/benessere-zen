{%- liquid
  assign ritual_home = false
  if product == blank
    for block in section.blocks
      if block.type == 'set'
        if block.settings.product_1 != blank or block.settings.product_2 != blank or block.settings.product_3 != blank
          assign ritual_home = true
        endif
      endif
    endfor
  endif

  assign ritual_count = 0
  assign ritual_total = 0
  assign ritual_ids = '|'
  assign ritual_shot = blank
  assign ritual_shot_alt = blank
  assign current_id = product.id
  assign type_key = product.type | downcase | strip
-%}

{%- if product != blank and recommendations.performed -%}
  {%- for rec in recommendations.products -%}
    {%- if ritual_count < 3 and rec.available and rec.id != current_id -%}
      {%- assign ritual_mark = rec.id | prepend: '|' | append: '|' -%}
      {%- unless ritual_ids contains ritual_mark -%}
        {%- assign ritual_ids = ritual_ids | append: ritual_mark -%}
        {%- assign ritual_count = ritual_count | plus: 1 -%}
        {%- assign ritual_total = ritual_total | plus: rec.price -%}
        {%- if ritual_shot == blank and rec.featured_image != blank -%}
          {%- assign ritual_shot = rec.featured_image -%}
          {%- assign ritual_shot_alt = rec.title -%}
        {%- endif -%}
      {%- endunless -%}
    {%- endif -%}
  {%- endfor -%}
{%- elsif product != blank -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'type_rule' -%}
      {%- assign rule_type = block.settings.product_type | downcase | strip -%}
      {%- if rule_type != blank and rule_type == type_key -%}
        {%- assign rule_keys = 'collection_1,collection_2' | split: ',' -%}
        {%- for rule_key in rule_keys -%}
          {%- assign rule_col = block.settings[rule_key] -%}
          {%- if rule_col != blank and ritual_count < 3 -%}
            {%- for rec in rule_col.products -%}
              {%- if ritual_count < 3 and rec.available and rec.id != current_id -%}
                {%- assign ritual_mark = rec.id | prepend: '|' | append: '|' -%}
                {%- unless ritual_ids contains ritual_mark -%}
                  {%- assign ritual_ids = ritual_ids | append: ritual_mark -%}
                  {%- assign ritual_count = ritual_count | plus: 1 -%}
                  {%- assign ritual_total = ritual_total | plus: rec.price -%}
                  {%- if ritual_shot == blank and rec.featured_image != blank -%}
                    {%- assign ritual_shot = rec.featured_image -%}
                    {%- assign ritual_shot_alt = rec.title -%}
                  {%- endif -%}
                  {%- break -%}
                {%- endunless -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

{%- if product != blank -%}
  {%- unless recommendations.performed -%}
    {{ 'bz-tokens.css' | asset_url | stylesheet_tag }}
    {{ 'bz-home.css' | asset_url | stylesheet_tag }}
    {{ 'bz-mid.css' | asset_url | stylesheet_tag }}
  {%- endunless -%}
  {%- if ritual_count > 0 or recommendations.performed == false -%}
    {%- assign rec_url = routes.product_recommendations_url | append: '?section_id=' | append: section.id | append: '&product_id=' | append: product.id | append: '&limit=3&intent=complementary' -%}
    <div class="bz bz-mid bz-ritual" data-bz-switch{% unless recommendations.performed %} data-bz-complementary data-url="{{ rec_url | escape }}"{% endunless %}{% if ritual_count == 0 %} hidden{% endif %}>
      {%- if ritual_count > 0 -%}
        <div class="bz-ritual__head">
          <h2>{{ section.settings.heading | escape }} <em>{{ section.settings.heading_accent | escape }}</em></h2>
        </div>
        <div class="bz-set{% if ritual_shot == blank %} bz-set--solo{% endif %}">
          <div class="bz-set__card">
            {%- if section.settings.intro != blank -%}
              <p>{{ section.settings.intro | escape }}</p>
            {%- endif -%}
            <div class="bz-pane is-on" data-bz-pane="ritual-product">
              {%- assign ritual_shown = '|' -%}
              {%- if recommendations.performed -%}
                {%- for rec in recommendations.products -%}
                  {%- assign ritual_mark = rec.id | prepend: '|' | append: '|' -%}
                  {%- if ritual_ids contains ritual_mark -%}
                    {%- unless ritual_shown contains ritual_mark -%}
                      {%- assign ritual_shown = ritual_shown | append: ritual_mark -%}
                      {% render 'bz-ritual-row', rec: rec %}
                    {%- endunless -%}
                  {%- endif -%}
                {%- endfor -%}
              {%- else -%}
                {%- for block in section.blocks -%}
                  {%- if block.type == 'type_rule' -%}
                    {%- assign rule_keys = 'collection_1,collection_2' | split: ',' -%}
                    {%- for rule_key in rule_keys -%}
                      {%- assign rule_col = block.settings[rule_key] -%}
                      {%- if rule_col != blank -%}
                        {%- for rec in rule_col.products -%}
                          {%- assign ritual_mark = rec.id | prepend: '|' | append: '|' -%}
                          {%- if ritual_ids contains ritual_mark -%}
                            {%- unless ritual_shown contains ritual_mark -%}
                              {%- assign ritual_shown = ritual_shown | append: ritual_mark -%}
                              {% render 'bz-ritual-row', rec: rec %}
                            {%- endunless -%}
                          {%- endif -%}
                        {%- endfor -%}
                      {%- endif -%}
                    {%- endfor -%}
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}
            </div>
            <div class="bz-set__total">
              <div>
                <span class="bz-note"><span data-bz-count>{{ ritual_count }}</span> pezzi scelti</span>
                <div class="bz-set__sum" data-bz-sum>{% render 'bz-money', cents: ritual_total %}</div>
              </div>
              <button class="bz-btn bz-btn--gold" type="button" data-bz-add-set>Aggiungi al carrello <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button>
            </div>
          </div>
          {%- if ritual_shot != blank -%}
            <div class="bz-set__visual">
              <span data-bz-shot="ritual-product">
                {{ ritual_shot | image_url: width: 1200 | image_tag: alt: ritual_shot_alt, width: 800, height: 600, loading: 'lazy' }}
              </span>
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
    {%- unless recommendations.performed -%}
      <script src="{{ 'bz-home.js' | asset_url }}" defer></script>
    {%- endunless -%}
  {%- endif -%}
{%- elsif ritual_home -%}
{{ 'bz-tokens.css' | asset_url | stylesheet_tag }}
{{ 'bz-home.css' | asset_url | stylesheet_tag }}
{{ 'bz-mid.css' | asset_url | stylesheet_tag }}

<div class="bz bz-mid bz-ritual" data-bz-switch>
  <div class="bz-ritual__head">
    <h2>{{ section.settings.heading | escape }} <em>{{ section.settings.heading_accent | escape }}</em></h2>
    {%- if section.settings.link_label != blank -%}
      <a class="bz-picked__all" href="{{ section.settings.link }}">{{ section.settings.link_label | escape }} <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
    {%- endif -%}
  </div>
  <div class="bz-set">
    <div class="bz-set__card">
      {%- if section.settings.intro != blank -%}
        <p>{{ section.settings.intro | escape }}</p>
      {%- endif -%}
      <div class="bz-pills" data-bz-seg role="tablist">
        {%- for block in section.blocks -%}
          {%- if block.type == 'set' -%}
            <button type="button" role="tab" class="{% if forloop.first %}is-on{% endif %}" data-bz-pane="ritual-{{ forloop.index }}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}">{{ block.settings.label | escape }}</button>
          {%- endif -%}
        {%- endfor -%}
      </div>
      {%- assign active_count = 0 -%}
      {%- assign active_total = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'set' -%}
          <div class="bz-pane{% if forloop.first %} is-on{% endif %}" data-bz-pane="ritual-{{ forloop.index }}" {{ block.shopify_attributes }}>
            {%- assign picks = 'product_1,product_2,product_3' | split: ',' -%}
            {%- for key in picks -%}
              {%- assign item = block.settings[key] -%}
              {%- if item != blank -%}
                {%- if forloop.parentloop.first -%}
                  {%- assign active_count = active_count | plus: 1 -%}
                  {%- assign active_total = active_total | plus: item.price -%}
                {%- endif -%}
                {%- assign rec = item -%}
                {% render 'bz-ritual-row', rec: rec %}
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
      <div class="bz-set__total">
        <div>
          <span class="bz-note"><span data-bz-count>{{ active_count }}</span> pezzi scelti</span>
          <div class="bz-set__sum" data-bz-sum>{% render 'bz-money', cents: active_total %}</div>
        </div>
        <button class="bz-btn bz-btn--gold" type="button" data-bz-add-set>Aggiungi al carrello <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button>
      </div>
    </div>
    <div class="bz-set__visual">
      {%- for block in section.blocks -%}
        {%- if block.type == 'set' -%}
          {%- liquid
            assign shot = block.settings.image
            if shot == blank
              assign shot_keys = 'product_1,product_2,product_3' | split: ','
              for shot_key in shot_keys
                assign shot_product = block.settings[shot_key]
                if shot == blank and shot_product != blank and shot_product.featured_image != blank
                  assign shot = shot_product.featured_image
                endif
              endfor
            endif
          -%}
          <span data-bz-shot="ritual-{{ forloop.index }}"{% unless forloop.first %} hidden{% endunless %}>
            {%- if shot != blank -%}
              {{ shot | image_url: width: 1200 | image_tag: alt: block.settings.caption_title, width: 800, height: 600, loading: 'lazy' }}
            {%- endif -%}
            {%- if block.settings.caption_title != blank -%}
              <div class="bz-set__caption">
                <h3>{{ block.settings.caption_title | escape }} <em>{{ block.settings.caption_accent | escape }}</em></h3>
                <p>{{ block.settings.caption | escape }}</p>
              </div>
            {%- endif -%}
          </span>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>
<script src="{{ 'bz-home.js' | asset_url }}" defer></script>
{%- endif -%}

{% schema %}
{
  "name": "Completa il rituale",
  "class": "bz-home",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titolo", "default": "Completa" },
    { "type": "text", "id": "heading_accent", "label": "Titolo in corsivo", "default": "il rituale" },
    { "type": "text", "id": "link_label", "label": "Link" },
    { "type": "url", "id": "link", "label": "Destinazione" },
    { "type": "textarea", "id": "intro", "label": "Introduzione", "default": "Due o tre pezzi che stanno bene con questo." }
  ],
  "blocks": [
    {
      "type": "set",
      "name": "Set della home",
      "settings": [
        { "type": "text", "id": "label", "label": "Nome", "default": "Tutto nero" },
        { "type": "product", "id": "product_1", "label": "Primo pezzo" },
        { "type": "product", "id": "product_2", "label": "Secondo pezzo" },
        { "type": "product", "id": "product_3", "label": "Terzo pezzo" },
        { "type": "image_picker", "id": "image", "label": "Foto" },
        { "type": "text", "id": "caption_title", "label": "Titolo foto", "default": "Pietre scure," },
        { "type": "text", "id": "caption_accent", "label": "Corsivo", "default": "da portare a strati" },
        { "type": "textarea", "id": "caption", "label": "Didascalia", "default": "Onice, tormalina e ossidiana: il mala lungo al collo, il bracciale e il ciondolo vicini." }
      ]
    },
    {
      "type": "type_rule",
      "name": "Per tipo di prodotto",
      "settings": [
        { "type": "text", "id": "product_type", "label": "Tipo prodotto", "info": "Uguale al campo Tipo, per esempio Bracciali. In pagina prodotto, se Search & Discovery non ha complementari, prendiamo un pezzo disponibile da ciascuna collezione." },
        { "type": "collection", "id": "collection_1", "label": "Prima collezione" },
        { "type": "collection", "id": "collection_2", "label": "Seconda collezione" }
      ]
    }
  ],
  "max_blocks": 16,
  "presets": [
    { "name": "Completa il rituale" }
  ]
}
{% endschema %}
