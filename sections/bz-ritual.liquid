{%- if product != blank -%}
  {%- liquid
    assign current = product.selected_or_first_available_variant
    assign count = 1
    assign total = 0
    if current.available
      assign total = current.price
    endif
    assign seen = '|'
    assign type_key = product.type | handleize
    assign type_family = type_key | split: '-' | first
    assign rule_types = type_key
    case type_family
      when 'pietra', 'pietre'
        assign rule_types = 'pietra,pietre'
      when 'ciondolo', 'ciondoli'
        assign rule_types = 'ciondolo,ciondoli'
      when 'bracciale', 'bracciali'
        assign rule_types = 'bracciale,bracciali'
      when 'collana', 'collane'
        assign rule_types = 'collana,collane'
      when 'candela', 'candele'
        assign rule_types = 'candela,candele'
    endcase
    assign rule_types = rule_types | split: ','
    assign rule_keys = 'collection_1,collection_2' | split: ','
  -%}
  {%- capture rows -%}
    {% render 'bz-ritual-row', rec: product, pdp: true, current_product: true %}
    {%- if recommendations.performed -%}
      {%- for rec in recommendations.products -%}
        {%- if count == 3 -%}{%- break -%}{%- endif -%}
        {%- assign variant = rec.selected_or_first_available_variant -%}
        {%- assign marker = rec.id | prepend: '|' | append: '|' -%}
        {%- if rec.available and variant.available and rec.id != product.id -%}
          {%- unless seen contains marker -%}
            {%- liquid
              assign seen = seen | append: marker
              assign count = count | plus: 1
              assign total = total | plus: variant.price
              render 'bz-ritual-row', rec: rec, pdp: true
            -%}
          {%- endunless -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
    {%- if count < 3 -%}
      {%- capture fallback_handles -%}{% render 'bz-ritual-collections', product: product %}{%- endcapture -%}
      {%- assign fallback_handles = fallback_handles | strip -%}
      {%- capture rule_handles -%}
        {%- for block in section.blocks -%}
          {%- assign rule_type = block.settings.product_type | handleize -%}
          {%- if block.type == 'type_rule' and rule_type != blank -%}
            {%- if rule_types contains rule_type or rule_type == type_key -%}
              {%- for key in rule_keys -%}
                {%- assign handle = block.settings[key].handle -%}
                {%- case handle -%}
                  {%- when 'incensi-e-brucia-incensi-2' -%}
                    {%- assign handle = 'incensi-e-brucia-incensi-1' -%}
                  {%- when 'cosmetica' -%}
                    {%- if type_key == 'oli-e-profumi' -%}
                      {%- assign handle = 'candele-e-brucia-candele' -%}
                    {%- endif -%}
                  {%- when 'latte-detergente', 'tonico' -%}
                    {%- if fallback_handles contains 'balsami-corpo' -%}{%- continue -%}{%- endif -%}
                {%- endcase -%}
                {%- if handle != blank -%}{{ handle }},{%- endif -%}
              {%- endfor -%}
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endcapture -%}
      {%- assign handles = rule_handles | append: fallback_handles | split: ',' | uniq -%}
      {%- comment -%}Prima un pezzo per collezione, poi riempi gli eventuali posti rimasti.{%- endcomment -%}
      {%- for pass in (1..2) -%}
        {%- if count == 3 -%}{%- break -%}{%- endif -%}
        {%- for handle in handles -%}
          {%- if count == 3 -%}{%- break -%}{%- endif -%}
          {%- for rec in collections[handle].products -%}
            {%- assign variant = rec.selected_or_first_available_variant -%}
            {%- assign marker = rec.id | prepend: '|' | append: '|' -%}
            {%- if rec.available and variant.available and rec.id != product.id -%}
              {%- unless seen contains marker -%}
                {%- liquid
                  assign seen = seen | append: marker
                  assign count = count | plus: 1
                  assign total = total | plus: variant.price
                  render 'bz-ritual-row', rec: rec, pdp: true
                -%}
                {%- if pass == 1 or count == 3 -%}{%- break -%}{%- endif -%}
              {%- endunless -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endfor -%}
      {%- endfor -%}
    {%- endif -%}
  {%- endcapture -%}
  {%- assign selected_count = count -%}
  {%- unless current.available -%}{%- assign selected_count = count | minus: 1 -%}{%- endunless -%}
  {%- capture veil -%}{% render 'bz-ritual-veil', product: product %}{%- endcapture -%}
  {%- assign veil = veil | split: '|' -%}
  {%- assign panel_id = section.id | append: '-ritual-product' -%}
  {%- assign rec_url = routes.product_recommendations_url | append: '?section_id=' | append: section.id | append: '&product_id=' | append: product.id | append: '&limit=10&intent=complementary' -%}
  <section class="ritual-section ritual-section--product" data-bz-ritual data-ritual-product="{{ product.id }}" data-veil-source="{{ veil[1] }}:{{ veil[0] }}"{% unless recommendations.performed %} data-bz-complementary data-url="{{ rec_url | escape }}"{% endunless %}>
    <div class="ritual-bg on" style="--ritual-tone:{{ veil[0] }};--ritual-tone-end:#1b1714" aria-hidden="true"></div>
    {%- capture caption_title -%}{% render 'bz-product-name', product: product %}{%- endcapture -%}
    <div class="bz-sh">
      <h2>{{ section.settings.heading | escape }} <em>{{ section.settings.heading_accent | escape }}</em></h2>
    </div>
    {% render 'bz-ritual-panel', panel_id: panel_id, first: true, rows: rows, count: selected_count, total: total, shot: product.featured_image, caption_title: caption_title, pdp: true %}
  </section>
  {%- unless recommendations.performed -%}
    <script src="{{ 'bz-home.js' | asset_url }}" defer></script>
  {%- endunless -%}
{%- elsif product == blank -%}
  {%- assign sets = section.blocks | where: 'type', 'set' -%}
  {%- if sets.size > 0 -%}
    {% render 'bz-ritual-sets', blocks: sets %}
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "Completa il rituale",
  "class": "bz-home",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titolo", "default": "Completa" },
    { "type": "text", "id": "heading_accent", "label": "Titolo in corsivo", "default": "il rituale" },
    { "type": "text", "id": "link_label", "label": "Link" },
    { "type": "url", "id": "link", "label": "Destinazione" },
    { "type": "checkbox", "id": "bundle_discount", "label": "Prezzo del prodotto bundle", "default": false },
    { "type": "textarea", "id": "intro", "label": "Introduzione", "default": "Due o tre pezzi che stanno bene con questo." }
  ],
  "blocks": [
    {
      "type": "set",
      "name": "Set della home",
      "settings": [
        { "type": "text", "id": "label", "label": "Nome", "default": "Tutto nero" },
        { "type": "product", "id": "bundle_product", "label": "Prodotto bundle" },
        { "type": "product", "id": "product_1", "label": "Primo pezzo" },
        { "type": "product", "id": "product_2", "label": "Secondo pezzo" },
        { "type": "product", "id": "product_3", "label": "Terzo pezzo" },
        { "type": "image_picker", "id": "image", "label": "Foto" },
        { "type": "text", "id": "caption_title", "label": "Titolo foto", "default": "Pietre scure," },
        { "type": "text", "id": "caption_accent", "label": "Corsivo", "default": "da portare a strati" },
        { "type": "textarea", "id": "caption", "label": "Didascalia", "default": "Onice, tormalina e ossidiana: il mala lungo al collo, il bracciale e il ciondolo vicini." }
      ]
    },
    {
      "type": "type_rule",
      "name": "Per tipo di prodotto",
      "settings": [
        { "type": "text", "id": "product_type", "label": "Tipo prodotto", "info": "Uguale al campo Tipo, per esempio Bracciali. In pagina prodotto, se Search & Discovery non ha complementari, prendiamo un pezzo disponibile da ciascuna collezione." },
        { "type": "collection", "id": "collection_1", "label": "Prima collezione" },
        { "type": "collection", "id": "collection_2", "label": "Seconda collezione" }
      ]
    }
  ],
  "max_blocks": 16,
  "presets": [
    { "name": "Completa il rituale" }
  ]
}
{% endschema %}
