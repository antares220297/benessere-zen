{%- if section.blocks.size > 0 -%}
  <div class="bz-reviews">
    <div class="bz-reviews__inner">
      {%- if section.settings.heading != blank -%}
        <h2 class="bz-reviews__title">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- for block in section.blocks -%}
        <div {{ block.shopify_attributes }}>
          {% render block %}
        </div>
      {%- endfor -%}
    </div>
  </div>
{%- elsif request.design_mode -%}
  <div class="bz-reviews">
    <div class="bz-reviews__inner">
      <h2 class="bz-reviews__title">{{ section.settings.heading | escape }}</h2>
      <p class="bz-reviews__empty">Aggiungi il blocco della app di recensioni. Non inserire testimonianze scritte a mano.</p>
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .bz-reviews {
    padding: 1rem 1.25rem 2.5rem;
  }
  .bz-reviews__inner {
    max-width: var(--page-width);
    margin: 0 auto;
  }
  .bz-reviews__title {
    font-family: var(--font-heading-family);
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    line-height: 1.15;
    margin: 0 0 1rem;
    color: rgb(var(--colors-heading));
  }
  .bz-reviews__empty {
    max-width: 40rem;
    font-size: 1rem;
    line-height: 1.5;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Recensioni",
  "tag": "section",
  "class": "bz-reviews-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titolo",
      "default": "Recensioni"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Recensioni"
    }
  ]
}
{% endschema %}
