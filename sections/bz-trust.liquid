{%- capture bz_amount -%}{%- render 'bz-free-shipping-threshold' -%}{%- endcapture -%}
{%- assign bz_amount = bz_amount | strip -%}
<div class="bz-trust-wrap">
  <div class="bz-trust-wrap__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="bz-trust-wrap__title">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    <ul class="bz-trust">
      {%- for block in section.blocks -%}
        {%- liquid
          assign item_text = block.settings.text
          if bz_amount != blank
            assign item_text = item_text | replace: '[soglia]', bz_amount
          endif
        -%}
        <li class="bz-trust__item" {{ block.shopify_attributes }}>
          <p class="bz-trust__label">{{ block.settings.title | escape }}</p>
          {%- if item_text != blank -%}
            <p class="bz-trust__text">{{ item_text | escape }}</p>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% stylesheet %}
  .bz-trust-wrap {
    padding: 0.5rem 1.25rem 2.5rem;
  }
  .bz-trust-wrap__inner {
    max-width: var(--page-width);
    margin: 0 auto;
  }
  .bz-trust-wrap__title {
    font-family: var(--font-heading-family);
    font-size: clamp(1.5rem, 3vw, 2rem);
    line-height: 1.2;
    margin: 0 0 1rem;
    color: rgb(var(--colors-heading));
  }
  .bz-trust {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }
  .bz-trust__item {
    margin: 0;
    padding: 1rem;
    background: rgb(var(--colors-background-secondary));
    border-radius: var(--border-radius);
  }
  .bz-trust__label {
    margin: 0 0 0.25rem;
    font-size: 1.0625rem;
    font-weight: 600;
    color: rgb(var(--colors-heading));
  }
  .bz-trust__text {
    margin: 0;
    font-size: 1rem;
    line-height: 1.45;
    color: rgb(var(--colors-text));
  }
  @media (min-width: 750px) {
    .bz-trust {
      grid-template-columns: repeat(4, 1fr);
      gap: 1rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Fiducia",
  "tag": "section",
  "class": "bz-trust-section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titolo",
      "default": "In negozio e sul sito"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Punto",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Titolo",
          "default": "Pietre in vetrina"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Testo",
          "info": "Scrivi [soglia] per inserire la soglia di spedizione gratuita.",
          "default": "Gioielli, mala e cristalli selezionati in bottega."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Fiducia"
    }
  ]
}
{% endschema %}
