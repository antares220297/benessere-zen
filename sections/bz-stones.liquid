{{ 'bz-tokens.css' | asset_url | stylesheet_tag }}
{{ 'bz-home.css' | asset_url | stylesheet_tag }}
{{ 'bz-mid.css' | asset_url | stylesheet_tag }}

<section class="bz bz-mid bz-stones" data-bz-stones>
  <div class="bz-stones__head">
    <h2>{{ section.settings.heading | escape }} <em>{{ section.settings.heading_accent | escape }}</em></h2>
    <div class="bz-pills bz-pills--filters" role="tablist">
      <button type="button" class="is-on" data-bz-filter="tutte">{{ section.settings.filter_all | escape }}</button>
      <button type="button" data-bz-filter="protezione">{{ section.settings.filter_protection | escape }}</button>
      <button type="button" data-bz-filter="amore">{{ section.settings.filter_love | escape }}</button>
      <button type="button" data-bz-filter="abbondanza">{{ section.settings.filter_abundance | escape }}</button>
      <button type="button" data-bz-filter="meditazione">{{ section.settings.filter_meditation | escape }}</button>
    </div>
  </div>
  <div class="bz-stonegrid">
    {%- for block in section.blocks -%}
      {%- liquid
        assign stone_collection = block.settings.collection
        if stone_collection != blank and collections[stone_collection.handle] != blank
          assign stone_collection = collections[stone_collection.handle]
        endif
        assign stone_image = block.settings.image
        assign stone_name = block.settings.name | downcase
        if stone_image == blank and stone_collection != blank
          for product in stone_collection.products limit: 50
            assign product_name = product.title | downcase
            if product_name contains stone_name and product.featured_image != blank
              assign stone_image = product.featured_image
              break
            endif
          endfor
          if stone_image == blank and stone_collection.products.first.featured_image != blank
            assign stone_image = stone_collection.products.first.featured_image
          endif
          if stone_image == blank and stone_collection.image != blank
            assign stone_image = stone_collection.image
          endif
        endif
        assign min_price = blank
        if stone_collection != blank
          for product in stone_collection.products limit: 24
            if min_price == blank or product.price < min_price
              assign min_price = product.price
            endif
          endfor
        endif
        assign wears = 'bracciale,ciondolo,mala,pietra' | split: ','
      -%}
      <a class="bz-stone" style="--bz-stone: {{ block.settings.color }}" data-bz-intent="{{ block.settings.intent }}" href="{{ block.settings.link | default: stone_collection.url }}" {{ block.shopify_attributes }}>
        <span class="bz-stone__band"></span>
        <span class="bz-stone__orb">
          {%- if stone_image != blank -%}
            {{ stone_image | image_url: width: 200 | image_tag: alt: block.settings.name, width: 70, height: 70, loading: 'lazy' }}
          {%- endif -%}
        </span>
        {%- if min_price != blank -%}
          {%- assign min_cents = min_price | modulo: 100 -%}
          <span class="bz-stone__price">da {{ min_price | minus: min_cents | divided_by: 100 }},{{ min_cents | prepend: '00' | slice: -2, 2 }} €</span>
        {%- endif -%}
        <span class="bz-stone__body">
          <h3>{{ block.settings.name | escape }}</h3>
          <p>{{ block.settings.text | escape }}</p>
          <span class="bz-wear" aria-hidden="true">
            <span class="{% if block.settings.bracelet %}is-on{% endif %}"></span>
            <span class="{% if block.settings.pendant %}is-on{% endif %}"></span>
            <span class="{% if block.settings.mala %}is-on{% endif %}"></span>
            <span class="{% if block.settings.loose %}is-on{% endif %}"></span>
          </span>
          <span class="bz-wear-labels">
            <span class="{% if block.settings.bracelet %}is-on{% endif %}">Bracciale</span>
            <span class="{% if block.settings.pendant %}is-on{% endif %}">Ciondolo</span>
            <span class="{% if block.settings.mala %}is-on{% endif %}">Mala</span>
            <span class="{% if block.settings.loose %}is-on{% endif %}">Pietra</span>
          </span>
        </span>
      </a>
    {%- endfor -%}
  </div>
  {%- if section.settings.note != blank -%}
    <p class="bz-note">{{ section.settings.note | escape }}</p>
  {%- endif -%}
</section>
{% render 'bz-wave', from: '#141312', to: '#2a141b' %}
<script src="{{ 'bz-home.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Scegli dalla pietra",
  "class": "bz-home",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titolo", "default": "Scegli dalla" },
    { "type": "text", "id": "heading_accent", "label": "Titolo in corsivo", "default": "pietra" },
    { "type": "text", "id": "note", "label": "Nota", "default": "I significati appartengono alla tradizione e alla pratica spirituale; non sostituiscono pareri o terapie mediche." },
    { "type": "text", "id": "filter_all", "label": "Filtro tutte", "default": "Tutte" },
    { "type": "text", "id": "filter_protection", "label": "Filtro protezione", "default": "Protezione" },
    { "type": "text", "id": "filter_love", "label": "Filtro amore", "default": "Amore" },
    { "type": "text", "id": "filter_abundance", "label": "Filtro abbondanza", "default": "Abbondanza" },
    { "type": "text", "id": "filter_meditation", "label": "Filtro meditazione", "default": "Meditazione" }
  ],
  "blocks": [
    {
      "type": "stone",
      "name": "Pietra",
      "settings": [
        { "type": "text", "id": "name", "label": "Nome", "default": "Ametista" },
        { "type": "textarea", "id": "text", "label": "Testo" },
        { "type": "color", "id": "color", "label": "Colore", "default": "#7b4fa0" },
        { "type": "collection", "id": "collection", "label": "Collezione" },
        { "type": "image_picker", "id": "image", "label": "Foto" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "select", "id": "intent", "label": "Filtro", "options": [
          { "value": "", "label": "Solo in Tutte" },
          { "value": "protezione", "label": "Protezione" },
          { "value": "amore", "label": "Amore" },
          { "value": "abbondanza", "label": "Abbondanza" },
          { "value": "meditazione", "label": "Meditazione" }
        ], "default": "" },
        { "type": "checkbox", "id": "bracelet", "label": "Bracciale", "default": true },
        { "type": "checkbox", "id": "pendant", "label": "Ciondolo", "default": true },
        { "type": "checkbox", "id": "mala", "label": "Mala", "default": false },
        { "type": "checkbox", "id": "loose", "label": "Pietra sciolta", "default": false }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "Scegli dalla pietra" }]
}
{% endschema %}
