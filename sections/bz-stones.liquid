<section id="stones">
  <div class="bz-sh">
    <h2>{{ section.settings.heading | escape }} <em>{{ section.settings.heading_accent | escape }}</em></h2>
    <div class="bz-pills" id="stone-filters" role="group" aria-label="Filtra le pietre">
      <button type="button" data-stone-filter="all" aria-pressed="true">Tutte</button>
      <button type="button" data-stone-filter="protezione" aria-pressed="false">Protezione</button>
      <button type="button" data-stone-filter="amore" aria-pressed="false">Amore</button>
      <button type="button" data-stone-filter="abbondanza" aria-pressed="false">Abbondanza</button>
      <button type="button" data-stone-filter="meditazione" aria-pressed="false">Meditazione</button>
    </div>
  </div>
  <div class="gem-grid is-collapsed" id="gem-grid">
    {%- for block in section.blocks -%}
      {%- liquid
        assign loose = block.settings.loose
        assign bracelet = block.settings.bracelet
        assign pendant = block.settings.pendant
        assign lowest = blank
        if loose.price_min != blank
          assign lowest = loose.price_min
        endif
        if bracelet.price_min != blank
          if lowest == blank or bracelet.price_min < lowest
            assign lowest = bracelet.price_min
          endif
        endif
        if pendant.price_min != blank
          if lowest == blank or pendant.price_min < lowest
            assign lowest = pendant.price_min
          endif
        endif
      -%}
      <article class="gem" id="gem-{{ forloop.index0 }}" data-intent="{{ block.settings.intent }}" {{ block.shopify_attributes }}>
        <div class="gem-turn">
          <div class="gem-front">
            <img src="{{ block.settings.front | asset_url }}" alt="{{ block.settings.name | escape }}" width="1200" height="1600" loading="lazy" style="object-position:{{ block.settings.position | default: '50% 50%' }}">
            <div class="gem-front-copy">
              <h3 class="gem-title">{{ block.settings.name | escape }}</h3>
              {%- if lowest != blank -%}<p class="gem-price">da {% render 'bz-money', cents: lowest %}</p>{%- endif -%}
            </div>
          </div>
          <div class="gem-back" id="gem-back-{{ forloop.index0 }}" inert aria-hidden="true">
            <img src="{{ block.settings.back | default: block.settings.front | asset_url }}" alt="" width="900" height="1200" loading="lazy">
            <div class="gem-back-copy">
              <small>Nella tradizione</small>
              <h3>{{ block.settings.name | escape }}</h3>
              <p>{{ block.settings.meaning | escape }}</p>
              <div class="gem-links">
                {%- if bracelet.url != blank -%}<a href="{{ bracelet.url }}">Bracciali</a>{%- else -%}<span>Bracciali</span>{%- endif -%}
                {%- if pendant.url != blank -%}<a href="{{ pendant.url }}">Ciondoli</a>{%- else -%}<span>Ciondoli</span>{%- endif -%}
                {%- if loose.url != blank -%}<a href="{{ loose.url }}">Pietre</a>{%- endif -%}
              </div>
            </div>
          </div>
        </div>
        <button class="stone__toggle" type="button" aria-expanded="false" aria-controls="gem-back-{{ forloop.index0 }}">
          {% render 'bz-icon', name: '360' %}
          <span>Scopri il significato</span>
        </button>
      </article>
    {%- endfor -%}
  </div>
  <button id="stones-toggle" class="btn outline stones-toggle" type="button">Vedile tutte</button>
  <p class="disclaimer">{{ section.settings.note | escape }}</p>
</section>
{% schema %}
{
  "name": "Scegli la pietra",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titolo", "default": "Scegli la tua" },
    { "type": "text", "id": "heading_accent", "label": "Corsivo", "default": "pietra" },
    { "type": "textarea", "id": "note", "label": "Nota", "default": "I significati appartengono alla tradizione e non sostituiscono il parere di un medico." }
  ],
  "blocks": [
    { "type": "stone", "name": "Pietra", "settings": [
      { "type": "text", "id": "name", "label": "Nome", "default": "Quarzo rosa" },
      { "type": "select", "id": "intent", "label": "Intenzione", "default": "amore", "options": [
        { "value": "protezione", "label": "Protezione" },
        { "value": "amore", "label": "Amore" },
        { "value": "abbondanza", "label": "Abbondanza" },
        { "value": "meditazione", "label": "Meditazione" }
      ] },
      { "type": "textarea", "id": "meaning", "label": "Significato" },
      { "type": "text", "id": "front", "label": "File fronte in assets", "default": "bz-pietra-macro-quarzo-rosa.jpg" },
      { "type": "text", "id": "back", "label": "File retro in assets" },
      { "type": "text", "id": "position", "label": "Posizione foto", "default": "50% 50%" },
      { "type": "product", "id": "loose", "label": "Pietra" },
      { "type": "product", "id": "bracelet", "label": "Bracciale" },
      { "type": "product", "id": "pendant", "label": "Ciondolo" }
    ] }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "Scegli la pietra" }]
}
{% endschema %}
