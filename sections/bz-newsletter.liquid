<section class="bz bz-bottom bz-news" id="newsletter">
  <div class="bz-news__card">
    <h2>{{ section.settings.heading | default: 'Novità,' | escape }} <em>{{ section.settings.heading_accent | default: 'via email' | escape }}</em></h2>
    <div>
      {%- form 'customer', id: 'newsletter-form', class: 'contact-form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label class="news-label bz-vh" for="newsletter-email">{{ section.settings.placeholder | escape }}</label>
        {%- if form.posted_successfully? -%}
          <p id="newsletter-status" role="status">Fatto. Ti scriviamo al prossimo arrivo.</p>
        {%- else -%}
          <input id="newsletter-email" type="email" name="contact[email]" required aria-label="{{ section.settings.placeholder | escape }}" placeholder="{{ section.settings.placeholder | escape }}" autocomplete="email">
          <button type="submit">{{ section.settings.button_label | escape }}</button>
          {%- if form.errors -%}<p role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>{%- endif -%}
        {%- endif -%}
      {%- endform -%}
      <small>{{ section.settings.note | escape }}</small>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titolo", "default": "Novità," },
    { "type": "text", "id": "heading_accent", "label": "Corsivo", "default": "via email" },
    { "type": "text", "id": "placeholder", "label": "Segnaposto", "default": "La tua email" },
    { "type": "text", "id": "button_label", "label": "Pulsante", "default": "Iscriviti" },
    { "type": "text", "id": "note", "label": "Nota", "default": "Ti scriviamo quando arrivano pietre nuove o tornano quelle finite." }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
