{%- liquid
  assign bz_intent_any = false
  for block in section.blocks
    if block.settings.collection != blank and block.settings.collection.products_count > 0
      assign bz_intent_any = true
    endif
  endfor
-%}
{%- if bz_intent_any -%}
{{ 'bz-tokens.css' | asset_url | stylesheet_tag }}
{{ 'bz-home.css' | asset_url | stylesheet_tag }}
{{ 'bz-mid.css' | asset_url | stylesheet_tag }}

<section class="bz bz-mid bz-intent" lang="it">
  {%- if section.settings.heading != blank -%}
    <h2>{{ section.settings.heading | escape }}</h2>
  {%- endif -%}
  <div class="bz-intent__list">
    {%- for block in section.blocks -%}
      {%- if block.settings.collection != blank and block.settings.collection.products_count > 0 -%}
        {%- liquid
          assign intent_collection = block.settings.collection
          assign intent_image = intent_collection.image | default: intent_collection.products.first.featured_image
          assign intent_count = intent_collection.products_count
          assign intent_min = blank
          if intent_count > 0 and intent_count <= 50
            for product in intent_collection.products
              if product.available
                if intent_min == blank or product.price < intent_min
                  assign intent_min = product.price
                endif
              endif
            endfor
          endif
          assign intent_cta = section.settings.cta_label | default: 'Scopri i pezzi'
        -%}
        <a class="bz-intent__card" href="{{ intent_collection.url }}" {{ block.shopify_attributes }}>
          {%- if intent_image != blank -%}
            <span class="bz-intent__media">
              {{ intent_image | image_url: width: 800 | image_tag: alt: block.settings.word, loading: 'lazy', widths: '320, 480, 800', sizes: '(min-width: 1100px) 18vw, 78vw', width: 480, height: 360 }}
            </span>
          {%- endif -%}
          <span class="bz-intent__body">
            <strong>{{ block.settings.word | escape }}</strong>
            {%- if block.settings.line != blank -%}
              <em>{{ block.settings.line | escape }}</em>
            {%- endif -%}
            <small>
              {%- if intent_count == 1 -%}1 pezzo{%- else -%}{{ intent_count }} pezzi{%- endif -%}
              {%- if intent_min != blank -%} · da {% render 'bz-money', cents: intent_min %}{%- endif -%}
            </small>
            <span class="bz-intent__cta">{{ intent_cta | escape }} <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
          </span>
        </a>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Scegli per intenzione",
  "class": "bz-home",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titolo", "default": "Scegli per intenzione" },
    { "type": "text", "id": "cta_label", "label": "Testo del pulsante", "default": "Scopri i pezzi" }
  ],
  "blocks": [
    {
      "type": "intention",
      "name": "Intenzione",
      "settings": [
        { "type": "text", "id": "word", "label": "Parola", "default": "Serenità" },
        { "type": "textarea", "id": "line", "label": "Riga", "default": "In molte pratiche l'ametista si tiene vicina quando si cerca quiete." },
        { "type": "collection", "id": "collection", "label": "Collezione", "info": "Compare solo se la collezione ha almeno un prodotto." }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Scegli per intenzione",
      "settings": {
        "heading": "Scegli per intenzione"
      },
      "blocks": [
        {
          "type": "intention",
          "settings": {
            "word": "Serenità",
            "line": "In molte pratiche l'ametista si tiene vicina quando si cerca quiete."
          }
        },
        {
          "type": "intention",
          "settings": {
            "word": "Coraggio",
            "line": "Corniola e diaspro rosso accompagnano chi deve farsi avanti."
          }
        },
        {
          "type": "intention",
          "settings": {
            "word": "Protezione",
            "line": "Tormalina e ossidiana si portano come un confine, una pietra scura addosso."
          }
        },
        {
          "type": "intention",
          "settings": {
            "word": "Affetti",
            "line": "Il quarzo rosa, in tante tradizioni, è la pietra che si regala a chi si vuole bene."
          }
        },
        {
          "type": "intention",
          "settings": {
            "word": "Concentrazione",
            "line": "Il lapislazzuli si usa da secoli quando serve tenere la mente su una cosa sola."
          }
        }
      ]
    }
  ]
}
{% endschema %}
