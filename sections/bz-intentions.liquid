{%- liquid
  assign bz_intent_any = false
  for block in section.blocks
    if block.settings.collection != blank and block.settings.collection.products_count > 0
      assign bz_intent_any = true
    endif
  endfor
-%}
{%- if bz_intent_any -%}
{{ 'bz-tokens.css' | asset_url | stylesheet_tag }}
{{ 'bz-home.css' | asset_url | stylesheet_tag }}
{{ 'bz-mid.css' | asset_url | stylesheet_tag }}

<section class="bz bz-mid bz-intent" lang="it">
  {%- if section.settings.heading != blank -%}
    <h2>{{ section.settings.heading | escape }}</h2>
  {%- endif -%}
  <div class="bz-intent__list">
    {%- for block in section.blocks -%}
      {%- if block.settings.collection != blank and block.settings.collection.products_count > 0 -%}
        <div class="bz-intent__item" {{ block.shopify_attributes }}>
          {%- if block.settings.word != blank and block.settings.collection.url != blank and block.settings.collection.url != '#' -%}
            <a class="bz-intent__word" href="{{ block.settings.collection.url }}">{{ block.settings.word | escape }}</a>
          {%- endif -%}
          {%- if block.settings.line != blank -%}
            <p class="bz-intent__line">{{ block.settings.line | escape }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Scegli per intenzione",
  "class": "bz-home",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titolo", "default": "Scegli per intenzione" }
  ],
  "blocks": [
    {
      "type": "intention",
      "name": "Intenzione",
      "settings": [
        { "type": "text", "id": "word", "label": "Parola", "default": "Serenità" },
        { "type": "textarea", "id": "line", "label": "Riga", "default": "In molte pratiche l'ametista si tiene vicina quando si cerca quiete." },
        { "type": "collection", "id": "collection", "label": "Collezione", "info": "Compare solo se la collezione ha almeno un prodotto." }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Scegli per intenzione",
      "settings": {
        "heading": "Scegli per intenzione"
      },
      "blocks": [
        {
          "type": "intention",
          "settings": {
            "word": "Serenità",
            "line": "In molte pratiche l'ametista si tiene vicina quando si cerca quiete."
          }
        },
        {
          "type": "intention",
          "settings": {
            "word": "Coraggio",
            "line": "Corniola e diaspro rosso accompagnano chi deve farsi avanti."
          }
        },
        {
          "type": "intention",
          "settings": {
            "word": "Protezione",
            "line": "Tormalina e ossidiana si portano come un confine, una pietra scura addosso."
          }
        },
        {
          "type": "intention",
          "settings": {
            "word": "Affetti",
            "line": "Il quarzo rosa, in tante tradizioni, è la pietra che si regala a chi si vuole bene."
          }
        },
        {
          "type": "intention",
          "settings": {
            "word": "Concentrazione",
            "line": "Il lapislazzuli si usa da secoli quando serve tenere la mente su una cosa sola."
          }
        }
      ]
    }
  ]
}
{% endschema %}
