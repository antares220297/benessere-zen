{%- comment -%}
  Product metafields (namespace custom):
  custom.grani — single line text
  custom.diametro — single line text
  custom.peso — single line text
  custom.pietre, custom.pietre_contenute — lists of pietra metaobjects
  custom.pietra — legacy pietra reference
  custom.bento_title — single line text
{%- endcomment -%}
{%- if recommendations.performed -%}
  <span hidden data-bz-recommendations-result></span>
  {%- capture famiglia_libro -%}{%- render 'bz-libro-famiglia', product: product -%}{%- endcapture -%}
  {%- assign current = product.selected_or_first_available_variant -%}
  {%- capture display_name -%}{%- render 'bz-product-name', product: product -%}{%- endcapture -%}
  {%- render 'bz-product-upsell', product: product, current: current, family: famiglia_libro, section_id: section.id, show_offer: section.settings.mostra_sconto_insieme, main_name: display_name -%}
{%- else -%}
{{ 'bz-tokens.css' | asset_url | stylesheet_tag }}
{{ 'bz-home.css' | asset_url | stylesheet_tag }}
{{ 'bz-product.css' | asset_url | stylesheet_tag }}
{{ 'bz-buy.css' | asset_url | stylesheet_tag }}
{{ 'bz-cart.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign current = product.selected_or_first_available_variant
  assign main_form_id = 'BzProductForm-' | append: section.id
  assign ship_euros = settings.bz_free_shipping_threshold | default: 50 | at_least: 1
  assign threshold = ship_euros | times: 100
  assign projected_total = cart.total_price | plus: current.price
  assign ship_scale = projected_total | times: 1.0 | divided_by: threshold | at_least: 0.02 | at_most: 1
  assign type_key = product.type | downcase | strip
  assign show_mala_facts = false
  if type_key contains 'mala'
    assign show_mala_facts = true
  endif
  assign contenute = product.metafields.custom.pietre_contenute.value
-%}

{%- capture display_name -%}{% render 'bz-product-name', product: product %}{%- endcapture -%}
{%- assign stage_image = current.featured_image | default: product.featured_image -%}
<div class="bz bz-product" data-bz-product="{{ product.id }}" data-featured-image-id="{{ product.featured_image.id }}" data-bz-cart-total="{{ cart.total_price }}">
  <nav class="bz-crumb" aria-label="Percorso">
    <a href="{{ routes.root_url }}">Home</a>
    <span aria-hidden="true">›</span>
    {%- if collection -%}
      <a href="{{ collection.url }}">{{ collection.title | escape }}</a>
      <span aria-hidden="true">›</span>
    {%- endif -%}
    <span>{{ display_name | escape }}</span>
  </nav>

  <section class="bz-pdp">
    <div class="bz-gal">
      {%- if product.images.size > 1 -%}
      <div class="bz-thumbs">
        <div class="bz-thumbs__scroll">
          {%- for image in product.images -%}
            {%- assign image_alt = display_name | append: ', foto ' | append: forloop.index -%}
            <button type="button" class="{% if image.id == stage_image.id %}is-on{% endif %}" data-bz-thumb="{{ forloop.index }}" data-image-id="{{ image.id }}" aria-pressed="{% if image.id == stage_image.id %}true{% else %}false{% endif %}" data-full="{{ image | image_url: width: 1400 | escape }}" aria-label="{{ image_alt | escape }}">
              {{ image | image_url: width: 160 | image_tag: alt: '', width: 84, height: 84, loading: 'lazy' }}
            </button>
          {%- endfor -%}
        </div>
      </div>
      {%- endif -%}
      <div class="bz-stage">
        {%- if stage_image -%}
          {%- assign stage_position = stage_image.position | default: 1 -%}
          {%- assign stage_alt = display_name | append: ', foto ' | append: stage_position -%}
          {{ stage_image | image_url: width: 1400 | image_tag: alt: stage_alt, id: 'BzStage', loading: 'eager', fetchpriority: 'high', preload: true, widths: '600, 1000, 1400', sizes: '(min-width: 861px) 45vw, 95vw', width: 900, height: 900 }}
        {%- endif -%}
        <div class="bz-stage__badges">
          {%- if current.inventory_management != blank and current.inventory_quantity == 1 and current.available -%}
            <span class="bz-badge bz-stock--low">Ultimo pezzo</span>
          {%- endif -%}
        </div>
        {%- if product.has_only_default_variant == false or product.images.size > 1 -%}
        <div class="bz-stage__note">
          {%- unless product.has_only_default_variant -%}
            <span data-bz-gallery-variant>{{ current.title | escape }}</span>
          {%- endunless -%}
          {%- if product.images.size > 1 -%}
            <span data-bz-frame>{{ stage_image.position | default: 1 }} / {{ product.images.size }}</span>
          {%- endif -%}
        </div>
        {%- endif -%}
      </div>
    </div>

    <div class="bz-buy">
      <h1>{{ display_name | escape }}</h1>
      {%- if product.title contains '|' -%}
        {%- assign title_prefix = product.title | split: '|' | first | append: '|' -%}
        {%- assign subtitle = product.title | remove_first: title_prefix | strip -%}
        {%- if subtitle != blank -%}<p class="bz-buy__sub"><em>{{ subtitle | escape }}</em></p>{%- endif -%}
      {%- endif -%}
      <div class="bz-buy__price">
        <strong data-bz-price>{% render 'bz-money', cents: current.price %}</strong>
        <small>IVA inclusa</small>
      </div>
      {%- form 'product', product, id: main_form_id, class: 'bb-buy', data-name: display_name, data-unit: current.price -%}
        {%- if product.variants.size == 1 -%}
          <input type="hidden" name="id" value="{{ current.id }}" data-bz-variant="{{ current.price }}" data-available="{{ current.available }}">
        {%- endif -%}
        <div class="bb-row" id="bbRow">
          {% render 'bb-stepper', kind: 'main' %}
          {% render 'bb-atc', available: current.available %}
        </div>
        <p class="bz-upsell__status" data-bz-buy-status hidden></p>
        <div class="bb-ship{% if projected_total >= threshold %} is-free{% endif %}" data-ship data-threshold="{{ threshold }}">
          <p class="bb-ship__t">
            {% render 'bb-icon', name: 'local_shipping' %}
            <span data-ship-text>
              {%- if projected_total >= threshold -%}
                Spedizione gratuita inclusa
              {%- else -%}
                {%- assign missing = threshold | minus: projected_total -%}
                Ti mancano <b>{% render 'bz-money', cents: missing %}</b> per la spedizione gratuita
              {%- endif -%}
            </span>
          </p>
          <div class="bb-ship__bar" aria-hidden="true"><i data-ship-bar style="transform:scaleX({{ ship_scale }})"></i></div>
        </div>
        <p class="bb-sr" id="bbStatus" role="status" aria-live="polite"></p>
      {%- endform -%}
      {%- if contenute != blank %}
        <p class="bz-buy__contained">Contiene: {% for stone in contenute -%}
          {%- assign stone_name = stone.nome.value | default: stone.nome | strip | downcase | escape -%}
          {%- assign stone_handle = stone.system.handle -%}
          {%- assign stone_collection = collections[stone_handle] -%}
          {%- if stone_collection.url != blank and stone_collection.products_count > 0 -%}
            <a href="{{ stone_collection.url | escape }}">{{- stone_name -}}</a>
          {%- else -%}
            {{- stone_name -}}
          {%- endif -%}
          {%- unless forloop.last %}, {% endunless -%}
        {%- endfor %}</p>
      {%- endif -%}
      {%- capture famiglia_libro -%}{%- render 'bz-libro-famiglia', product: product -%}{%- endcapture -%}
      {%- capture ritual -%}{%- render 'bz-product-upsell', product: product, current: current, family: famiglia_libro, section_id: section.id, show_offer: section.settings.mostra_sconto_insieme, main_name: display_name -%}{%- endcapture -%}
      {%- capture care_faq -%}{%- render 'bz-product-care-faq', product: product, ship_euros: ship_euros, ritual: ritual -%}{%- endcapture -%}
      {%- if product.metafields.custom.descrizione_bz != blank or product.metafields.custom.benefici_bz.value.size > 0 or product.metafields.custom.dettagli_bz.value.size > 0 or product.metafields.custom.note_bz != blank -%}
        {%- render 'bz-product-description-fields', product: product, section_id: section.id, care_faq: care_faq -%}
      {%- else -%}
        {%- if product.description != blank -%}
          {%- render 'bz-product-description', description: product.description, section_id: section.id -%}
        {%- endif -%}
        {%- if care_faq != blank -%}
          <div class="bzs bz-description bz-description--fields">{{ care_faq }}</div>
        {%- endif -%}
      {%- endif -%}
      <p class="bz-buy__disclaimer">I significati appartengono alla tradizione e non sostituiscono il parere di un medico.</p>
      {%- if product.variants.size > 1 -%}
        <div class="bz-variants" role="group" aria-label="Variante">
          {%- for variant in product.variants -%}
            <label>
              <input type="radio" name="id" form="{{ main_form_id }}" value="{{ variant.id }}"{% if variant.id == current.id %} checked{% endif %} data-bz-variant="{{ variant.price }}" data-available="{{ variant.available }}" data-variant-title="{{ variant.title | escape }}" data-image-id="{{ variant.featured_image.id }}">
              <span>{{ variant.title | escape }}</span>
            </label>
          {%- endfor -%}
        </div>
      {%- endif -%}
      {{ ritual }}
      {%- if famiglia_libro != blank -%}
        {%- capture titolo_libro -%}{%- render 'bz-libro-famiglia', product: product, dato: 'titolo' -%}{%- endcapture -%}
        {%- liquid
          assign copertina_libro = 'libro-copertina-comune.webp'
          if famiglia_libro == 'ametista'
            assign copertina_libro = 'libro-copertina.webp'
          endif
        -%}
        <a class="bz-book-entry" href="#libro">
          <img src="{{ copertina_libro | asset_url }}" alt="" width="768" height="1024" loading="lazy" decoding="async">
          <span>
            <span class="bz-book-entry__kicker">Dal grimorio</span>
            <span class="bz-book-entry__title">{{ titolo_libro | escape }}</span>
            <span class="bz-book-entry__action">Sfoglia il libro <span aria-hidden="true">↓</span></span>
          </span>
        </a>
      {%- endif -%}
    </div>
  </section>

  {%- liquid
    assign stat_grani = product.metafields.custom.grani.value
    assign stat_diametro = product.metafields.custom.diametro.value
    assign stat_peso = product.metafields.custom.peso.value
    assign bento_title = product.metafields.custom.bento_title.value
    assign show_bento = false
    if show_mala_facts
      if stat_grani != blank or stat_diametro != blank or stat_peso != blank
        assign show_bento = true
      endif
    endif
  -%}
  {%- if show_bento -%}
  <div class="bz-dbento">
    <article class="is-tall">
      {%- if product.featured_image -%}
        {{ product.featured_image | image_url: width: 900 | image_tag: alt: '', loading: 'lazy', width: 500, height: 400 }}
      {%- endif -%}
      <div>
        {%- if bento_title != blank -%}
          <h3>{{ bento_title | escape }}</h3>
        {%- endif -%}
        {%- if section.settings.bento_text != blank -%}
          <p>{{ section.settings.bento_text | escape }}</p>
        {%- endif -%}
      </div>
    </article>
    {%- if stat_grani != blank -%}
      <article>
        <p class="bz-figure">{{ stat_grani | escape }}</p>
        {%- if section.settings.stat_1_text != blank -%}
          <p>{{ section.settings.stat_1_text | escape }}</p>
        {%- endif -%}
      </article>
    {%- endif -%}
    {%- if stat_diametro != blank -%}
      <article class="is-gold">
        <p class="bz-figure">{{ stat_diametro | escape }}</p>
        {%- if section.settings.stat_2_text != blank -%}
          <p>{{ section.settings.stat_2_text | escape }}</p>
        {%- endif -%}
      </article>
    {%- endif -%}
    {%- if stat_peso != blank -%}
      <article class="is-ox">
        <p class="bz-figure">{{ stat_peso | escape }}</p>
        {%- if section.settings.stat_3_text != blank -%}
          <p>{{ section.settings.stat_3_text | escape }}</p>
        {%- endif -%}
      </article>
    {%- endif -%}
    <article class="is-wide is-am">
      <h3>{{ section.settings.wide_title | escape }} <em>{{ section.settings.wide_accent | escape }}</em></h3>
      <p>{{ section.settings.wide_text | escape }}</p>
    </article>
  </div>
  {%- endif -%}

  <div class="bb-bottom" id="bbBottom" role="region" aria-label="Riepilogo acquisto" aria-hidden="true" inert>
    <div class="bb-bottom__in">
      {%- if stage_image -%}
        {{ stage_image | image_url: width: 96, height: 96, crop: 'center' | image_tag: class: 'bb-bottom__img', width: 48, height: 48, alt: '' }}
      {%- endif -%}
      <div class="bb-bottom__text">
        <span class="bb-bottom__name">{{ display_name | escape }}</span>
        <span class="bb-bottom__summary"><span data-bottom-prefix>{{ display_name | escape }} · </span><span data-bottom-quantity>1 pz</span></span>
      </div>
      <div class="bb-bottom__prices">
        <s class="bb-was" data-bottom-full hidden></s>
        <span class="bb-price" data-bottom-total aria-live="polite">{% render 'bz-money', cents: current.price %}</span>
        <span class="bb-badge" data-bottom-discount hidden>−10%</span>
      </div>
      {% render 'bb-atc', available: current.available, form_id: main_form_id %}
    </div>
    <p class="bz-upsell__status bb-bottom__error" data-bz-buy-status hidden></p>
  </div>
</div>
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ request.origin | json }} }
      {%- if collection -%}
      ,{ "@type": "ListItem", "position": 2, "name": {{ collection.title | json }}, "item": {{ request.origin | append: collection.url | json }} }
      ,{ "@type": "ListItem", "position": 3, "name": {{ display_name | json }}, "item": {{ request.origin | append: product.url | json }} }
      {%- else -%}
      ,{ "@type": "ListItem", "position": 2, "name": {{ display_name | json }}, "item": {{ request.origin | append: product.url | json }} }
      {%- endif -%}
    ]
  }
</script>
{%- liquid
  assign bz_price = current.price | divided_by: 100.0
-%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": {{ display_name | json }},
    "url": {{ request.origin | append: product.url | json }},
    {%- if product.featured_image -%}
    "image": {{ product.featured_image | image_url: width: 1200 | prepend: 'https:' | json }},
    {%- endif -%}
    "description": {{ product.description | strip_html | truncate: 300 | json }},
    "brand": { "@type": "Brand", "name": {{ shop.name | json }} },
    "offers": {
      "@type": "Offer",
      "priceCurrency": {{ cart.currency.iso_code | default: 'EUR' | json }},
      "price": {{ bz_price | json }},
      "availability": "https://schema.org/{% if current.available %}InStock{% else %}OutOfStock{% endif %}",
      "url": {{ request.origin | append: product.url | json }}
    }
  }
</script>
<script src="{{ 'bz-chrome.js' | asset_url }}" data-bz-cart-api-only defer></script>
<script src="{{ 'bz-product.js' | asset_url }}" defer></script>

{%- endif -%}

{% schema %}
{
  "name": "Scheda prodotto",
  "class": "bz-home",
  "settings": [
    { "type": "checkbox", "id": "mostra_sconto_insieme", "label": "Mostra il prezzo scontato −10% nel blocco rituale", "info": "Accendere solo quando lo sconto automatico −10% è attivo in Shopify.", "default": false },
    { "type": "text", "id": "bento_title", "label": "Titolo grande", "info": "Non stampato. Il titolo in pagina è il metafield custom.bento_title.", "default": "La nappa" },
    { "type": "text", "id": "bento_accent", "label": "Corsivo", "info": "Non stampato. Il titolo in pagina è il metafield custom.bento_title.", "default": "chiude il giro" },
    { "type": "textarea", "id": "bento_text", "label": "Testo", "default": "Annodata a mano, con l'anello che separa il grano guru." },
    { "type": "text", "id": "stat_1", "label": "Numero grani", "info": "Legacy dei template. In pagina il numero è custom.grani." },
    { "type": "text", "id": "stat_1_text", "label": "Testo grani", "info": "Il numero è custom.grani. Il riquadro compare solo se quel metafield ha un valore.", "default": "grani, il numero dei mantra nella tradizione" },
    { "type": "text", "id": "stat_2", "label": "Diametro", "info": "Legacy dei template. In pagina il numero è custom.diametro." },
    { "type": "text", "id": "stat_2_text", "label": "Testo diametro", "info": "Il numero è custom.diametro. Il riquadro compare solo se quel metafield ha un valore.", "default": "ogni perla, lucida e liscia al tatto" },
    { "type": "text", "id": "stat_3", "label": "Peso", "info": "Legacy dei template. In pagina il numero è custom.peso." },
    { "type": "text", "id": "stat_3_text", "label": "Testo peso", "info": "Il numero è custom.peso. Il riquadro compare solo se quel metafield ha un valore.", "default": "leggero da portare tutto il giorno" },
    { "type": "product", "id": "pair", "label": "Si abbina a", "info": "Impostazione legacy dei template." },
    { "type": "text", "id": "wide_title", "label": "Titolo largo", "default": "Al collo" },
    { "type": "text", "id": "wide_accent", "label": "Corsivo largo", "default": "o al polso" },
    { "type": "textarea", "id": "wide_text", "label": "Testo largo", "default": "Lungo, cade sotto il petto. Avvolto tre o quattro volte, diventa un bracciale a strati." },
    { "type": "collection", "id": "related", "label": "Collezione correlata" },
    { "type": "text", "id": "related_heading", "label": "Titolo correlati", "default": "Altri mala," },
    { "type": "text", "id": "related_accent", "label": "Corsivo correlati", "default": "stessi 108 grani" },
    { "type": "text", "id": "related_link", "label": "Link correlati", "default": "Tutti i mala" }
  ],
  "blocks": [
    { "type": "fact", "name": "Dato", "settings": [
      { "type": "text", "id": "metafield", "label": "Chiave metafield custom", "info": "pietra, grani, diametro o peso. Se compilata, la pillola compare solo quando il metafield ha un valore." },
      { "type": "text", "id": "value", "label": "Valore", "info": "Usato solo se la chiave metafield è vuota." },
      { "type": "text", "id": "label", "label": "Etichetta" },
      { "type": "color", "id": "swatch", "label": "Pastiglia colore" }
    ]},
    { "type": "spec", "name": "Specifica", "settings": [
      { "type": "text", "id": "label", "label": "Etichetta" },
      { "type": "text", "id": "metafield", "label": "Chiave metafield custom" },
      { "type": "text", "id": "fallback", "label": "Valore se il metafield è vuoto" }
    ]},
    { "type": "detail", "name": "Dettaglio", "settings": [
      { "type": "text", "id": "title", "label": "Titolo" },
      { "type": "richtext", "id": "text", "label": "Testo" },
      { "type": "checkbox", "id": "open", "label": "Aperto", "default": false }
    ]},
    { "type": "caption", "name": "Didascalia foto", "settings": [
      { "type": "text", "id": "text", "label": "Testo" }
    ]}
  ],
  "presets": [{ "name": "Scheda prodotto" }]
}
{% endschema %}
