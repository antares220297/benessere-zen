{%- comment -%}
  Product metafields (namespace custom):
  custom.grani — single line text
  custom.diametro — single line text
  custom.peso — single line text
  custom.pietra — single line text
  custom.bento_title — single line text
  custom.pairs_with — product reference
{%- endcomment -%}
{{ 'bz-tokens.css' | asset_url | stylesheet_tag }}
{{ 'bz-home.css' | asset_url | stylesheet_tag }}
{{ 'bz-product.css' | asset_url | stylesheet_tag }}
{{ 'bz-cart.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign current = product.selected_or_first_available_variant
  assign cents_num = current.price | modulo: 100
  assign euros = current.price | minus: cents_num | divided_by: 100
  assign cents = cents_num | prepend: '00' | slice: -2, 2
  assign opener = section.settings.opener
  if opener == blank
    assign opener = product.description | strip_html | truncate: 220
  endif
-%}

<div class="bz bz-product" data-bz-product>
  <nav class="bz-crumb" aria-label="Percorso">
    <a href="{{ routes.root_url }}">Home</a>
    <span aria-hidden="true">›</span>
    {%- if collection -%}
      <a href="{{ collection.url }}">{{ collection.title | escape }}</a>
      <span aria-hidden="true">›</span>
    {%- endif -%}
    <span>{{ product.title | escape }}</span>
  </nav>

  <section class="bz-pdp">
    <div class="bz-gal">
      <div class="bz-thumbs">
        <div class="bz-thumbs__scroll">
          {%- for image in product.images -%}
            <button type="button" class="{% if forloop.first %}is-on{% endif %}" data-bz-thumb="{{ forloop.index }}" data-full="{{ image | image_url: width: 1400 | escape }}" aria-label="Foto {{ forloop.index }}">
              {{ image | image_url: width: 160 | image_tag: alt: image.alt, width: 84, height: 84, loading: 'lazy' }}
            </button>
          {%- endfor -%}
        </div>
      </div>
      <div class="bz-stage">
        {%- if product.featured_image -%}
          {{ product.featured_image | image_url: width: 1400 | image_tag: alt: product.featured_image.alt, id: 'BzStage', widths: '600, 1000, 1400', sizes: '(min-width: 860px) 45vw, 100vw', width: 900, height: 900 }}
        {%- endif -%}
        <div class="bz-stage__badges">
          {%- if current.inventory_management != blank and current.inventory_quantity == 1 and current.available -%}
            <span class="bz-badge"><span class="bz-badge__dot"></span>Ultimo pezzo</span>
          {%- endif -%}
          {%- if section.settings.store_badge != blank -%}
            <span class="bz-pill">{{ section.settings.store_badge | escape }}</span>
          {%- endif -%}
        </div>
        <div class="bz-stage__note">
          <span>{{ section.settings.photo_note | escape }}</span>
          <span data-bz-frame>1 / {{ product.images.size | at_least: 1 }}</span>
        </div>
      </div>
      <div class="bz-minis">
        {%- for slot in (1..2) -%}
          {%- assign mini = product.images[slot] | default: product.featured_image -%}
          {%- assign mini_label = mini.alt -%}
          {%- assign cap_i = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'caption' -%}
              {%- assign cap_i = cap_i | plus: 1 -%}
              {%- if cap_i == slot and block.settings.text != blank -%}
                {%- assign mini_label = block.settings.text -%}
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
          <div class="bz-mini">
            {%- if mini != blank -%}
              {{ mini | image_url: width: 800 | image_tag: alt: mini_label, width: 400, height: 320, loading: 'lazy' }}
            {%- endif -%}
            {%- if mini_label != blank -%}
              <span>{{ mini_label | escape }}</span>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>

    <div class="bz-buy">
      <h1>{{ product.title | escape }}</h1>
      {%- if product.type != blank -%}
        <p class="bz-buy__sub">{{ product.type | escape }}</p>
      {%- endif -%}
      <div class="bz-buy__price">
        <strong data-bz-price>{% render 'bz-money', cents: product.price %}</strong>
        <small>IVA inclusa</small>
        {%- if section.settings.shipping_note != blank -%}
          <span class="bz-pill">{{ section.settings.shipping_note | escape }}</span>
        {%- endif -%}
      </div>
      {%- if opener != blank -%}
        <p class="bz-buy__open">{{ opener | escape }}</p>
      {%- endif -%}

      {%- capture fact_pills -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'fact' -%}
            {%- liquid
              assign fact_key = block.settings.metafield
              assign fact_value = block.settings.value
              assign fact_label = block.settings.label
              assign show_fact = false
              if fact_key != blank
                assign fact_value = product.metafields.custom[fact_key].value
                if fact_value != blank
                  assign show_fact = true
                endif
              elsif fact_value != blank or fact_label != blank
                assign show_fact = true
              endif
            -%}
            {%- if show_fact -%}
              <span class="bz-fact" {{ block.shopify_attributes }}>{%- if block.settings.swatch != blank -%}<i style="background: {{ block.settings.swatch }}"></i>{%- endif -%}{%- if fact_value != blank -%}<b>{{ fact_value | escape }}</b>{%- endif -%}{%- if fact_label != blank -%} {{ fact_label | escape }}{%- endif -%}</span>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endcapture -%}
      {%- if fact_pills contains 'class="bz-fact"' -%}
        <div class="bz-facts">{{ fact_pills }}</div>
      {%- endif -%}

      {%- assign ship_euros = settings.bz_free_shipping_threshold | default: section.settings.free_shipping | default: 50 -%}
      {%- assign threshold = ship_euros | times: 100 -%}
      <div class="bz-shipbox">
        {%- if current.price >= threshold -%}
          <p>Con questo pezzo la <b>spedizione è gratuita</b></p>
          {%- assign ship_width = 100 -%}
        {%- else -%}
          {%- assign short = threshold | minus: current.price -%}
          <p>Ti mancano <b>{% render 'bz-money', cents: short %}</b> per la spedizione gratuita</p>
          {%- assign ship_width = current.price | times: 100 | divided_by: threshold -%}
        {%- endif -%}
        <div class="bz-ship__track" aria-hidden="true">
          <i style="width: {{ ship_width }}%"></i>
          <span class="bz-ship__mark"><svg viewBox="0 0 24 24"><path d="M2 7h12v9H2zM14 10h4l3 3v3h-7"/><circle cx="6" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/></svg></span>
        </div>
        <div class="bz-shipbox__labels"><span>0 €</span><span>Gratis da {{ ship_euros }} €</span></div>
      </div>

      {%- form 'product', product, class: 'bz-ajax-cart' -%}
        {%- if product.has_only_default_variant -%}
          <input type="hidden" name="id" value="{{ current.id }}">
        {%- else -%}
          <div class="bz-variants">
            {%- for variant in product.variants -%}
              <label>
                <input type="radio" name="id" value="{{ variant.id }}" {% if variant.id == current.id %}checked{% endif %} {% unless variant.available %}disabled{% endunless %} data-bz-variant="{{ variant.price }}">
                {{ variant.title | escape }}
              </label>
            {%- endfor -%}
          </div>
        {%- endif -%}
        <div class="bz-atc" data-bz-atc>
          <div class="bz-qty">
            <button type="button" data-bz-qty="-1" aria-label="Meno">−</button>
            <input type="number" name="quantity" value="1" min="1" aria-label="Quantità" style="width:28px;border:0;background:transparent;color:inherit;text-align:center">
            <button type="button" data-bz-qty="1" aria-label="Più">+</button>
          </div>
          <button class="bz-btn bz-btn--gold" type="submit" name="add" {% unless current.available %}disabled{% endunless %}>
            {%- if current.available -%}Aggiungi al carrello{%- else -%}Esaurito{%- endif -%}
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </button>
        </div>
      {%- endform -%}

      <a class="bz-pickup" href="{{ section.settings.pickup_link }}">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 10l2-5h12l2 5M5 10h14v9H5zM9 19v-5h6v5"/></svg>
        Ritira <strong>gratis</strong> in negozio · di solito in <strong>{{ section.settings.pickup_hours | escape }}</strong>
      </a>

      {%- assign pair = product.metafields.custom.pairs_with.value -%}
      {%- if pair != blank and pair.id != blank -%}
        <div class="bz-pair">
          {%- if pair.featured_image -%}
            {{ pair.featured_image | image_url: width: 120 | image_tag: alt: pair.title, width: 52, height: 52 }}
          {%- endif -%}
          <div>Si abbina a {{ pair.title | escape }}<small>{% render 'bz-money', cents: pair.price %}</small></div>
          <form class="bz-ajax-cart" action="{{ routes.cart_add_url }}" method="post">
            <input type="hidden" name="id" value="{{ pair.selected_or_first_available_variant.id }}">
            <button class="bz-card__add" type="submit" aria-label="Aggiungi {{ pair.title | escape }}">+</button>
          </form>
        </div>
      {%- endif -%}

      <div class="bz-acc">
        {%- for block in section.blocks -%}
          {%- if block.type == 'detail' -%}
            <details {% if block.settings.open %}open{% endif %} {{ block.shopify_attributes }}>
              <summary>{{ block.settings.title | escape }}<i aria-hidden="true"><svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg></i></summary>
              <div class="bz-acc__body">
                {%- if block.settings.title == 'Dettagli' -%}
                  {%- capture spec_table -%}
                    {%- for spec in section.blocks -%}
                      {%- if spec.type == 'spec' -%}
                        {%- assign spec_value = product.metafields.custom[spec.settings.metafield].value | default: spec.settings.fallback -%}
                        {%- if spec_value != blank -%}
                          <tr><td>{{ spec.settings.label | escape }}</td><td>{{ spec_value | escape }}</td></tr>
                        {%- endif -%}
                      {%- endif -%}
                    {%- endfor -%}
                  {%- endcapture -%}
                  {%- if spec_table contains '<tr>' -%}
                    <table>{{ spec_table }}</table>
                  {%- elsif block.settings.text != blank -%}
                    {{ block.settings.text }}
                  {%- endif -%}
                {%- else -%}
                  {{ block.settings.text }}
                {%- endif -%}
              </div>
            </details>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>

  {%- liquid
    assign stat_grani = product.metafields.custom.grani.value
    assign stat_diametro = product.metafields.custom.diametro.value
    assign stat_peso = product.metafields.custom.peso.value
    assign bento_title = product.metafields.custom.bento_title.value
    assign show_bento = false
    if stat_grani != blank or stat_diametro != blank or stat_peso != blank
      assign show_bento = true
    endif
  -%}
  {%- if show_bento -%}
  <div class="bz-dbento">
    <article class="is-tall">
      {%- if product.featured_image -%}
        {{ product.featured_image | image_url: width: 900 | image_tag: alt: '', loading: 'lazy', width: 500, height: 400 }}
      {%- endif -%}
      <div>
        {%- if bento_title != blank -%}
          <h3>{{ bento_title | escape }}</h3>
        {%- endif -%}
        {%- if section.settings.bento_text != blank -%}
          <p>{{ section.settings.bento_text | escape }}</p>
        {%- endif -%}
      </div>
    </article>
    {%- if stat_grani != blank -%}
      <article>
        <p class="bz-figure">{{ stat_grani | escape }}</p>
        {%- if section.settings.stat_1_text != blank -%}
          <p>{{ section.settings.stat_1_text | escape }}</p>
        {%- endif -%}
      </article>
    {%- endif -%}
    {%- if stat_diametro != blank -%}
      <article class="is-gold">
        <p class="bz-figure">{{ stat_diametro | escape }}</p>
        {%- if section.settings.stat_2_text != blank -%}
          <p>{{ section.settings.stat_2_text | escape }}</p>
        {%- endif -%}
      </article>
    {%- endif -%}
    {%- if stat_peso != blank -%}
      <article class="is-ox">
        <p class="bz-figure">{{ stat_peso | escape }}</p>
        {%- if section.settings.stat_3_text != blank -%}
          <p>{{ section.settings.stat_3_text | escape }}</p>
        {%- endif -%}
      </article>
    {%- endif -%}
    <article class="is-wide is-am">
      <h3>{{ section.settings.wide_title | escape }} <em>{{ section.settings.wide_accent | escape }}</em></h3>
      <p>{{ section.settings.wide_text | escape }}</p>
    </article>
    <article>
      <h3>{{ section.settings.visit_title | escape }}</h3>
      <p>{{ section.settings.visit_text | escape }}</p>
      <a class="bz-picked__all" href="{{ section.settings.pickup_link }}">{{ section.settings.visit_link | escape }} <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
    </article>
  </div>
  {%- endif -%}
  {% render 'bz-wave', from: '#141312', to: '#2a141b' %}

  <form class="bz-sticky bz-ajax-cart" action="{{ routes.cart_add_url }}" method="post">
    <input type="hidden" name="id" value="{{ current.id }}">
    {%- if product.featured_image -%}
      {{ product.featured_image | image_url: width: 100 | image_tag: alt: '', width: 44, height: 44 }}
    {%- endif -%}
    <span>{{ product.title | escape }}<b>{% render 'bz-money', cents: product.price %}</b></span>
    <button type="submit">Aggiungi</button>
  </form>
</div>
<script src="{{ 'bz-product.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Scheda prodotto",
  "class": "bz-home",
  "settings": [
    { "type": "text", "id": "store_badge", "label": "Etichetta foto", "default": "Anche in negozio" },
    { "type": "text", "id": "photo_note", "label": "Nota foto", "default": "Pietra naturale: ogni pezzo è un po' diverso" },
    { "type": "textarea", "id": "opener", "label": "Testo di apertura" },
    { "type": "text", "id": "shipping_note", "label": "Nota spedizione", "default": "Spedizione gratuita" },
    { "type": "number", "id": "free_shipping", "label": "Soglia spedizione gratuita", "default": 50 },
    { "type": "text", "id": "pickup_hours", "label": "Tempo di ritiro", "default": "4 ore" },
    { "type": "url", "id": "pickup_link", "label": "Link ritiro" },
    { "type": "text", "id": "bento_title", "label": "Titolo grande", "info": "Non stampato. Il titolo in pagina è il metafield custom.bento_title.", "default": "La nappa" },
    { "type": "text", "id": "bento_accent", "label": "Corsivo", "info": "Non stampato. Il titolo in pagina è il metafield custom.bento_title.", "default": "chiude il giro" },
    { "type": "textarea", "id": "bento_text", "label": "Testo", "default": "Annodata a mano, con l'anello che separa il grano guru." },
    { "type": "text", "id": "stat_1_text", "label": "Testo grani", "info": "Il numero è custom.grani. Il riquadro compare solo se quel metafield ha un valore.", "default": "grani, il numero dei mantra nella tradizione" },
    { "type": "text", "id": "stat_2_text", "label": "Testo diametro", "info": "Il numero è custom.diametro. Il riquadro compare solo se quel metafield ha un valore.", "default": "ogni perla, lucida e liscia al tatto" },
    { "type": "text", "id": "stat_3_text", "label": "Testo peso", "info": "Il numero è custom.peso. Il riquadro compare solo se quel metafield ha un valore.", "default": "leggero da portare tutto il giorno" },
    { "type": "text", "id": "wide_title", "label": "Titolo largo", "default": "Al collo" },
    { "type": "text", "id": "wide_accent", "label": "Corsivo largo", "default": "o al polso" },
    { "type": "textarea", "id": "wide_text", "label": "Testo largo", "default": "Lungo, cade sotto il petto. Avvolto tre o quattro volte, diventa un bracciale a strati." },
    { "type": "collection", "id": "related", "label": "Collezione correlata" },
    { "type": "text", "id": "related_heading", "label": "Titolo correlati", "default": "Altri mala," },
    { "type": "text", "id": "related_accent", "label": "Corsivo correlati", "default": "stessi 108 grani" },
    { "type": "text", "id": "related_link", "label": "Link correlati", "default": "Tutti i mala" },
    { "type": "text", "id": "visit_title", "label": "Titolo visita", "default": "Vuoi vederlo prima?" },
    { "type": "text", "id": "visit_text", "label": "Testo visita", "default": "È anche in negozio, in via Provenzali 1." },
    { "type": "text", "id": "visit_link", "label": "Link visita", "default": "Orari" }
  ],
  "blocks": [
    { "type": "fact", "name": "Dato", "settings": [
      { "type": "text", "id": "metafield", "label": "Chiave metafield custom", "info": "pietra, grani, diametro o peso. Se compilata, la pillola compare solo quando il metafield ha un valore." },
      { "type": "text", "id": "value", "label": "Valore", "info": "Usato solo se la chiave metafield è vuota." },
      { "type": "text", "id": "label", "label": "Etichetta" },
      { "type": "color", "id": "swatch", "label": "Pastiglia colore" }
    ]},
    { "type": "spec", "name": "Specifica", "settings": [
      { "type": "text", "id": "label", "label": "Etichetta" },
      { "type": "text", "id": "metafield", "label": "Chiave metafield custom" },
      { "type": "text", "id": "fallback", "label": "Valore se il metafield è vuoto" }
    ]},
    { "type": "detail", "name": "Dettaglio", "settings": [
      { "type": "text", "id": "title", "label": "Titolo" },
      { "type": "richtext", "id": "text", "label": "Testo" },
      { "type": "checkbox", "id": "open", "label": "Aperto", "default": false }
    ]},
    { "type": "caption", "name": "Didascalia foto", "settings": [
      { "type": "text", "id": "text", "label": "Testo" }
    ]}
  ],
  "presets": [{ "name": "Scheda prodotto" }]
}
{% endschema %}
