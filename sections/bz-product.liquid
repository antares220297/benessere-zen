{%- comment -%}
  Product metafields (namespace custom):
  custom.grani — single line text
  custom.diametro — single line text
  custom.peso — single line text
  custom.pietra — single line text
  custom.bento_title — single line text
  custom.pairs_with — product reference
{%- endcomment -%}
{{ 'bz-tokens.css' | asset_url | stylesheet_tag }}
{{ 'bz-home.css' | asset_url | stylesheet_tag }}
{{ 'bz-product.css' | asset_url | stylesheet_tag }}
{{ 'bz-cart.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign current = product.selected_or_first_available_variant
  assign type_key = product.type | downcase | strip
  assign show_mala_facts = false
  if type_key contains 'mala'
    assign show_mala_facts = true
  endif
  assign show_stone_facts = false
  if show_mala_facts or type_key contains 'pietr' or type_key contains 'braccial' or type_key contains 'ciondol' or type_key contains 'collan' or type_key contains 'pendol'
    assign show_stone_facts = true
  endif
-%}

{%- capture display_name -%}{% render 'bz-product-name', product: product %}{%- endcapture -%}
{%- assign stage_image = current.featured_image | default: product.featured_image -%}
<div class="bz bz-product" data-bz-product data-featured-image-id="{{ product.featured_image.id }}">
  <nav class="bz-crumb" aria-label="Percorso">
    <a href="{{ routes.root_url }}">Home</a>
    <span aria-hidden="true">›</span>
    {%- if collection -%}
      <a href="{{ collection.url }}">{{ collection.title | escape }}</a>
      <span aria-hidden="true">›</span>
    {%- endif -%}
    <span>{{ display_name | escape }}</span>
  </nav>

  <section class="bz-pdp">
    <div class="bz-gal">
      <div class="bz-thumbs">
        <div class="bz-thumbs__scroll">
          {%- for image in product.images -%}
            {%- assign image_alt = display_name | append: ', foto ' | append: forloop.index -%}
            <button type="button" class="{% if image.id == stage_image.id %}is-on{% endif %}" data-bz-thumb="{{ forloop.index }}" data-image-id="{{ image.id }}" aria-pressed="{% if image.id == stage_image.id %}true{% else %}false{% endif %}" data-full="{{ image | image_url: width: 1400 | escape }}" aria-label="{{ image_alt | escape }}">
              {{ image | image_url: width: 160 | image_tag: alt: '', width: 84, height: 84, loading: 'lazy' }}
            </button>
          {%- endfor -%}
        </div>
      </div>
      <div class="bz-stage">
        {%- if stage_image -%}
          {%- assign stage_position = stage_image.position | default: 1 -%}
          {%- assign stage_alt = display_name | append: ', foto ' | append: stage_position -%}
          {{ stage_image | image_url: width: 1400 | image_tag: alt: stage_alt, id: 'BzStage', loading: 'eager', fetchpriority: 'high', preload: true, widths: '600, 1000, 1400', sizes: '(min-width: 861px) 45vw, 95vw', width: 900, height: 900 }}
        {%- endif -%}
        <div class="bz-stage__badges">
          {%- if current.inventory_management != blank and current.inventory_quantity == 1 and current.available -%}
            <span class="bz-badge bz-stock--low">Ultimo pezzo</span>
          {%- endif -%}
        </div>
        {%- if product.has_only_default_variant == false or product.images.size > 1 -%}
        <div class="bz-stage__note">
          {%- unless product.has_only_default_variant -%}
            <span data-bz-gallery-variant>{{ current.title | escape }}</span>
          {%- endunless -%}
          {%- if product.images.size > 1 -%}
            <span data-bz-frame>{{ stage_image.position | default: 1 }} / {{ product.images.size }}</span>
          {%- endif -%}
        </div>
        {%- endif -%}
      </div>
    </div>

    <div class="bz-buy">
      <h1>{{ display_name | escape }}</h1>
      {%- if product.title contains '|' -%}
        {%- assign title_prefix = product.title | split: '|' | first | append: '|' -%}
        {%- assign subtitle = product.title | remove_first: title_prefix | strip -%}
        {%- if subtitle != blank -%}<p class="bz-buy__sub"><em>{{ subtitle | escape }}</em></p>{%- endif -%}
      {%- endif -%}
      <div class="bz-buy__price">
        <strong data-bz-price>{% render 'bz-money', cents: current.price %}</strong>
        <small>IVA inclusa</small>
      </div>
      {%- if product.description != blank -%}
        <div class="bz-description" data-bz-description>
          <div class="bz-buy__open rte" data-bz-intro hidden></div>
          <div class="bz-brief" data-bz-brief hidden>
            <h2>In breve</h2>
            <ul role="list"></ul>
          </div>
          <button class="bz-description__toggle" type="button" aria-expanded="false" aria-controls="BzDescription-{{ section.id }}" hidden>Leggi tutto</button>
          <div class="bz-description__body rte" id="BzDescription-{{ section.id }}">{{ product.description }}</div>
        </div>
      {%- endif -%}
      <p class="bz-buy__disclaimer">I significati appartengono alla tradizione e non sostituiscono il parere di un medico.</p>
      {%- assign main_form_id = 'BzProductForm-' | append: section.id -%}
      {%- form 'product', product, id: main_form_id, class: 'bz-ajax-cart' -%}
        {%- if product.has_only_default_variant -%}
          <input type="hidden" name="id" value="{{ current.id }}">
        {%- else -%}
          <div class="bz-variants" role="group" aria-label="Variante">
            {%- for variant in product.variants -%}
              <label>
                <input type="radio" name="id" value="{{ variant.id }}" {% if variant.id == current.id %}checked{% endif %} {% unless variant.available %}disabled{% endunless %} data-bz-variant="{{ variant.price }}" data-image-id="{{ variant.featured_image.id }}">
                <span>{{ variant.title | escape }}</span>
              </label>
            {%- endfor -%}
          </div>
        {%- endif -%}
        <div class="bz-atc" data-bz-atc>
          <div class="bz-qty">
            <button type="button" data-bz-qty="-1" aria-label="Meno">−</button>
            <input type="number" name="quantity" value="1" min="1" aria-label="Quantità">
            <button type="button" data-bz-qty="1" aria-label="Più">+</button>
          </div>
          <button class="bz-btn bz-btn--gold{% unless current.available %} bz-stock--soldout{% endunless %}" type="submit" name="add" {% if current.available %}aria-label="Aggiungi al carrello: {{ display_name | escape }}"{% endif %} {% unless current.available %}disabled{% endunless %}>
            {% render 'bz-icon', name: 'shopping_bag', icon_class: 'bz-ico' %}
            <span data-bz-add-label>{% if current.available %}Aggiungi al carrello{% else %}Esaurito{% endif %}</span>
          </button>
        </div>
      {%- endform -%}
      <p class="bz-buy__return">
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 6 4 11l5 5M4 11h10a5 5 0 0 1 0 10"/></svg>
        Reso entro 14 giorni dalla ricezione
      </p>

      {%- assign ship_euros = settings.bz_free_shipping_threshold | default: 50 | at_least: 1 -%}
      {%- assign threshold = ship_euros | times: 100 -%}
      {%- assign projected_total = cart.total_price | plus: current.price -%}
      <div class="bz-shipbox" data-bz-shipping data-threshold="{{ threshold }}" data-price="{{ current.price }}">
        {%- if projected_total >= threshold -%}
          <p aria-live="polite"><b>Spedizione gratuita</b></p>
          {%- assign ship_width = 100 -%}
        {%- else -%}
          {%- assign short = threshold | minus: projected_total -%}
          <p aria-live="polite">Ti mancano <b>{% render 'bz-money', cents: short %}</b> per la spedizione gratuita</p>
          {%- assign ship_width = projected_total | times: 100 | divided_by: threshold -%}
        {%- endif -%}
        <div class="bz-ship__track" aria-hidden="true">
          <i style="width: {{ ship_width }}%"></i>
        </div>
      </div>

      {%- assign shipping_block = section.blocks | where: 'type', 'detail' | where: 'id', 'det-4' | first -%}
      <div class="bz-acc bz-acc--shipping">
        <details {{ shipping_block.shopify_attributes }}>
          <summary>Spedizione e reso<i aria-hidden="true"><svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg></i></summary>
          <div class="bz-acc__body">
            <p>Spedizione Express {{ settings.bz_express_rate | default: '5,90' | escape }}&nbsp;€ quando la soglia indicata sopra non è raggiunta.</p>
            <p>Puoi chiedere un reso entro 14 giorni dalla ricezione. Il prodotto va restituito non indossato, con cartellini e confezione. La spedizione del reso è a tuo carico. Il pacco va a Via Olindo Malagodi 2, Cento. Se il reso è accettato, il rimborso arriva entro 10 giorni lavorativi. <a href="{{ shop.refund_policy.url | default: '/policies/refund-policy' }}">Informativa sui rimborsi</a></p>
          </div>
        </details>
      </div>
      <div class="bz-buy__details">
        {%- capture fact_pills -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'fact' -%}
              {%- liquid
                assign fact_key = block.settings.metafield
                assign fact_value = block.settings.value
                assign fact_label = block.settings.label
                assign show_fact = false
                if fact_key != blank
                  assign fact_value = product.metafields.custom[fact_key].value
                  if fact_key == 'pietra' and fact_value != blank
                    assign fact_name = fact_value.nome.value | default: fact_value.nome
                    if fact_name != blank
                      assign fact_value = fact_name
                    endif
                  endif
                  assign fact_text = fact_value | append: ''
                  if fact_text contains 'Metaobject' or fact_text contains 'Drop'
                    assign fact_value = blank
                  endif
                  assign fact_allowed = true
                  if fact_key == 'grani' or fact_key == 'diametro'
                    unless show_mala_facts
                      assign fact_allowed = false
                    endunless
                  endif
                  if fact_key == 'peso' or fact_key == 'pietra'
                    unless show_stone_facts
                      assign fact_allowed = false
                    endunless
                  endif
                  if fact_allowed and fact_value != blank
                    assign show_fact = true
                  endif
                elsif fact_value != blank or fact_label != blank
                  assign show_fact = true
                endif
              -%}
              {%- if show_fact -%}
                <span class="bz-fact" {{ block.shopify_attributes }}>{%- if block.settings.swatch != blank -%}<i style="background: {{ block.settings.swatch }}"></i>{%- endif -%}{%- if fact_value != blank -%}<b>{{ fact_value | escape }}</b>{%- endif -%}{%- if fact_label != blank -%} {{ fact_label | escape }}{%- endif -%}</span>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endcapture -%}
        {%- if fact_pills contains 'class="bz-fact"' -%}
          <div class="bz-facts">{{ fact_pills }}</div>
        {%- endif -%}

        {%- assign pair = product.metafields.custom.pairs_with.value -%}
        {%- if pair != blank and pair.id != blank -%}
          {%- assign pair_variant = pair.first_available_variant | default: pair.selected_or_first_available_variant -%}
          {%- capture pair_name -%}{% render 'bz-product-name', product: pair %}{%- endcapture -%}
          <div class="bz-pair{% if pair.metafields.custom.nome_vetrina.value != blank %} has-nome-vetrina{% else %} is-title-fallback{% endif %}">
            {%- if pair.featured_image -%}
              {{ pair.featured_image | image_url: width: 120 | image_tag: alt: pair_name, loading: 'lazy', width: 52, height: 52 }}
            {%- endif -%}
            <div>Si abbina a <span class="bz-pair__name">{{ pair_name | escape }}</span><small>{% render 'bz-money', cents: pair_variant.price %}</small></div>
            {%- if pair_variant.available -%}
            <form class="bz-ajax-cart" action="{{ routes.cart_add_url }}" method="post">
              <input type="hidden" name="id" value="{{ pair_variant.id }}">
              <button class="add bz-card__add" type="submit" aria-label="Aggiungi al carrello: {{ pair_name | escape }}">{% render 'bz-icon', name: 'add' %}</button>
            </form>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- liquid
          assign pietra = product.metafields.custom.pietra.value
          assign pietra_tradizione = blank
          assign pietra_cura = blank
          if show_stone_facts and pietra != blank
            assign pietra_tradizione = pietra.tradizione.value | default: pietra.tradizione
            assign pietra_cura = pietra.cura.value | default: pietra.cura
          endif
          assign meta_trad = product.metafields.custom.tradizione.value | default: product.metafields.custom.tradizione
          assign meta_cura = product.metafields.custom.cura.value | default: product.metafields.custom.cura
          if meta_trad != blank
            assign pietra_tradizione = meta_trad
          endif
          if meta_cura != blank
            assign pietra_cura = meta_cura
          endif
        -%}
        <div class="bz-acc">
          {%- for block in section.blocks -%}
            {%- if block.type == 'detail' and block.id != 'det-4' -%}
              {%- capture acc_body -%}
                {%- if block.id == 'det-1' -%}
                  {%- capture spec_table -%}
                    {%- for spec in section.blocks -%}
                      {%- if spec.type == 'spec' -%}
                        {%- assign spec_value = product.metafields.custom[spec.settings.metafield].value -%}
                        {%- if spec.settings.metafield == 'pietra' and spec_value != blank -%}
                          {%- assign spec_name = spec_value.nome.value | default: spec_value.nome -%}
                          {%- if spec_name != blank -%}
                            {%- assign spec_value = spec_name -%}
                          {%- endif -%}
                        {%- endif -%}
                        {%- assign spec_text = spec_value | append: '' -%}
                        {%- if spec_text contains 'Metaobject' or spec_text contains 'Drop' -%}
                          {%- assign spec_value = blank -%}
                        {%- endif -%}
                        {%- if spec_value != blank -%}
                          <tr><td>{{ spec.settings.label | escape }}</td><td>{{ spec_value | escape }}</td></tr>
                        {%- endif -%}
                      {%- endif -%}
                    {%- endfor -%}
                  {%- endcapture -%}
                  {%- if spec_table contains '<tr>' -%}
                    <table>{{ spec_table }}</table>
                  {%- endif -%}
                {%- elsif block.id == 'det-2' -%}
                  {%- if pietra_tradizione != blank -%}
                    <p>{{ pietra_tradizione | escape }}</p>
                  {%- endif -%}
                {%- elsif block.id == 'det-3' -%}
                  {%- if pietra_cura != blank -%}
                    <p>{{ pietra_cura | escape }}</p>
                  {%- endif -%}
                {%- elsif block.settings.text != blank -%}
                  {{ block.settings.text }}
                {%- endif -%}
              {%- endcapture -%}
              {%- assign acc_body = acc_body | strip -%}
              {%- if acc_body != blank -%}
                <details {% if block.settings.open %}open{% endif %} {{ block.shopify_attributes }}>
                  <summary>{{ block.settings.title | escape }}<i aria-hidden="true"><svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg></i></summary>
                  <div class="bz-acc__body">{{ acc_body }}</div>
                </details>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
          {%- assign uso_meta = product.metafields.custom.come_si_usa.value | default: product.metafields.custom.come_si_usa -%}
          {%- if uso_meta != blank -%}
            <details>
              <summary>Come si usa<i aria-hidden="true"><svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg></i></summary>
              <div class="bz-acc__body"><p>{{ uso_meta | escape }}</p></div>
            </details>
          {%- endif -%}
          {%- for faq_i in (1..3) -%}
            {%- liquid
              assign faq_q_key = 'faq_' | append: faq_i | append: '_domanda'
              assign faq_a_key = 'faq_' | append: faq_i | append: '_risposta'
              assign faq_q = product.metafields.custom[faq_q_key].value | default: product.metafields.custom[faq_q_key]
              assign faq_a = product.metafields.custom[faq_a_key].value | default: product.metafields.custom[faq_a_key]
            -%}
            {%- if faq_q != blank and faq_a != blank -%}
              <details>
                <summary>{{ faq_q | escape }}<i aria-hidden="true"><svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg></i></summary>
                <div class="bz-acc__body"><p>{{ faq_a | escape }}</p></div>
              </details>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </section>

  {%- liquid
    assign stat_grani = product.metafields.custom.grani.value
    assign stat_diametro = product.metafields.custom.diametro.value
    assign stat_peso = product.metafields.custom.peso.value
    assign bento_title = product.metafields.custom.bento_title.value
    assign show_bento = false
    if show_mala_facts
      if stat_grani != blank or stat_diametro != blank or stat_peso != blank
        assign show_bento = true
      endif
    endif
  -%}
  {%- if show_bento -%}
  <div class="bz-dbento">
    <article class="is-tall">
      {%- if product.featured_image -%}
        {{ product.featured_image | image_url: width: 900 | image_tag: alt: '', loading: 'lazy', width: 500, height: 400 }}
      {%- endif -%}
      <div>
        {%- if bento_title != blank -%}
          <h3>{{ bento_title | escape }}</h3>
        {%- endif -%}
        {%- if section.settings.bento_text != blank -%}
          <p>{{ section.settings.bento_text | escape }}</p>
        {%- endif -%}
      </div>
    </article>
    {%- if stat_grani != blank -%}
      <article>
        <p class="bz-figure">{{ stat_grani | escape }}</p>
        {%- if section.settings.stat_1_text != blank -%}
          <p>{{ section.settings.stat_1_text | escape }}</p>
        {%- endif -%}
      </article>
    {%- endif -%}
    {%- if stat_diametro != blank -%}
      <article class="is-gold">
        <p class="bz-figure">{{ stat_diametro | escape }}</p>
        {%- if section.settings.stat_2_text != blank -%}
          <p>{{ section.settings.stat_2_text | escape }}</p>
        {%- endif -%}
      </article>
    {%- endif -%}
    {%- if stat_peso != blank -%}
      <article class="is-ox">
        <p class="bz-figure">{{ stat_peso | escape }}</p>
        {%- if section.settings.stat_3_text != blank -%}
          <p>{{ section.settings.stat_3_text | escape }}</p>
        {%- endif -%}
      </article>
    {%- endif -%}
    <article class="is-wide is-am">
      <h3>{{ section.settings.wide_title | escape }} <em>{{ section.settings.wide_accent | escape }}</em></h3>
      <p>{{ section.settings.wide_text | escape }}</p>
    </article>
  </div>
  {%- endif -%}

  <div class="bz-sticky" inert>
    {%- if product.featured_image -%}
      {{ product.featured_image | image_url: width: 100 | image_tag: alt: '', loading: 'lazy', width: 44, height: 44 }}
    {%- endif -%}
    <span><em class="bz-sticky__name">{{ display_name | escape }}</em><b data-bz-price>{% render 'bz-money', cents: current.price %}</b></span>
    <button type="submit" form="{{ main_form_id }}"{% if current.available %} aria-label="Aggiungi al carrello: {{ display_name | escape }}"{% else %} disabled{% endif %}>{% if current.available %}Aggiungi{% else %}Esaurito{% endif %}</button>
  </div>
</div>
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ request.origin | json }} }
      {%- if collection -%}
      ,{ "@type": "ListItem", "position": 2, "name": {{ collection.title | json }}, "item": {{ request.origin | append: collection.url | json }} }
      ,{ "@type": "ListItem", "position": 3, "name": {{ display_name | json }}, "item": {{ request.origin | append: product.url | json }} }
      {%- else -%}
      ,{ "@type": "ListItem", "position": 2, "name": {{ display_name | json }}, "item": {{ request.origin | append: product.url | json }} }
      {%- endif -%}
    ]
  }
</script>
{%- liquid
  assign bz_price = current.price | divided_by: 100.0
-%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": {{ display_name | json }},
    "url": {{ request.origin | append: product.url | json }},
    {%- if product.featured_image -%}
    "image": {{ product.featured_image | image_url: width: 1200 | prepend: 'https:' | json }},
    {%- endif -%}
    "description": {{ product.description | strip_html | truncate: 300 | json }},
    "brand": { "@type": "Brand", "name": {{ shop.name | json }} },
    "offers": {
      "@type": "Offer",
      "priceCurrency": {{ cart.currency.iso_code | default: 'EUR' | json }},
      "price": {{ bz_price | json }},
      "availability": "https://schema.org/{% if current.available %}InStock{% else %}OutOfStock{% endif %}",
      "url": {{ request.origin | append: product.url | json }}
    }
  }
</script>
<script src="{{ 'bz-product.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Scheda prodotto",
  "class": "bz-home",
  "settings": [
    { "type": "text", "id": "bento_title", "label": "Titolo grande", "info": "Non stampato. Il titolo in pagina è il metafield custom.bento_title.", "default": "La nappa" },
    { "type": "text", "id": "bento_accent", "label": "Corsivo", "info": "Non stampato. Il titolo in pagina è il metafield custom.bento_title.", "default": "chiude il giro" },
    { "type": "textarea", "id": "bento_text", "label": "Testo", "default": "Annodata a mano, con l'anello che separa il grano guru." },
    { "type": "text", "id": "stat_1", "label": "Numero grani", "info": "Legacy dei template. In pagina il numero è custom.grani." },
    { "type": "text", "id": "stat_1_text", "label": "Testo grani", "info": "Il numero è custom.grani. Il riquadro compare solo se quel metafield ha un valore.", "default": "grani, il numero dei mantra nella tradizione" },
    { "type": "text", "id": "stat_2", "label": "Diametro", "info": "Legacy dei template. In pagina il numero è custom.diametro." },
    { "type": "text", "id": "stat_2_text", "label": "Testo diametro", "info": "Il numero è custom.diametro. Il riquadro compare solo se quel metafield ha un valore.", "default": "ogni perla, lucida e liscia al tatto" },
    { "type": "text", "id": "stat_3", "label": "Peso", "info": "Legacy dei template. In pagina il numero è custom.peso." },
    { "type": "text", "id": "stat_3_text", "label": "Testo peso", "info": "Il numero è custom.peso. Il riquadro compare solo se quel metafield ha un valore.", "default": "leggero da portare tutto il giorno" },
    { "type": "product", "id": "pair", "label": "Si abbina a", "info": "Legacy dei template. In pagina si usa custom.pairs_with." },
    { "type": "text", "id": "wide_title", "label": "Titolo largo", "default": "Al collo" },
    { "type": "text", "id": "wide_accent", "label": "Corsivo largo", "default": "o al polso" },
    { "type": "textarea", "id": "wide_text", "label": "Testo largo", "default": "Lungo, cade sotto il petto. Avvolto tre o quattro volte, diventa un bracciale a strati." },
