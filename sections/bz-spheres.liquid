<div class="category-row" aria-label="{{ section.settings.label | escape }}">
  {%- for block in section.blocks -%}
    {%- assign coll = block.settings.collection -%}
    {%- if coll == blank or coll.title == blank -%}
      {%- assign coll = collections['pietre-burattate'] -%}
    {%- endif -%}
    {%- assign image_coll = block.settings.image_collection | default: coll -%}
    {%- assign sphere_image = image_coll.image | default: image_coll.products.first.featured_image -%}
    <a href="{{ coll.url | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>
      {%- if sphere_image != blank -%}
        {{ sphere_image | image_url: width: 240 | image_tag: alt: '', loading: 'lazy', widths: '120, 180, 240', sizes: '106px', width: 106, height: 106 }}
      {%- endif -%}
      <span>{{ block.settings.label | escape }}</span>
    </a>
  {%- endfor -%}
</div>
{% schema %}
{
  "name": "Sfere",
  "class": "bz-home",
  "settings": [ { "type": "text", "id": "label", "label": "Etichetta", "default": "Categorie" } ],
  "blocks": [
    { "type": "sphere", "name": "Sfera", "settings": [
      { "type": "text", "id": "label", "label": "Nome", "default": "Mala" },
      { "type": "collection", "id": "collection", "label": "Collezione" },
      { "type": "collection", "id": "image_collection", "label": "Collezione per la foto (facoltativa)" }
    ] }
  ],
  "max_blocks": 12,
  "presets": [{ "name": "Sfere" }]
}
{% endschema %}
