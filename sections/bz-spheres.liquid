{{ 'bz-tokens.css' | asset_url | stylesheet_tag }}
{{ 'bz-home.css' | asset_url | stylesheet_tag }}

<nav class="bz bz-home bz-spheres" aria-label="{{ section.settings.label | escape }}">
  {%- for block in section.blocks -%}
    {%- liquid
      assign sphere_collection = block.settings.collection
      if sphere_collection != blank and collections[sphere_collection.handle] != blank
        assign sphere_collection = collections[sphere_collection.handle]
      endif
      assign sphere_url = sphere_collection.url
      if block.settings.show_all
        assign sphere_url = routes.all_products_collection_url
      endif
      if block.settings.link != blank
        assign sphere_url = block.settings.link
      endif
      assign sphere_image = blank
      assign min_price = blank
      assign priced = false
      if sphere_collection != blank and block.settings.show_all == false and sphere_collection.products_count > 0
        assign first_product = sphere_collection.products.first
        if first_product.featured_image != blank
          assign sphere_image = first_product.featured_image
        endif
        if sphere_collection.products_count <= 50 and sphere_collection.products.size == sphere_collection.products_count
          assign cheapest = sphere_collection.products | sort: 'price'
          if cheapest.first != blank and cheapest.first.price != blank
            assign min_price = cheapest.first.price
            assign priced = true
          endif
        endif
      endif
      if sphere_image == blank and block.settings.image != blank
        assign sphere_image = block.settings.image
      endif
      if sphere_image == blank and sphere_collection != blank and sphere_collection.image != blank
        assign sphere_image = sphere_collection.image
      endif
    -%}
    <a class="bz-sphere{% if sphere_url != blank and request.path == sphere_url %} is-on{% endif %}" href="{{ sphere_url }}" {{ block.shopify_attributes }}>
      <span class="bz-sphere__ring">
        <span>
          {%- if block.settings.show_all -%}
            <span class="bz-sphere__all"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
          {%- elsif sphere_image != blank -%}
            {{ sphere_image | image_url: width: 240 | image_tag: alt: block.settings.label, widths: '120, 180, 240', sizes: '104px', width: 104, height: 104, loading: 'lazy' }}
          {%- else -%}
            <span class="bz-sphere__fallback">{{ block.settings.label | slice: 0 | escape }}</span>
          {%- endif -%}
        </span>
      </span>
      {{ block.settings.label | escape }}
      {%- if block.settings.show_all and collections.all.products_count > 0 -%}
        <small>{{ collections.all.products_count }} prodotti</small>
      {%- elsif priced -%}
        <small>da {% render 'bz-money', cents: min_price %}</small>
      {%- endif -%}
    </a>
  {%- endfor -%}
</nav>

{% schema %}
{
  "name": "Sfere categorie",
  "class": "bz-home",
  "settings": [
    { "type": "text", "id": "label", "label": "Etichetta del menu", "default": "Categorie" }
  ],
  "blocks": [
    {
      "type": "sphere",
      "name": "Categoria",
      "settings": [
        { "type": "text", "id": "label", "label": "Nome", "default": "Mala" },
        { "type": "collection", "id": "collection", "label": "Collezione" },
        { "type": "image_picker", "id": "image", "label": "Foto" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "checkbox", "id": "show_all", "label": "Mostra tutto il catalogo", "default": false }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [{ "name": "Sfere categorie" }]
}
{% endschema %}
