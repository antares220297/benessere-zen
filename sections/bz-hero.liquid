{{ 'bz-tokens.css' | asset_url | stylesheet_tag }}
{{ 'bz-home.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign source = section.settings.collection
  assign hero_image = section.settings.image
  if hero_image == blank and source != blank
    if source.image != blank
      assign hero_image = source.image
    elsif source.products.first.featured_image != blank
      assign hero_image = source.products.first.featured_image
    endif
  endif
  assign card_product = section.settings.product
  if card_product == blank and source.products.first != blank
    assign card_product = source.products.first
  endif
  assign hero_alt = section.settings.image_alt | default: section.settings.heading
-%}

<div class="bz bz-home bz-hero">
  <div class="bz-hero__main">
    {%- if hero_image != blank -%}
      {{ hero_image | image_url: width: 2000 | image_tag: alt: hero_alt, class: 'bz-hero__photo', widths: '600, 900, 1200, 1600, 2000', sizes: '(min-width: 860px) 60vw, 100vw', loading: 'eager', fetchpriority: 'high', width: 1200, height: 800 }}
    {%- endif -%}
    <div class="bz-hero__copy">
      <h1>{{ section.settings.heading | escape }} <em>{{ section.settings.heading_accent | escape }}</em></h1>
      {%- if section.settings.text != blank -%}
        <p>{{ section.settings.text | escape }}</p>
      {%- endif -%}
      <div class="bz-hero__actions">
        {%- if section.settings.primary_label != blank -%}
          <a class="bz-btn bz-btn--gold" href="{{ section.settings.primary_link | default: source.url }}">{{ section.settings.primary_label | escape }} <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
        {%- endif -%}
        {%- if section.settings.secondary_label != blank -%}
          <a class="bz-btn bz-btn--line" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label | escape }}</a>
        {%- endif -%}
      </div>
    </div>
    {%- if card_product != blank -%}
      {%- assign card_cents = card_product.price | modulo: 100 -%}
      {%- assign card_euros = card_product.price | minus: card_cents | divided_by: 100 -%}
      <a class="bz-hero__card" href="{{ card_product.url }}">
        {%- if card_product.featured_image != blank -%}
          {{ card_product.featured_image | image_url: width: 180 | image_tag: alt: '', widths: '120, 180', sizes: '62px', width: 62, height: 62, loading: 'lazy' }}
        {%- endif -%}
        <span>
          <b>{{ card_product.title | escape }}</b>
          <span class="bz-price">{{ card_euros }}<sup>,{{ card_cents | prepend: '00' | slice: -2, 2 }}</sup> €</span>
        </span>
      </a>
      <form class="bz-hero__form" action="{{ routes.cart_add_url }}" method="post">
        <input type="hidden" name="id" value="{{ card_product.selected_or_first_available_variant.id }}">
        <button class="bz-hero__add" type="submit" aria-label="Aggiungi {{ card_product.title | escape }}">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
        </button>
      </form>
    {%- endif -%}
  </div>
  <div class="bz-hero__side">
    {%- for block in section.blocks -%}
      {%- liquid
        assign tile_image = block.settings.image
        assign tile_collection = block.settings.collection
        if tile_image == blank and tile_collection != blank
          if tile_collection.image != blank
            assign tile_image = tile_collection.image
          elsif tile_collection.products.first.featured_image != blank
            assign tile_image = tile_collection.products.first.featured_image
          endif
        endif
        assign tile_url = block.settings.link | default: tile_collection.url
      -%}
      <a class="bz-tile bz-tile--{{ block.settings.tone }}" href="{{ tile_url }}" {{ block.shopify_attributes }}>
        {%- if tile_image != blank -%}
          <span class="bz-tile__photo">
            {{ tile_image | image_url: width: 900 | image_tag: alt: '', widths: '400, 700, 900', sizes: '(min-width: 860px) 20vw, 50vw', loading: 'lazy', width: 480, height: 320 }}
          </span>
        {%- endif -%}
        {%- if block.settings.badge != blank -%}
          <span class="bz-tile__pill">{{ block.settings.badge | escape }}</span>
        {%- endif -%}
        <span class="bz-tile__body">
          {%- if block.settings.figure != blank -%}
            <p class="bz-tile__figure">{{ block.settings.figure | escape }}{%- if block.settings.figure_unit != blank -%}<small>{{ block.settings.figure_unit | escape }}</small>{%- endif -%}</p>
          {%- endif -%}
          {%- if block.settings.title != blank -%}
            <h2>{{ block.settings.title | escape }}{% if block.settings.title_accent != blank %} <em>{{ block.settings.title_accent | escape }}</em>{% endif %}</h2>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <p>{{ block.settings.text | escape }}</p>
          {%- endif -%}
          {%- if block.settings.button_label != blank -%}
            <span class="bz-btn bz-btn--ivory bz-btn--sm">{{ block.settings.button_label | escape }} <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
          {%- endif -%}
        </span>
      </a>
    {%- endfor -%}
  </div>
</div>
<script src="{{ 'bz-home.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Hero",
  "class": "bz-home",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titolo", "default": "Un rituale" },
    { "type": "text", "id": "heading_accent", "label": "Titolo in corsivo", "default": "da portare addosso" },
    { "type": "textarea", "id": "text", "label": "Testo", "default": "Mala, bracciali e ciondoli in pietra naturale. Quello che vedi qui lo trovi anche in negozio, da toccare con mano." },
    { "type": "image_picker", "id": "image", "label": "Foto grande" },
    { "type": "text", "id": "image_alt", "label": "Testo alternativo della foto", "default": "Mala in onice nero con nappa nera su legno scuro" },
    { "type": "collection", "id": "collection", "label": "Collezione della foto e della scheda" },
    { "type": "product", "id": "product", "label": "Prodotto nella scheda" },
    { "type": "text", "id": "primary_label", "label": "Pulsante principale", "default": "Scopri i mala" },
    { "type": "url", "id": "primary_link", "label": "Link del pulsante principale" },
    { "type": "text", "id": "secondary_label", "label": "Pulsante secondario", "default": "Tutti i gioielli" },
    { "type": "url", "id": "secondary_link", "label": "Link del pulsante secondario" }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Riquadro",
      "settings": [
        { "type": "select", "id": "tone", "label": "Colore", "default": "am", "options": [
          { "value": "am", "label": "Ametista" },
          { "value": "ox", "label": "Rosso scuro" }
        ] },
        { "type": "text", "id": "badge", "label": "Etichetta" },
        { "type": "text", "id": "title", "label": "Titolo" },
        { "type": "text", "id": "title_accent", "label": "Titolo in corsivo" },
        { "type": "text", "id": "figure", "label": "Numero grande" },
        { "type": "text", "id": "figure_unit", "label": "Unità del numero" },
        { "type": "textarea", "id": "text", "label": "Testo" },
        { "type": "text", "id": "button_label", "label": "Pulsante" },
        { "type": "collection", "id": "collection", "label": "Collezione" },
        { "type": "image_picker", "id": "image", "label": "Foto" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 2,
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
