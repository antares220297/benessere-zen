<section class="home-hero" aria-label="In primo piano">
  <div class="hero-slides" data-bz-hero aria-label="Dal negozio">
    <div class="hero-slide hero-slide--featured active" aria-label="1 di 3">
      <img class="hero-photo" src="{{ 'bz-negozio-home-hero-negozio.jpg' | asset_url }}" alt="{{ section.settings.image_alt | escape }}" width="1600" height="900" loading="eager" fetchpriority="high">
      <div class="hero-copy">
        <h1>{{ section.settings.heading | escape }} <em>{{ section.settings.heading_accent | escape }}</em></h1>
        <p>{{ section.settings.text | escape }}</p>
        <div class="hero-actions">
          <a class="btn gold" href="{{ section.settings.primary_link }}">{% render 'bz-nav-label', label: section.settings.primary_label %}</a>
          <a class="btn outline" href="{{ section.settings.secondary_link }}">{% render 'bz-nav-label', label: section.settings.secondary_label %}</a>
        </div>
        {% render 'bz-trust' %}
      </div>
    </div>
    <div class="hero-slide new-slide" aria-hidden="true" inert aria-label="2 di 3">
      <div class="hero-copy">
        <h2>{{ section.settings.slide_2_heading | escape }} <em>{{ section.settings.slide_2_accent | escape }}</em></h2>
        <p>{{ section.settings.slide_2_text | escape }}</p>
        <div class="new-products bz-product-group">
          {%- for product in section.settings.slide_2_products -%}
            {% render 'bz-product-card', card: product, style: 'home' %}
          {%- endfor -%}
        </div>
        <a class="bz-row-link" href="{{ section.settings.slide_2_link }}">{% render 'bz-nav-label', label: 'Vedi i nuovi arrivi' %}</a>
      </div>
    </div>
    <div class="hero-slide" aria-hidden="true" inert aria-label="3 di 3">
      <img class="hero-photo" src="{{ 'bz-cover-cura-di-se-v3b.jpg' | asset_url }}" alt="{{ section.settings.slide_3_alt | escape }}" width="1400" height="900" loading="lazy">
      <div class="hero-copy">
        <h2>{{ section.settings.slide_3_heading | escape }} <em>{{ section.settings.slide_3_accent | escape }}</em></h2>
        <p>{{ section.settings.slide_3_text | escape }}</p>
        <a class="btn gold" href="{{ section.settings.slide_3_link }}">{% render 'bz-nav-label', label: section.settings.slide_3_label %}</a>
      </div>
    </div>
  </div>
  <div class="hero-side">
    {%- for block in section.blocks -%}
      {%- if block.type == 'tile' -%}
        <a class="photo-card small tone-{{ forloop.index0 }}" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 900 | image_tag: alt: '', loading: 'lazy', widths: '400, 700, 900', sizes: '30vw' }}
          {%- elsif block.settings.image_asset != blank -%}
            <img src="{{ block.settings.image_asset | asset_url }}" alt="" width="900" height="900" loading="lazy">
          {%- elsif block.settings.collection != blank and block.settings.collection.image -%}
            {{ block.settings.collection.image | image_url: width: 900 | image_tag: alt: '', loading: 'lazy', widths: '400, 700, 900', sizes: '30vw' }}
          {%- endif -%}
          <div>
            {%- if block.settings.badge != blank -%}<span class="badge">{{ block.settings.badge | escape }}</span>{%- endif -%}
            <h2>{{ block.settings.title | escape }} <em>{{ block.settings.accent | escape }}</em></h2>
            <p>{{ block.settings.text | escape }}</p>
            <span class="btn">{% render 'bz-nav-label', label: block.settings.button_label %}</span>
          </div>
        </a>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "class": "bz-home",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titolo", "default": "Un rituale" },
    { "type": "text", "id": "heading_accent", "label": "Corsivo", "default": "da portare addosso" },
    { "type": "textarea", "id": "text", "label": "Testo", "default": "Mala, bracciali e ciondoli in pietra naturale." },
    { "type": "text", "id": "image_alt", "label": "Testo alternativo", "default": "Scaffali di incensi e cosmesi nel negozio Benessere Zen a Cento" },
    { "type": "text", "id": "primary_label", "label": "Pulsante principale", "default": "Vedi i mala →" },
    { "type": "url", "id": "primary_link", "label": "Link principale" },
    { "type": "text", "id": "secondary_label", "label": "Pulsante secondario", "default": "Tutti i gioielli" },
    { "type": "url", "id": "secondary_link", "label": "Link secondario" },
    { "type": "product", "id": "featured_product", "label": "Mini scheda" },
    { "type": "collection", "id": "rotation_collection", "label": "Collezione per la rotazione" },
    { "type": "text", "id": "slide_2_heading", "label": "Slide 2 titolo", "default": "Nuovi arrivi" },
    { "type": "text", "id": "slide_2_accent", "label": "Slide 2 corsivo", "default": "dal negozio" },
    { "type": "text", "id": "slide_2_text", "label": "Slide 2 testo", "default": "Le ultime pietre che abbiamo scelto." },
    { "type": "url", "id": "slide_2_link", "label": "Slide 2 link" },
    { "type": "product_list", "id": "slide_2_products", "label": "Slide 2 prodotti", "limit": 3 },
    { "type": "text", "id": "slide_3_heading", "label": "Slide 3 titolo", "default": "Viso, corpo," },
    { "type": "text", "id": "slide_3_accent", "label": "Slide 3 corsivo", "default": "capelli" },
    { "type": "text", "id": "slide_3_text", "label": "Slide 3 testo", "default": "Parti da quello che usi ogni giorno." },
    { "type": "text", "id": "slide_3_label", "label": "Slide 3 pulsante", "default": "Vai a Cura di sé →" },
    { "type": "url", "id": "slide_3_link", "label": "Slide 3 link" },
    { "type": "text", "id": "slide_3_alt", "label": "Slide 3 alt", "default": "Cura di sé" }
  ],
  "blocks": [
    { "type": "tile", "name": "Scheda", "settings": [
      { "type": "text", "id": "badge", "label": "Etichetta" },
      { "type": "text", "id": "title", "label": "Titolo", "default": "Pietre" },
      { "type": "text", "id": "accent", "label": "Corsivo", "default": "da tasca" },
      { "type": "textarea", "id": "text", "label": "Testo" },
      { "type": "text", "id": "button_label", "label": "Pulsante", "default": "Scegli la tua →" },
      { "type": "text", "id": "link", "label": "Link" },
      { "type": "collection", "id": "collection", "label": "Collezione" },
      { "type": "image_picker", "id": "image", "label": "Foto" },
      { "type": "text", "id": "image_asset", "label": "Foto in assets" }
    ] }
  ],
  "max_blocks": 2,
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
