<section class="nt-noise" data-reveal style="background: var(--nt-oxblood);">
  <div class="nt-page">
    {% render 'chapter-label', chapter: section.settings.chapter %}
    <h2>{{ section.settings.heading | escape }}</h2>
    {%- if section.settings.text != blank -%}
      <p>{{ section.settings.text | escape }}</p>
    {%- endif -%}
    <div class="nt-grid nt-entries nt-entries--4">
      {%- for block in section.blocks -%}
        <a class="nt-set" href="{{ block.settings.url | default: '#' }}" {{ block.shopify_attributes }}>
          <span>
            <span class="nt-stone__name">{{ block.settings.title | escape }}</span>
            <span>{{ block.settings.contents | escape }}</span>
          </span>
          {%- if block.settings.price_text != blank -%}
            <span class="nt-set__price">{{ block.settings.price_text | escape }}</span>
          {%- endif -%}
        </a>
      {%- endfor -%}
    </div>
    {%- if settings.show_qty_tiers and section.settings.tier_text != blank -%}
      <p>{{ section.settings.tier_text | escape }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Set in vetrina",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "chapter", "label": "Capitolo", "default": "VI" },
    { "type": "text", "id": "heading", "label": "Titolo", "default": "Set già pensati" },
    { "type": "textarea", "id": "text", "label": "Testo", "default": "Onice, ametista e ambra, messi insieme. Il prezzo del set si vede in scheda, quando il set è in vendita." },
    { "type": "text", "id": "tier_text", "label": "Riga scaglioni", "default": "Due pezzi, 10% in meno. Tre pezzi, 15% in meno. Lo sconto si applica nel carrello.", "info": "Si vede solo se l'impostazione degli scaglioni è accesa." }
  ],
  "blocks": [
    {
      "type": "set",
      "name": "Set",
      "settings": [
        { "type": "text", "id": "title", "label": "Nome" },
        { "type": "text", "id": "contents", "label": "Cosa c'è dentro" },
        { "type": "text", "id": "price_text", "label": "Prezzo, solo se reale", "info": "Esempio da non lasciare vuoto di senso: 34 € invece di 41 €. Compila solo col prezzo del bundle Shopify." },
        { "type": "url", "id": "url", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "Set in vetrina" }]
}
{% endschema %}
