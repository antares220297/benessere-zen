{%- assign goal = settings.bz_free_shipping_threshold | default: 50 | at_least: 1 | times: 100 -%}
{%- assign missing = goal | minus: cart.total_price -%}
<section class="cart-page" aria-labelledby="cart-title" data-cart-section-id="{{ section.id }}">
  <h1 id="cart-title">Il tuo <em>carrello</em></h1>
  {%- if cart.item_count == 0 -%}
    <p class="cart-empty">Il tuo carrello è vuoto.</p>
    <a class="continue-shopping" href="{{ routes.all_products_collection_url }}">Scopri i prodotti</a>
  {%- else -%}
  <div class="cart-layout">
    <div class="cart-products">
      <ul class="cart-items">
        {%- for item in cart.items -%}
          {%- capture item_name -%}{% render 'bz-product-name', product: item.product %}{%- endcapture -%}
          <li class="cart-item" data-cart-line data-key="{{ item.key | escape }}" data-quantity="{{ item.quantity }}">
            <a class="item-photo" href="{{ item.url }}">
              {%- if item.image -%}
                {{ item.image | image_url: width: 240 | image_tag: alt: item_name, width: 120, height: 120, loading: 'lazy' }}
              {%- endif -%}
            </a>
            <div class="item-description">
              <h2><a href="{{ item.url }}">{{ item_name | escape }}</a></h2>
              {%- unless item.product.has_only_default_variant -%}
                <p>{{ item.variant.title | escape }}</p>
              {%- endunless -%}
              <p>{% render 'bz-money', cents: item.final_price %}</p>
              {% render 'bz-cart-line-controls', item: item, item_name: item_name %}
            </div>
            <div class="item-controls">
              <strong class="item-total">{% render 'bz-money', cents: item.final_line_price %}</strong>
            </div>
          </li>
        {%- endfor -%}
      </ul>
      <a class="continue-shopping" href="{{ routes.all_products_collection_url }}">{% render 'bz-nav-label', label: 'Continua gli acquisti' %}</a>
    </div>
    <aside class="cart-summary" aria-labelledby="summary-title">
      <h2 id="summary-title">Riepilogo</h2>
      <div class="shipping" data-shipping>
        <p id="shipping-status" role="status">
          {%- if cart.total_price >= goal -%}Spedizione gratuita{%- else -%}Ti mancano <strong>{% render 'bz-money', cents: missing %}</strong> per la spedizione gratuita{%- endif -%}
        </p>
        <div class="shipping-line">
          <div class="track" role="progressbar" aria-label="Avanzamento verso la spedizione gratuita" aria-valuemin="0" aria-valuemax="{{ goal }}" aria-valuenow="{{ cart.total_price | at_most: goal }}">
            <span style="transform:scaleX({{ cart.total_price | times: 1.0 | divided_by: goal | at_most: 1 }})"></span>
          </div>
          <span>{{ settings.bz_free_shipping_threshold | default: 50 | at_least: 1 }}&nbsp;€</span>
        </div>
      </div>
      <div class="cart-total"><span>Totale</span><strong id="cart-total">{% render 'bz-money', cents: cart.total_price %}</strong></div>
      <form class="cart-checkout-form" action="{{ routes.cart_url }}" method="post">
        <button class="btn gold checkout" type="submit" name="checkout">{% render 'bz-nav-label', label: 'Vai al pagamento' %}</button>
      </form>
      <p>Spediamo solo in Italia. Il corriere Express è {{ settings.bz_express_rate | default: '5,90' | escape }}&nbsp;€, gratuito da {{ settings.bz_free_shipping_threshold | default: 50 | at_least: 1 }}&nbsp;€.</p>
      <div class="pickup-note">
        {% render 'bz-icon', name: 'storefront' %}
        {% render 'bz-open-badge', variant: 'compact', linked: true %}
        <p><strong>Ritiri un ordine?</strong> Al pagamento scegli <em>Ritiro gratuito in negozio</em>.</p>
      </div>
      <p>{% render 'bz-hours', part: 'summary' %}</p>
    </aside>
  </div>
  {%- endif -%}
</section>
{% schema %}
{
  "name": "Carrello",
  "settings": [],
  "presets": [{ "name": "Carrello" }]
}
{% endschema %}
