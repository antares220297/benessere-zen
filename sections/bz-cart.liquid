{{ 'bz-tokens.css' | asset_url | stylesheet_tag }}
{{ 'bz-cart.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign seed = cart.items.first.product
  assign cart_ids = cart.items | map: 'product_id' | join: ',' | prepend: ',' | append: ','
-%}
<div id="bz-cart" class="bz-cartpage">
  <header class="bz-cartpage__head">
    <h1>Il tuo carrello</h1>
    <a href="{{ routes.all_products_collection_url }}">Continua lo shopping</a>
  </header>

  {%- if cart == empty -%}
    <p class="bz-drawer__empty">Il carrello è vuoto.</p>
    <a class="bz-drawer__go bz-drawer__shop" href="/collections/all">Continua lo shopping</a>
  {%- else -%}
    <div class="bz-cartpage__grid">
      <div>
        <div class="bz-drawer__items">
          {%- for item in cart.items -%}
            <article class="cart-item bz-drawer__item" data-key="{{ item.key }}">
              <a href="{{ item.url }}">
                {%- if item.image -%}
                  <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.product.title | escape }}" width="76" height="76">
                {%- endif -%}
              </a>
              <div class="bz-drawer__copy">
                <a href="{{ item.url }}">{{ item.product.title | escape }}</a>
                {%- if item.variant.title != blank and item.variant.title != 'Default Title' -%}
                  <small class="bz-drawer__variant">{{ item.variant.title | escape }}</small>
                {%- endif -%}
                <div class="bz-drawer__qty">
                  <button type="button" data-bz-qty="-1" aria-label="Meno">−</button>
                  <input class="bz-drawer__qty-input" id="page-qty-{{ item.key }}" type="text" inputmode="numeric" value="{{ item.quantity }}" aria-label="Quantità">
                  <button type="button" data-bz-qty="1" aria-label="Più">+</button>
                  <button type="button" data-bz-remove hidden>Rimuovi</button>
                </div>
              </div>
              <span class="bz-line-price">
                {% render 'bz-money', cents: item.final_line_price %}
                {%- if item.quantity > 1 -%}
                  <small class="bz-line-price__each">{% render 'bz-money', cents: item.final_price %} cad.</small>
                {%- endif -%}
              </span>
            </article>
          {%- endfor -%}
        </div>

        <div class="bz-drawer__upsell" data-bz-upsell data-product-id="{{ seed.id }}">
          <h4>Si abbina bene</h4>
          <div data-bz-upsell-list>
            {%- assign upsell_count = 0 -%}
            {%- if upsell_count < 2 and seed != blank -%}
              {%- for collection in seed.collections limit: 2 -%}
                {%- for product in collection.products limit: 8 -%}
                  {%- assign pid = product.id | prepend: ',' | append: ',' -%}
                  {%- unless cart_ids contains pid -%}
                    {%- if upsell_count < 2 and product.id != seed.id and product.available -%}
                      {%- assign upsell_count = upsell_count | plus: 1 -%}
                      <div class="bz-upsell">
                        <a href="{{ product.url }}">
                          {%- if product.featured_image -%}
                            <img src="{{ product.featured_image | image_url: width: 120 }}" alt="{{ product.title | escape }}" width="48" height="48">
                          {%- endif -%}
                        </a>
                        <a href="{{ product.url }}">{{ product.title | escape }}</a>
                        <span>{% render 'bz-money', cents: product.price %}</span>
                        <button type="button" class="bz-drawer__plus" data-bz-upsell-add="{{ product.selected_or_first_available_variant.id }}" aria-label="Aggiungi {{ product.title | escape }}">+</button>
                      </div>
                    {%- endif -%}
                  {%- endunless -%}
                {%- endfor -%}
              {%- endfor -%}
            {%- endif -%}
          </div>
        </div>
      </div>

      <aside class="bz-cartpage__summary">
        <p><span>Subtotale</span><strong>{% render 'bz-money', cents: cart.total_price %}</strong></p>
        <small>IVA inclusa. Spedizione al pagamento, oppure ritiro gratuito in negozio.</small>
        <form action="{{ routes.cart_url }}" method="post">
          <button id="checkout-submit" class="bz-drawer__go" type="submit" name="checkout">Vai al pagamento →</button>
        </form>
      </aside>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Carrello",
  "class": "bz-cart-section",
  "settings": [],
  "presets": [{ "name": "Carrello" }]
}
{% endschema %}
