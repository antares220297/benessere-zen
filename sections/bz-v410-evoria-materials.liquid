{%- liquid
  assign show_section = false
  assign has_note = false
  assign note_mode = ''
  assign note_text = ''
  assign note_mf = blank
  assign has_block_image = false
  assign detail_count = 0
  assign stone_name = ''

  if product != blank
    assign cura_mf = product.metafields.custom.cura
    assign trad_mf = product.metafields.custom.tradizione
    if cura_mf.value != blank
      assign note_mf = cura_mf
    elsif trad_mf.value != blank
      assign note_mf = trad_mf
    endif

    if note_mf != blank
      assign note_type = note_mf.type | append: ''
      if note_type == 'rich_text_field' or note_type == 'rich_text'
        assign has_note = true
        assign note_mode = 'rich'
      elsif note_type == 'single_line_text_field' or note_type == 'multi_line_text_field' or note_type == 'string'
        assign note_text = note_mf.value | append: '' | strip
        if note_text contains 'Metaobject' or note_text contains 'Drop' or note_text contains 'gid://'
          assign note_text = ''
        endif
        if note_text != blank
          assign has_note = true
          assign note_mode = 'text'
        endif
      endif
    endif

    for block in section.blocks
      if block.type == 'detail'
        assign detail_count = detail_count | plus: 1
        if block.settings.image != blank
          assign has_block_image = true
        endif
      endif
    endfor

    if has_block_image or product.images.size >= 2 or has_note
      assign show_section = true
    endif

    assign raw_nome = product.metafields.custom.pietra.value.nome
    if raw_nome != blank
      assign stone_name = raw_nome.value | default: raw_nome | append: '' | strip
      if stone_name contains 'Metaobject' or stone_name contains 'Drop' or stone_name contains 'gid://'
        assign stone_name = ''
      endif
    endif
  endif
-%}

{%- if show_section -%}
  {{ 'bz-tokens.css' | asset_url | stylesheet_tag }}
  {{ 'bz-home.css' | asset_url | stylesheet_tag }}
  {{ 'bz-v410-evoria-materials.css' | asset_url | stylesheet_tag }}
  <section class="bz bz-v410-materials"{% if section.settings.heading != blank %} aria-labelledby="BzMaterialsTitle-{{ section.id }}"{% endif %}>
    {%- if section.settings.heading != blank or section.settings.heading_accent != blank -%}
      <h2 class="bz-reveal" id="BzMaterialsTitle-{{ section.id }}">
        {{ section.settings.heading | escape }}
        {%- if section.settings.heading_accent != blank %} <em>{{ section.settings.heading_accent | escape }}</em>{%- endif -%}
      </h2>
    {%- endif -%}

    {%- if has_note -%}
      {%- if note_mode == 'rich' -%}
        <div class="bz-v410-materials__note rte">{{ note_mf | metafield_tag }}</div>
      {%- elsif note_mode == 'text' and note_text != blank -%}
        <p class="bz-v410-materials__note">{{ note_text | escape }}</p>
      {%- endif -%}
    {%- endif -%}

    {%- liquid
      assign shown = 0
      assign used = '|'
    -%}

    {%- capture materials_row -%}
      {%- if detail_count > 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'detail' -%}
            {%- if shown >= 4 -%}
              {%- break -%}
            {%- endif -%}
            {%- liquid
              if block.settings.image != blank
                assign mark = block.settings.image.id | append: '|'
                unless used contains mark
                  assign used = used | append: mark
                endunless
              endif
              assign shot = block.settings.image
              if shot == blank
                assign shot = blank
                for image in product.images
                  if product.images.size > 1 and forloop.index0 == 0
                    continue
                  endif
                  assign mark = image.id | append: '|'
                  unless used contains mark
                    assign shot = image
                    assign used = used | append: mark
                    break
                  endunless
                endfor
              endif
            -%}
            {%- if shot != blank -%}
              {%- liquid
                assign shown = shown | plus: 1
                assign caption = block.settings.caption | strip
                if caption == blank and shot.alt != blank
                  assign caption = shot.alt
                endif
                if caption == blank and stone_name != blank
                  assign caption = stone_name
                endif
                assign alt_text = block.settings.alt | strip
                if alt_text == blank and shot.alt != blank
                  assign alt_text = shot.alt
                endif
                if alt_text == blank
                  assign alt_text = product.title
                endif
                assign img_w = shot.width | default: 800
                assign img_h = shot.height | default: 1000
              -%}
              <figure class="bz-v410-materials__item bz-reveal" {{ block.shopify_attributes }}>
                {{ shot | image_url: width: 1200 | image_tag: alt: alt_text, widths: '360, 540, 720, 960, 1200', sizes: '(min-width: 800px) 30vw, 78vw', width: img_w, height: img_h, loading: 'lazy' }}
                {%- if caption != blank -%}
                  <figcaption>{{ caption | escape }}</figcaption>
                {%- endif -%}
              </figure>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        {%- for image in product.images -%}
          {%- if shown >= 4 -%}
            {%- break -%}
          {%- endif -%}
          {%- if product.images.size > 1 and forloop.index0 == 0 -%}
            {%- continue -%}
          {%- endif -%}
          {%- liquid
            assign shown = shown | plus: 1
            assign caption = image.alt
            if caption == blank and stone_name != blank
              assign caption = stone_name
            endif
            assign alt_text = image.alt
            if alt_text == blank
              assign alt_text = product.title
            endif
            assign img_w = image.width | default: 800
            assign img_h = image.height | default: 1000
          -%}
          <figure class="bz-v410-materials__item bz-reveal">
            {{ image | image_url: width: 1200 | image_tag: alt: alt_text, widths: '360, 540, 720, 960, 1200', sizes: '(min-width: 800px) 30vw, 78vw', width: img_w, height: img_h, loading: 'lazy' }}
            {%- if caption != blank -%}
              <figcaption>{{ caption | escape }}</figcaption>
            {%- endif -%}
          </figure>
        {%- endfor -%}
      {%- endif -%}
    {%- endcapture -%}

    {%- assign materials_row = materials_row | strip -%}
    {%- if materials_row != blank -%}
      <div class="bz-v410-materials__row">{{ materials_row }}</div>
    {%- endif -%}
  </section>
  <script src="{{ 'bz-pages.js' | asset_url }}" defer></script>
{%- endif -%}

{% schema %}
{
  "name": "Da vicino",
  "class": "bz-home",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Titolo", "default": "Da vicino" },
    { "type": "text", "id": "heading_accent", "label": "Titolo in corsivo", "default": "il pezzo" }
  ],
  "blocks": [
    {
      "type": "detail",
      "name": "Dettaglio",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Immagine" },
        { "type": "text", "id": "caption", "label": "Didascalia" },
        { "type": "text", "id": "alt", "label": "Testo alternativo" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Da vicino",
      "settings": {
        "heading": "Da vicino",
        "heading_accent": "il pezzo"
      },
      "blocks": [
        { "type": "detail", "settings": { "caption": "La pietra" } },
        { "type": "detail", "settings": { "caption": "Il filo" } },
        { "type": "detail", "settings": { "caption": "La chiusura" } }
      ]
    }
  ]
}
{% endschema %}
