{{ 'bz-tokens.css' | asset_url | stylesheet_tag }}
{{ 'bz-pages.css' | asset_url | stylesheet_tag }}
<section class="bz bz-pages bz-values">
  {%- if section.settings.heading != blank -%}<h2 class="bz-reveal">{{ section.settings.heading | escape }}</h2>{%- endif -%}
  <div class="bz-values__grid">
    {%- for block in section.blocks -%}
      <article class="bz-value bz-reveal" {{ block.shopify_attributes }}>
        {%- case forloop.index -%}
          {%- when 2 -%}
            <svg viewBox="0 0 48 48" aria-hidden="true"><rect x="8" y="12" width="32" height="24" rx="3"/><circle cx="18" cy="22" r="3"/><path d="M8 32l10-8 6 5 6-4 10 7"/></svg>
          {%- when 3 -%}
            <svg viewBox="0 0 48 48" aria-hidden="true"><path d="M10 28c6-10 22-10 28 0"/><path d="M16 28v8h16v-8"/><path d="M20 36v-4h8v4"/></svg>
          {%- else -%}
            <svg viewBox="0 0 48 48" aria-hidden="true"><path d="M24 8l4 10h10l-8 6 3 10-9-6-9 6 3-10-8-6h10z"/></svg>
        {%- endcase -%}
        <h3>{{ block.settings.title | escape }}</h3>
        <p>{{ block.settings.text | escape }}</p>
      </article>
    {%- endfor -%}
  </div>
</section>
<script src="{{ 'bz-pages.js' | asset_url }}" defer></script>
{% schema %}
{
  "name": "Card valori",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titolo" }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        { "type": "text", "id": "title", "label": "Titolo" },
        { "type": "textarea", "id": "text", "label": "Testo" }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [{ "name": "Card valori" }]
}
{% endschema %}
