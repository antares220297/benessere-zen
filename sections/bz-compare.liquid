{{ 'bz-tokens.css' | asset_url | stylesheet_tag }}
{{ 'bz-home.css' | asset_url | stylesheet_tag }}
{{ 'bz-pages.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign bz_compare_any = false
  for block in section.blocks
    if block.settings.collection != blank and block.settings.collection.products_count > 0
      assign bz_compare_any = true
    endif
  endfor
-%}
{%- if bz_compare_any -%}
<section class="bz bz-pages bz-compare">
  {%- if section.settings.heading != blank -%}<h2 class="bz-reveal">{{ section.settings.heading | escape }}</h2>{%- endif -%}
  {%- if section.settings.text != blank -%}<p class="bz-reveal">{{ section.settings.text | escape }}</p>{%- endif -%}
  <div class="bz-compare__grid">
    {%- for block in section.blocks -%}
      {%- if block.settings.collection != blank and block.settings.collection.products_count > 0 -%}
        {%- assign shot = block.settings.image | default: block.settings.collection.image | default: block.settings.collection.products.first.featured_image -%}
        <a class="bz-reveal" href="{{ block.settings.collection.url }}" {{ block.shopify_attributes }}>
          {%- if shot -%}{{ shot | image_url: width: 1000 | image_tag: alt: block.settings.title, loading: 'lazy', widths: '480, 800, 1000', sizes: '(min-width: 860px) 46vw, 92vw' }}{%- endif -%}
          <div class="bz-compare__copy">
            <h3>{{ block.settings.title | default: block.settings.collection.title | escape }}</h3>
            {%- if block.settings.text != blank -%}<p>{{ block.settings.text | escape }}</p>{%- endif -%}
            <span class="bz-picked__all">{{ block.settings.cta | default: 'Guarda i pezzi' | escape }}</span>
          </div>
        </a>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>
<script src="{{ 'bz-pages.js' | asset_url }}" defer></script>
{%- endif -%}
{% schema %}
{
  "name": "Confronto immagini",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titolo" },
    { "type": "textarea", "id": "text", "label": "Testo" }
  ],
  "blocks": [
    {
      "type": "side",
      "name": "Lato",
      "settings": [
        { "type": "text", "id": "title", "label": "Titolo" },
        { "type": "textarea", "id": "text", "label": "Testo" },
        { "type": "collection", "id": "collection", "label": "Collezione" },
        { "type": "image_picker", "id": "image", "label": "Foto" },
        { "type": "text", "id": "cta", "label": "Link", "default": "Guarda i pezzi" }
      ]
    }
  ],
  "max_blocks": 2,
  "presets": [{ "name": "Confronto immagini" }]
}
{% endschema %}
