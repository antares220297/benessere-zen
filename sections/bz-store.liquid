{{ 'bz-tokens.css' | asset_url | stylesheet_tag }}
{{ 'bz-home.css' | asset_url | stylesheet_tag }}
{{ 'bz-bottom.css' | asset_url | stylesheet_tag }}

{% render 'bz-wave', from: '#2a141b', to: '#ebe3d5' %}
<section class="bz bz-bottom bz-store">
  <div class="bz-store__grid">
    <div class="bz-visit">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1400 | image_tag: alt: section.settings.image_alt, widths: '700, 1400', sizes: '(min-width: 860px) 50vw, 100vw', loading: 'lazy', width: 900, height: 700 }}
      {%- else -%}
        <img src="{{ 'bz-store.jpg' | asset_url }}" alt="{{ section.settings.image_alt | escape }}" width="900" height="700">
      {%- endif -%}
      <div class="bz-visit__copy">
        <div>
          <h2>{{ section.settings.heading | escape }} <em>{{ section.settings.heading_accent | escape }}</em></h2>
          <p>{{ section.settings.text | escape }}</p>
        </div>
        <div>
          <div class="bz-journey">
            {%- for block in section.blocks -%}
              {%- if block.type == 'step' -%}
                <div {{ block.shopify_attributes }}>
                  <i aria-hidden="true">
                    {%- case block.settings.icon -%}
                      {%- when 'clock' -%}
                        <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8"/><path d="M12 8v5l3 2"/></svg>
                      {%- when 'shop' -%}
                        <svg viewBox="0 0 24 24"><path d="M4 10l2-5h12l2 5M5 10h14v9H5zM9 19v-5h6v5"/></svg>
                      {%- else -%}
                        <svg viewBox="0 0 24 24"><path d="M6 7h12l1 12H5L6 7zM9 7V6a3 3 0 016 0v1"/></svg>
                    {%- endcase -%}
                  </i>
                  <span><b>{{ block.settings.title | escape }}</b><span>{{ block.settings.text | escape }}</span></span>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
          {%- if section.settings.button_label != blank -%}
            <a class="bz-btn bz-btn--ivory" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }} <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
          {%- endif -%}
        </div>
      </div>
    </div>
    <div class="bz-faq">
      <h2>{{ section.settings.faq_heading | escape }} <em>{{ section.settings.faq_accent | escape }}</em></h2>
      {%- for block in section.blocks -%}
        {%- if block.type == 'faq' -%}
          <details {% if block.settings.open %}open{% endif %} {{ block.shopify_attributes }}>
            <summary>{{ block.settings.question | escape }}<i aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg></i></summary>
            <p>{{ block.settings.answer | escape }}</p>
          </details>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
  <div class="bz-trust">
    {%- for block in section.blocks -%}
      {%- if block.type == 'trust' -%}
        <span {{ block.shopify_attributes }}>
          {%- case block.settings.icon -%}
            {%- when 'truck' -%}
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h11v8H3zM14 10h4l3 3v2h-7zM7 18a2 2 0 100-4 2 2 0 000 4zM17 18a2 2 0 100-4 2 2 0 000 4z"/></svg>
            {%- when 'shop' -%}
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 10l2-5h12l2 5M5 10h14v9H5zM9 19v-5h6v5"/></svg>
            {%- when 'return' -%}
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12a8 8 0 101.5-4.6M4 5v5h5"/></svg>
            {%- when 'lock' -%}
              <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 018 0v3"/></svg>
            {%- else -%}
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l2 4 4 .6-3 3 .7 4.4L12 13l-3.7 2 0.7-4.4-3-3L10 7z"/></svg>
          {%- endcase -%}
          {{ block.settings.label | escape }}
        </span>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>
{% render 'bz-wave', from: '#ebe3d5', to: '#141312' %}

{% schema %}
{
  "name": "Negozio e domande",
  "class": "bz-home",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titolo", "default": "Anche" },
    { "type": "text", "id": "heading_accent", "label": "Titolo in corsivo", "default": "dal vivo" },
    { "type": "textarea", "id": "text", "label": "Testo", "default": "Ogni pezzo del sito è anche sui nostri scaffali. Le pietre dal vivo hanno un altro colore: passa a vederle, o ordina qui e ritira." },
    { "type": "image_picker", "id": "image", "label": "Foto" },
    { "type": "text", "id": "image_alt", "label": "Testo alternativo", "default": "Scatole in velluto nel negozio" },
    { "type": "text", "id": "address", "label": "Indirizzo", "default": "Via Provenzali 1, Cento (FE)" },
    { "type": "text", "id": "button_label", "label": "Pulsante", "default": "Orari e indicazioni" },
    { "type": "url", "id": "button_link", "label": "Link" },
    { "type": "text", "id": "faq_heading", "label": "Titolo domande", "default": "Domande" },
    { "type": "text", "id": "faq_accent", "label": "Corsivo domande", "default": "frequenti" }
  ],
  "blocks": [
    { "type": "step", "name": "Passo", "settings": [
      { "type": "text", "id": "title", "label": "Titolo" },
      { "type": "text", "id": "text", "label": "Testo" },
      { "type": "select", "id": "icon", "label": "Icona", "options": [
        { "value": "cart", "label": "Borsa" },
        { "value": "clock", "label": "Orologio" },
        { "value": "shop", "label": "Negozio" }
      ], "default": "cart" }
    ]},
    { "type": "faq", "name": "Domanda", "settings": [
      { "type": "text", "id": "question", "label": "Domanda" },
      { "type": "textarea", "id": "answer", "label": "Risposta" },
      { "type": "checkbox", "id": "open", "label": "Aperta", "default": false }
    ]},
    { "type": "trust", "name": "Garanzia", "settings": [
      { "type": "text", "id": "label", "label": "Testo" },
      { "type": "select", "id": "icon", "label": "Icona", "options": [
        { "value": "gem", "label": "Pietra" },
        { "value": "truck", "label": "Spedizione" },
        { "value": "shop", "label": "Negozio" },
        { "value": "return", "label": "Reso" },
        { "value": "lock", "label": "Lucchetto" }
      ], "default": "gem" }
    ]}
  ],
  "presets": [{ "name": "Negozio e domande" }]
}
{% endschema %}
