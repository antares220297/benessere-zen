<section class="nt-guide nt-noise" data-reveal>
  <div class="nt-page">
    {%- if section.settings.heading != blank -%}
      <h2>{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    <form data-nt-guide data-dest="{{ section.settings.destination | default: '/search?type=product' }}" action="{{ section.settings.destination | default: '/search' }}" method="get">
      <fieldset>
        <legend>{{ section.settings.q1 | escape }}</legend>
        <div class="nt-choices">
          {%- assign colors = section.settings.colors | split: ',' -%}
          {%- for color in colors -%}
            <label><input type="radio" name="color" value="{{ color | strip | escape }}"><span>{{ color | strip | escape }}</span></label>
          {%- endfor -%}
        </div>
      </fieldset>
      <fieldset>
        <legend>{{ section.settings.q2 | escape }}</legend>
        <div class="nt-choices">
          <label><input type="radio" name="who" value="per me"><span>{{ section.settings.for_me | escape }}</span></label>
          <label><input type="radio" name="who" value="regalo"><span>{{ section.settings.for_gift | escape }}</span></label>
        </div>
      </fieldset>
      <fieldset>
        <legend>{{ section.settings.q3 | escape }}</legend>
        <div class="nt-choices">
          {%- assign budgets = section.settings.budgets | split: ',' -%}
          {%- for budget in budgets -%}
            <label><input type="radio" name="budget" value="{{ budget | strip | escape }}"><span>{{ budget | strip | escape }}</span></label>
          {%- endfor -%}
        </div>
      </fieldset>
      <button class="button button-solid" type="submit">{{ section.settings.button | escape }}</button>
    </form>
  </div>
</section>

{% schema %}
{
  "name": "Tre domande",
  "tag": "section",
  "class": "nt-stone-guide",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titolo", "default": "Tre domande, un minuto." },
    { "type": "text", "id": "q1", "label": "Domanda 1", "default": "Che colore porti di più?" },
    { "type": "text", "id": "colors", "label": "Colori, separati da virgola", "default": "Nero, Viola, Rosa, Oro, Bianco" },
    { "type": "text", "id": "q2", "label": "Domanda 2", "default": "È per te o è un regalo?" },
    { "type": "text", "id": "for_me", "label": "Per me", "default": "Per me" },
    { "type": "text", "id": "for_gift", "label": "Regalo", "default": "Un regalo" },
    { "type": "text", "id": "q3", "label": "Domanda 3", "default": "Quanto vuoi spendere?" },
    { "type": "text", "id": "budgets", "label": "Fasce, separate da virgola", "default": "Sotto 20 €, Da 20 a 39 €, Da 40 a 60 €" },
    { "type": "text", "id": "button", "label": "Pulsante", "default": "Vedi i pezzi" },
    { "type": "url", "id": "destination", "label": "Pagina dei risultati" }
  ],
  "presets": [{ "name": "Tre domande" }]
}
{% endschema %}
