<div class="bz-stack">
  <section class="split hero">
    <div class="split-copy">
      <h1>Pietre e <em>rituali</em></h1>
      <p>{{ section.settings.intro | escape }}</p>
      <a class="btn gold" href="{{ section.settings.hero_link }}">{{ section.settings.hero_label | escape }}</a>
    </div>
    <div class="split-photo"><img src="{{ 'bz-negozio-pietre-e-rituali-copertina.jpg' | asset_url }}" alt="Vaschette di pietre burattate viste dall’alto" width="1400" height="900" fetchpriority="high"></div>
  </section>

  <section class="birthstones" data-birthstones aria-labelledby="birthstone-title">
    <div class="bz-sh">
      <h2 id="birthstone-title">La pietra del tuo <em>mese</em></h2>
      <div class="bz-pills" role="group" aria-label="Scegli il mese">
        {%- assign current = 'now' | date: '%m' | plus: 0 | minus: 1 | append: '' -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'month' -%}
            <button type="button" data-month="{{ block.settings.index }}" aria-pressed="{% if block.settings.index == current %}true{% else %}false{% endif %}" aria-label="{{ block.settings.name | escape }}">{{ block.settings.short | escape }}</button>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
    {%- for block in section.blocks -%}
      {%- if block.type == 'month' -%}
        <div class="month-panel" data-month-panel="{{ block.settings.index }}" {% unless block.settings.index == current %}hidden{% endunless %} {{ block.shopify_attributes }}>
          <div class="month-identity">
            {% render 'bz-month-stone', index: block.settings.index %}
            <div>
              <span class="month-name">{{ block.settings.name | escape }}</span>
              <h3>{{ block.settings.stone | escape }}</h3>
              <p>{{ block.settings.text | escape }}</p>
            </div>
          </div>
          {%- if block.settings.products.size > 0 -%}
            <div class="products">
              {%- for product in block.settings.products -%}
                {% render 'bz-product-card', card: product %}
              {%- endfor -%}
            </div>
            <button class="text-link" type="button" data-add-month>Aggiungi tutti →</button>
          {%- else -%}
            <p>Questa pietra non è disponibile online. <a href="{{ section.settings.hero_link }}">Chiedi in negozio →</a></p>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endfor -%}
    <p class="disclaimer">I significati appartengono alla tradizione e non sostituiscono il parere di un medico.</p>
  </section>

  <section>
    <div class="bz-sh"><h2>Parti da un’<em>intenzione</em></h2></div>
    <div class="intentions">
      {%- for block in section.blocks -%}
        {%- if block.type == 'intention' -%}
          {%- assign coll = block.settings.collection -%}
          <article class="intention" {{ block.shopify_attributes }}>
            {%- if block.settings.image_asset != blank -%}
              <img src="{{ block.settings.image_asset | asset_url }}" alt="{{ block.settings.word | escape }}" width="900" height="900" loading="lazy">
            {%- elsif coll.image -%}
              {{ coll.image | image_url: width: 800 | image_tag: alt: block.settings.word, loading: 'lazy', widths: '300, 500, 800', sizes: '(min-width: 1024px) 18vw, 80vw' }}
            {%- elsif coll.products.first.featured_image -%}
              {{ coll.products.first.featured_image | image_url: width: 800 | image_tag: alt: block.settings.word, loading: 'lazy', widths: '300, 500, 800', sizes: '(min-width: 1024px) 18vw, 80vw' }}
            {%- endif -%}
            <div>
              <h3>{{ block.settings.word | escape }}</h3>
              <p>{{ block.settings.line | escape }}</p>
              <a class="text-link" href="{{ coll.url }}">Scopri i pezzi →</a>
            </div>
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </section>

  <section class="compare" id="compare" data-compare aria-labelledby="compare-title">
    <div class="bz-sh">
      <h2 id="compare-title">Stessa pietra, tre <em>forme</em></h2>
      <p class="bz-sh-sub">La stessa pietra arriva grezza, burattata o da portare addosso. Cambia la forma, non il minerale.</p>
      {%- assign compare_seen = false -%}
      <div class="bz-pills" role="group" aria-label="Scegli la pietra da confrontare">
        {%- for block in section.blocks -%}
          {%- if block.type == 'compare' -%}
            <button type="button" data-compare-stone="{{ block.settings.name | handleize }}" aria-pressed="{% if compare_seen != true %}true{% else %}false{% endif %}" aria-controls="compare-products">{{ block.settings.name | escape }}</button>
            {%- assign compare_seen = true -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
    <p id="compare-status" class="sr-only" aria-live="polite"></p>
    {%- assign compare_index = 0 -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'compare' -%}
        <div class="compare-group" data-compare-group="{{ block.settings.name | handleize }}" {% unless compare_index == 0 %}hidden{% endunless %}>
        <div class="compare-grid">
          {%- assign forms = 'Grezza|Burattata|' | append: block.settings.wear_label | split: '|' -%}
          {%- for form in forms -%}
            {%- liquid
              if forloop.index == 1
                assign product = block.settings.rough
              elsif forloop.index == 2
                assign product = block.settings.tumbled
              else
                assign product = block.settings.worn
              endif
            -%}
            <div class="compare-column">
              <article class="compare-card">
                <a class="compare-link" href="{{ product.url }}">
                  <div class="compare-photo">
                    {%- if product.featured_image -%}{{ product.featured_image | image_url: width: 900 | image_tag: alt: product.title, loading: 'lazy', widths: '300, 600, 900', sizes: '(min-width: 900px) 30vw, 96px' }}{%- endif -%}
                  </div>
                </a>
                <div class="compare-body">
                  <span class="compare-form">{{ form | escape }}</span>
                  <h3><a class="compare-link" href="{{ product.url }}">{{ product.title | escape }}</a></h3>
                  <div class="compare-bottom">
                    <span class="compare-price">{% render 'bz-money', cents: product.price %}</span>
                    <button class="add" type="button" {% if product.available %}data-bz-add="{{ product.selected_or_first_available_variant.id }}"{% else %}disabled{% endif %} aria-label="Aggiungi {{ product.title | escape }} al carrello">+</button>
                  </div>
                </div>
              </article>
            </div>
          {%- endfor -%}
        </div>
        <p class="compare-description">La grezza resta com’è uscita. La burattata è levigata, da tasca. Il gioiello è la stessa pietra da portare.</p>
        <p class="compare-links"><a href="/collections/pietre-grezze">Vedi le pietre grezze →</a> <a href="/collections/pietre-burattate">Vedi le burattate →</a></p>
        </div>
        {%- assign compare_index = compare_index | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}
  </section>

  <section class="categories">
    <h2>Intorno al rito</h2>
    <div class="spheres">
      {%- for block in section.blocks -%}
        {%- if block.type == 'sphere' -%}
          {%- assign coll = block.settings.collection -%}
          <a href="{{ coll.url }}" {{ block.shopify_attributes }}>
            {%- if coll.products.first.featured_image -%}
              {{ coll.products.first.featured_image | image_url: width: 300 | image_tag: alt: block.settings.label, loading: 'lazy', width: 106, height: 106 }}
            {%- endif -%}
            <span>{{ block.settings.label | escape }}</span>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </section>

  <section class="picked">
    <div class="bz-sh">
      <h2>I più <em>scelti</em></h2>
      <div class="bz-pills" role="tablist" aria-label="Mala e pendoli">
        <button type="button" data-picked="0" aria-selected="true">Mala</button>
        <button type="button" data-picked="1" aria-selected="false">Pendoli</button>
      </div>
    </div>
    <div class="products five" data-picked-panel="0">
      {%- for product in section.settings.mala_products -%}{% render 'bz-product-card', card: product %}{%- endfor -%}
    </div>
    <div class="products five" data-picked-panel="1" hidden>
      {%- for product in section.settings.pendoli_products -%}{% render 'bz-product-card', card: product %}{%- endfor -%}
    </div>
  </section>
  <section class="split story flip">
    <div class="split-copy">
      <h2>In mano, a <em>Cento</em></h2>
      <p>Le trovi in Via Marcello Provenzali 1: le stesse del sito, da guardare da vicino.</p>
      <p>Al pagamento puoi scegliere il ritiro in negozio: è gratuito e di solito è pronto in 4 ore.</p>
      <p>{% render 'bz-hours', part: 'summary' %}</p>
      <div class="visit-actions">
        <a class="btn gold" href="{{ section.settings.visit_link }}">Orari e indicazioni →</a>
        {% render 'bz-open-badge', variant: 'compact', linked: true %}
      </div>
    </div>
    <div class="split-photo"><img src="{{ 'bz-negozio-pietre-in-mano-a-cento.jpg' | asset_url }}" alt="Pietre in mano a Cento" width="1400" height="1000" loading="lazy"></div>
  </section>
</div>
{% schema %}
{
  "name": "Pietre e rituali",
  "tag": "section",
  "settings": [
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Una pietra in tasca, un mala da 108 grani, un incenso, una candela accesa con un’intenzione." },
    { "type": "text", "id": "hero_label", "label": "Pulsante hero", "default": "Vieni in negozio →" },
    { "type": "url", "id": "hero_link", "label": "Link hero" },
    { "type": "url", "id": "visit_link", "label": "Link orari" },
    { "type": "product_list", "id": "mala_products", "label": "Mala", "limit": 5 },
    { "type": "product_list", "id": "pendoli_products", "label": "Pendoli", "limit": 5 }
  ],
  "blocks": [
    { "type": "month", "name": "Mese", "settings": [
      { "type": "text", "id": "index", "label": "Indice 0-11", "default": "0" },
      { "type": "text", "id": "short", "label": "Sigla", "default": "Gen" },
      { "type": "text", "id": "name", "label": "Mese", "default": "Gennaio" },
      { "type": "text", "id": "stone", "label": "Pietra", "default": "Granato" },
      { "type": "textarea", "id": "text", "label": "Testo" },
      { "type": "product_list", "id": "products", "label": "Prodotti", "limit": 3 }
    ] },
    { "type": "intention", "name": "Intenzione", "settings": [
      { "type": "text", "id": "word", "label": "Nome" },
      { "type": "textarea", "id": "line", "label": "Frase" },
      { "type": "collection", "id": "collection", "label": "Collezione" },
      { "type": "text", "id": "image_asset", "label": "Foto in assets" }
    ] },
    { "type": "compare", "name": "Confronto", "settings": [
      { "type": "text", "id": "name", "label": "Pietra" },
      { "type": "text", "id": "wear_label", "label": "Terza forma", "default": "Bracciale" },
      { "type": "product", "id": "rough", "label": "Grezza" },
      { "type": "product", "id": "tumbled", "label": "Burattata" },
      { "type": "product", "id": "worn", "label": "Da portare" }
    ] },
    { "type": "sphere", "name": "Sfera", "settings": [
      { "type": "text", "id": "label", "label": "Nome" },
      { "type": "collection", "id": "collection", "label": "Collezione" }
    ] }
  ],
  "max_blocks": 40,
  "presets": [{ "name": "Pietre e rituali" }]
}
{% endschema %}
