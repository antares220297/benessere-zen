{{ 'bz-tarocchi.css' | asset_url | stylesheet_tag }}
<script src="{{ 'bz-tarocchi.js' | asset_url }}" defer></script>

{%- liquid
  assign art_slugs = 'abbondanza,agitazione,amore,comunicazione,concentrazione,confusione,coraggio,gioia,insicurezza,intuizione,paura,protezione,purificazione,senso-di-blocco,serenita,tristezza' | split: ','
  assign fallback_url = section.settings.fallback_url | default: '/collections/all'
  assign senti_handle = section.settings.senti_all_handle | default: 'come-ti-senti' | strip
  assign desideri_handle = section.settings.desideri_all_handle | default: 'cosa-desideri' | strip
  assign senti_collection = collections[senti_handle]
  assign desideri_collection = collections[desideri_handle]
  assign senti_url = fallback_url
  assign desideri_url = fallback_url
  if senti_collection.url != blank
    assign senti_url = senti_collection.url
  endif
  if desideri_collection.url != blank
    assign desideri_url = desideri_collection.url
  endif
-%}
<section class="bz-tarocchi" data-bz-tarocchi aria-label="Le carte di Benessere Zen">
  <div class="tar-table">
    <div class="deck deck--senti" data-deck="senti" data-name="Come ti senti">
      <div class="deck__head">
        <h2 id="deck-senti-{{ section.id }}-t">Come ti <em>senti</em></h2>
        <p class="deck__intro">Scegli la carta che somiglia a oggi</p>
        <p>Ci sono giornate agitate, altre stanche o confuse. Sfoglia le sei carte e fermati su quella più vicina alla tua.</p>
        <p>Dietro ogni carta trovi le pietre che, nella tradizione, si tengono vicine in quei momenti, con incensi e candele per un piccolo rituale.</p>
        <a class="deck__more" href="{{ senti_url | escape }}">Vedi tutte le emozioni <span aria-hidden="true">→</span></a>
      </div>
      <div class="deck__body">
        <div class="deck__stage"><ul class="deck__fan" aria-describedby="deck-senti-{{ section.id }}-help"></ul>
        </div>
        <p class="sr-only" id="deck-senti-{{ section.id }}-help">Scegli una carta per vedere i prodotti: tocca per sceglierla, tocca di nuovo o «Apri la carta» per aprirla.</p>
        <div class="deck__actions">
          <a class="deck__open" href="{{ fallback_url | escape }}" tabindex="-1" aria-hidden="true">Apri la carta</a>
        </div>
      </div>
    </div>
    <div class="deck deck--des" data-deck="desideri" data-name="Cosa desideri">
      <div class="deck__head">
        <h2 id="deck-desideri-{{ section.id }}-t">Cosa <em>desideri</em></h2>
        <p class="deck__intro">Scegli la carta di ciò che vuoi coltivare</p>
        <p>Amore, protezione, un po' di fortuna, una casa da purificare: dieci carte, una per ogni intenzione. Gira quella che ti chiama.</p>
        <p>Dentro trovi le pietre che la tradizione lega a quel desiderio, con gli incensi, le candele e gli amuleti per dargli forma ogni giorno.</p>
        <a class="deck__more" href="{{ desideri_url | escape }}">Vedi tutte le intenzioni <span aria-hidden="true">→</span></a>
      </div>
      <div class="deck__body">
        <div class="deck__stage"><ul class="deck__fan" aria-describedby="deck-desideri-{{ section.id }}-help"></ul>
        </div>
        <p class="sr-only" id="deck-desideri-{{ section.id }}-help">Scegli una carta per vedere i prodotti: tocca per sceglierla, tocca di nuovo o «Apri la carta» per aprirla.</p>
        <div class="deck__actions">
          <a class="deck__open" href="{{ fallback_url | escape }}" tabindex="-1" aria-hidden="true">Apri la carta</a>
        </div>
      </div>
    </div>
  </div>
  <noscript>
    <p class="tar-credit">Le carte richiedono JavaScript.</p>
  </noscript>

{%- capture deck_data -%}
{
  "showMotti": false,
  "backs": {
    "senti": {{ 'bz-tarot-dorso-oro.webp' | asset_url | json }},
    "desideri": {{ 'bz-tarot-dorso-oro.webp' | asset_url | json }}
  },
  "cards": [
    {%- for block in section.blocks -%}
      {%- liquid
        assign slug = block.settings.slug | handleize
        assign art_slug = slug
        if slug == 'blocco'
          assign art_slug = 'senso-di-blocco'
        endif
        assign art_file = 'bz-tarot-' | append: art_slug | append: '.webp'
        assign handle = block.settings.collection_handle | strip
        if handle == blank
          assign prefix = 'senti-'
          if block.settings.deck == 'desideri'
            assign prefix = 'desiderio-'
          endif
          assign handle = slug | prepend: prefix
        endif
        assign card_collection = collections[handle]
        assign card_url = fallback_url
        if card_collection.url != blank
          assign card_url = card_collection.url
        endif
      -%}
      {
        "deck": {{ block.settings.deck | json }},
        "slug": {{ slug | json }},
        "title": {{ block.settings.title | json }},
        "stones": [{{ block.settings.stone_1 | json }}, {{ block.settings.stone_2 | json }}, {{ block.settings.stone_3 | json }}],
        "motto": {{ block.settings.motto | json }},
        "href": {{ card_url | json }},
        "art": {% if art_slugs contains art_slug %}{{ art_file | asset_url | json }}{% else %}null{% endif %}
      }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
{%- endcapture %}
<script type="application/json" data-deck-data>{{ deck_data | replace: '<', '\u003c' }}</script>
</section>

