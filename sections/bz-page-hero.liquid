{{ 'bz-tokens.css' | asset_url | stylesheet_tag }}
{{ 'bz-home.css' | asset_url | stylesheet_tag }}
{{ 'bz-pages.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign pages_v2 = false
  if template.suffix == 'cura-di-se' or template.suffix == 'cose-layurveda' or template.suffix == 'cos-e-ayurveda' or template.suffix == 'contact' or template.suffix == 'il-negozio'
    assign pages_v2 = true
  endif
  assign store_photo = false
  if template.suffix == 'contact' or template.suffix == 'il-negozio'
    assign store_photo = true
  endif
  assign shot = section.settings.image
  if shot == blank and section.settings.collection != blank
    assign shot = section.settings.collection.image | default: section.settings.collection.products.first.featured_image
  endif
  if shot == blank and section.settings.product != blank
    assign shot = section.settings.product.featured_image
  endif
  assign href = section.settings.button_link
  if href == blank and section.settings.collection != blank
    assign href = section.settings.collection.url
  endif
-%}
<header class="bz bz-pages bz-phero{% unless shot or store_photo %} is-plain{% endunless %}">
  {%- if store_photo and shot == blank -%}
    <img src="{{ 'bz-store.jpg' | asset_url }}" alt="Scatole in velluto nel negozio" class="bz-phero__photo" width="900" height="700" loading="eager">
    <span class="bz-phero__veil" aria-hidden="true"></span>
  {%- elsif shot -%}
    {{ shot | image_url: width: 1800 | image_tag: alt: section.settings.title, class: 'bz-phero__photo', widths: '700, 1200, 1800', sizes: '100vw', loading: 'eager' }}
    <span class="bz-phero__veil" aria-hidden="true"></span>
  {%- endif -%}
  <div class="bz-phero__copy bz-reveal">
    <h1>{%- if pages_v2 and section.settings.title_accent != blank and section.settings.title contains section.settings.title_accent -%}
      {%- assign title_parts = section.settings.title | split: section.settings.title_accent -%}
      {%- assign title_prefix = title_parts.first -%}
      {%- assign title_suffix = section.settings.title | remove_first: title_prefix | remove_first: section.settings.title_accent -%}
      {{- title_prefix | escape -}}<em>{{ section.settings.title_accent | escape }}</em>{{- title_suffix | escape -}}
    {%- else -%}{{ section.settings.title | escape }}{%- endif -%}</h1>
    {%- if section.settings.text != blank -%}<p>{{ section.settings.text | escape }}</p>{%- endif -%}
    {%- if section.settings.button_label != blank and href != blank -%}
      <a class="bz-btn bz-btn--gold" href="{{ href }}">{{ section.settings.button_label | escape }}{% if pages_v2 %} <span aria-hidden="true">→</span>{% endif %}</a>
    {%- endif -%}
  </div>
</header>
<script src="{{ 'bz-pages.js' | asset_url }}" defer></script>
{% schema %}
{
  "name": "Apertura con foto",
  "settings": [
    { "type": "text", "id": "title", "label": "Titolo" },
    { "type": "text", "id": "title_accent", "label": "Parola in corsivo oro" },
    { "type": "textarea", "id": "text", "label": "Testo" },
    { "type": "image_picker", "id": "image", "label": "Foto" },
    { "type": "collection", "id": "collection", "label": "Collezione per la foto" },
    { "type": "product", "id": "product", "label": "Prodotto per la foto" },
    { "type": "text", "id": "button_label", "label": "Pulsante" },
    { "type": "url", "id": "button_link", "label": "Link" }
  ],
  "presets": [{ "name": "Apertura con foto" }]
}
{% endschema %}
