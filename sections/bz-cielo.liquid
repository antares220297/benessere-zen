</div>
<div class="c2-alm"><h3><span data-k="data">14 febbraio</span>, <em data-k="segno">Acquario</em><span class="vv-glyph" data-s="Acquario" aria-hidden="true">♒︎</span></h3>
<dl class="c2-facts"><div><dt>Pietra del mese</dt><dd data-k="pietra">Ametista</dd></div><div><dt>Pietre del segno</dt><dd data-k="pietre">Ametista e granato</dd></div><div><dt>Elemento</dt><dd><span class="g" data-k="elg">🜁︎</span><span data-k="el">Aria</span></dd></div></dl>
<p class="c2-note" data-k="note">Si dice che l’Acquario sia l’aria che guarda lontano. Per lui, la lavanda con una nota di palo santo.</p>
<p class="bz-vh bz-live" aria-live="polite"></p>
</div>
<div class="c3-cart">
<h3 data-k="tit">Il tuo <em>corredo</em></h3><span class="c3-per" data-k="per">per il 14 febbraio</span><span class="c3-rule" aria-hidden="true"></span>
<div class="c2-rows" role="group" aria-label="Pezzi del corredo">
  {% for i in (1..3) %}
    <div class="c2-row c3-med">
      <span class="c3-ringw">
        <label class="c3-ring" for="cielo-pick-{{ section.id }}-{{ i }}"><img alt="" width="480" height="480" loading="lazy" decoding="async" hidden></label>
        <span class="c3-choice" hidden>
          <input id="cielo-pick-{{ section.id }}-{{ i }}" class="bz-vh c3-pick" type="checkbox" disabled>
          <label class="c3-check" for="cielo-pick-{{ section.id }}-{{ i }}"><svg viewBox="0 -960 960 960" aria-hidden="true" focusable="false" fill="currentColor"><path d="M382-253.85 168.62-467.23 211.38-510 382-339.38 748.62-706l42.76 42.77L382-253.85Z"></path></svg></label>
        </span>
        <button type="button" class="c3-add" hidden>+</button>
      </span>
      <span class="c2-sub"></span>
      <span class="c2-name"><a hidden></a><span></span></span>
      <span class="c2-price">Esaurito</span>
    </div>
  {% endfor %}
</div>
<div class="c3-fold c3-gift" inert aria-hidden="true"><div><div class="c3-in"><span class="c3-line" aria-hidden="true"></span>
<label class="c2-check"><input type="checkbox"><span class="c2-box"><svg viewBox="0 -960 960 960" aria-hidden="true" focusable="false" fill="currentColor"><path d="M382-253.85 168.62-467.23 211.38-510 382-339.38 748.62-706l42.76 42.77L382-253.85Z"></path></svg></span>Aggiungi un biglietto con il tuo messaggio</label>
<div class="c3-fold c3-msgw" inert><div><div class="c3-in"><textarea class="c2-msg" rows="3" placeholder="Scrivi qui il messaggio per il biglietto" aria-label="Messaggio del biglietto" maxlength="250"></textarea></div></div></div>
</div></div></div>
<div class="c2-total"><span class="c3-deal" hidden>−10% se li prendi tutti e tre</span><button type="button" class="c3-deal is-hint c3-hint" hidden>Aggiungi il terzo: −10% su tutto</button><div class="c3-sumline"><small class="c2-count"></small><s class="c3-was" hidden></s><span class="c2-sum"></span></div>
<button type="button" class="c2-cta" disabled><svg aria-hidden="true" focusable="false" class="ci" fill="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960"><path d="M450-610v-120H330v-60h120v-120h60v120h120v60H510v120h-60ZM286.15-97.69q-29.15 0-49.57-20.43-20.42-20.42-20.42-49.57 0-29.16 20.42-49.58 20.42-20.42 49.57-20.42 29.16 0 49.58 20.42 20.42 20.42 20.42 49.58 0 29.15-20.42 49.57-20.42 20.43-49.58 20.43Zm387.7 0q-29.16 0-49.58-20.43-20.42-20.42-20.42-49.57 0-29.16 20.42-49.58 20.42-20.42 49.58-20.42 29.15 0 49.57 20.42t20.42 49.58q0 29.15-20.42 49.57Q703-97.69 673.85-97.69ZM60-810v-60h114.46l166.92 352.31h272.7q3.46 0 6.15-1.73 2.69-1.73 4.62-4.81L772.77-790h68.3L677.38-494.31q-9.84 17.31-26.05 26.96-16.21 9.66-35.48 9.66H324l-46.31 84.61q-3.08 4.62-.19 10 2.88 5.39 8.65 5.39h457.69v60H286.15q-40 0-60.42-34.2-20.42-34.19-1.11-69.19l57.07-102.61L136.16-810H60Z"/></svg><span class="c3-lbl">Aggiungi il corredo al carrello</span></button><p class="bz-vh c3-status" aria-live="polite"></p>
<p class="c3-cart-error" role="alert" hidden></p>
<a class="c2-again" href="#cielo"><svg aria-hidden="true" focusable="false" class="ci" fill="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960"><path d="M450-180v-485.08L222.15-437.23 180-480l300-300 300 300-42.15 42.77L510-665.08V-180h-60Z"/></svg>Cambia data</a></div>
</div>
</div>
{% capture cielo_catalog %}
{
  "months": {
    {% assign months = section.blocks | where: 'type', 'month' %}
    {% for block in months %}
      {{ block.settings.month | json }}: {
        "s": {{ block.settings.stone | json }},
        "note": {{ block.settings.note | json }},
        "early": {{ block.settings.early | json }},
        "late": {{ block.settings.late | json }},
        "st": {% render 'bz-cielo-piece', product: block.settings.st, short_name: block.settings.st_name %},
        "j": {% render 'bz-cielo-piece', product: block.settings.j, short_name: block.settings.j_name %}
      }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  },
  "elements": {
    {% assign elements = section.blocks | where: 'type', 'element' %}
    {% for block in elements %}
      {{ block.settings.element | json }}: {% render 'bz-cielo-piece', product: block.settings.product, short_name: block.settings.short_name %}{% unless forloop.last %},{% endunless %}
    {% endfor %}
  },
  "signs": {{ section.settings.signs | json }},
  "currency": {{ cart.currency.iso_code | default: shop.currency | json }},
  "figures": {
    "Capricorno": {{ 'cielo-segno-capricorno.webp' | asset_url | json }},
    "Acquario": {{ 'cielo-segno-acquario.webp' | asset_url | json }},
    "Pesci": {{ 'cielo-segno-pesci.webp' | asset_url | json }},
    "Ariete": {{ 'cielo-segno-ariete.webp' | asset_url | json }},
    "Toro": {{ 'cielo-segno-toro.webp' | asset_url | json }},
    "Gemelli": {{ 'cielo-segno-gemelli.webp' | asset_url | json }},
    "Cancro": {{ 'cielo-segno-cancro.webp' | asset_url | json }},
    "Leone": {{ 'cielo-segno-leone.webp' | asset_url | json }},
    "Vergine": {{ 'cielo-segno-vergine.webp' | asset_url | json }},
    "Bilancia": {{ 'cielo-segno-bilancia.webp' | asset_url | json }},
    "Scorpione": {{ 'cielo-segno-scorpione.webp' | asset_url | json }},
