{{ 'bz-tokens.css' | asset_url | stylesheet_tag }}
{{ 'bz-home.css' | asset_url | stylesheet_tag }}

<div class="bz bz-home bz-picked" data-bz-picked>
  <div class="bz-picked__head">
    <h2>{{ section.settings.heading | escape }} <em>{{ section.settings.heading_accent | escape }}</em></h2>
    <div class="bz-picked__tools">
      <div class="bz-pills" data-bz-seg role="tablist">
        {%- assign picked_first_tab = true -%}
        {%- for block in section.blocks -%}
          {%- if block.settings.collection != blank and block.settings.collection.products_count > 0 -%}
            <button type="button" role="tab" class="{% if picked_first_tab %}is-on{% endif %}" data-bz-pane="{{ forloop.index }}" aria-selected="{% if picked_first_tab %}true{% else %}false{% endif %}" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</button>
            {%- assign picked_first_tab = false -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
      {%- if section.settings.link_label != blank -%}
        <a class="bz-picked__all" href="{{ section.settings.link }}">{{ section.settings.link_label | escape }} <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
      {%- endif -%}
    </div>
  </div>
  {%- assign picked_first_pane = true -%}
  {%- for block in section.blocks -%}
    {%- if block.settings.collection != blank and block.settings.collection.products_count > 0 -%}
      {%- liquid
        assign picked_products = block.settings.collection.products
        case block.settings.sort_by
          when 'created-descending'
            assign picked_products = picked_products | sort: 'created_at' | reverse
          when 'created-ascending'
            assign picked_products = picked_products | sort: 'created_at'
          when 'price-ascending'
            assign picked_products = picked_products | sort: 'price'
          when 'price-descending'
            assign picked_products = picked_products | sort: 'price' | reverse
        endcase
      -%}
      <div class="bz-grid" data-bz-pane="{{ forloop.index }}"{% unless picked_first_pane %} hidden{% endunless %}>
        {%- for product in picked_products limit: section.settings.limit -%}
          {% render 'bz-card', product: product, eager: forloop.first %}
        {%- endfor -%}
      </div>
      {%- assign picked_first_pane = false -%}
    {%- endif -%}
  {%- endfor -%}
</div>
<script src="{{ 'bz-home.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "I più scelti",
  "class": "bz-home",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titolo", "default": "I più" },
    { "type": "text", "id": "heading_accent", "label": "Titolo in corsivo", "default": "scelti" },
    { "type": "text", "id": "link_label", "label": "Link", "default": "Vedi tutti" },
    { "type": "url", "id": "link", "label": "Destinazione del link" },
    { "type": "range", "id": "limit", "min": 2, "max": 8, "step": 1, "label": "Prodotti per lista", "default": 5 }
  ],
  "blocks": [
    {
      "type": "list",
      "name": "Lista",
      "settings": [
        { "type": "text", "id": "label", "label": "Nome", "default": "Più scelti" },
        { "type": "collection", "id": "collection", "label": "Collezione" },
        {
          "type": "select",
          "id": "sort_by",
          "label": "Ordinamento",
          "default": "best-selling",
          "options": [
            { "value": "best-selling", "label": "Più venduti" },
            { "value": "created-descending", "label": "Più recenti" },
            { "value": "created-ascending", "label": "Meno recenti" },
            { "value": "price-ascending", "label": "Prezzo crescente" },
            { "value": "price-descending", "label": "Prezzo decrescente" }
          ]
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [{ "name": "I più scelti" }]
}
{% endschema %}