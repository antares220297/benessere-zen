{%- liquid
  assign bz_marquee_limit = section.settings.limit | default: 10
  assign bz_marquee_has = false
  if section.settings.collection != blank
    for bz_product in section.settings.collection.products
      if bz_product.featured_image != blank
        assign bz_marquee_has = true
        break
      endif
    endfor
  endif
  unless bz_marquee_has
    for block in section.blocks
      if block.type == 'photo' and block.settings.image != blank
        assign bz_marquee_has = true
        break
      endif
    endfor
  endunless
-%}
{%- if bz_marquee_has -%}
{{ 'bz-tokens.css' | asset_url | stylesheet_tag }}
{{ 'bz-home.css' | asset_url | stylesheet_tag }}
{{ 'bz-v410-palmora-gallery.css' | asset_url | stylesheet_tag }}
<section class="bz bz-v410-marquee" aria-label="{{ section.settings.heading | escape }} {{ section.settings.heading_accent | escape }}">
  <div class="bz-v410-marquee__bleed">
    <div class="bz-v410-marquee__curve">
      <div class="bz-v410-marquee__track">
        {%- for bz_pass in (1..2) -%}
          <ul class="bz-v410-marquee__set"{% if bz_pass == 2 %} aria-hidden="true" inert{% endif %}>
            {%- assign bz_shown = 0 -%}
            {%- if section.settings.collection != blank -%}
              {%- for product in section.settings.collection.products -%}
                {%- if bz_shown < bz_marquee_limit and product.featured_image != blank -%}
                  {%- assign bz_alt = product.featured_image.alt | default: product.title -%}
                  <li class="bz-v410-marquee__item">
                    <a href="{{ product.url }}">
                      {{ product.featured_image | image_url: width: 720 | image_tag: alt: bz_alt, class: 'bz-v410-marquee__img', widths: '240, 360, 540, 720', sizes: '(min-width: 750px) 224px, 176px', loading: 'lazy' }}
                    </a>
                  </li>
                  {%- assign bz_shown = bz_shown | plus: 1 -%}
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'photo' and bz_shown < bz_marquee_limit and block.settings.image != blank -%}
                {%- assign bz_alt = block.settings.alt | default: block.settings.image.alt -%}
                <li class="bz-v410-marquee__item"{% if bz_pass == 1 %} {{ block.shopify_attributes }}{% endif %}>
                  {%- if block.settings.url != blank -%}
                    <a href="{{ block.settings.url }}">
                  {%- endif -%}
                  {{ block.settings.image | image_url: width: 720 | image_tag: alt: bz_alt, class: 'bz-v410-marquee__img', widths: '240, 360, 540, 720', sizes: '(min-width: 750px) 224px, 176px', loading: 'lazy' }}
                  {%- if block.settings.caption != blank -%}
                    <span class="bz-v410-marquee__cap">{{ block.settings.caption | escape }}</span>
                  {%- endif -%}
                  {%- if block.settings.url != blank -%}
                    </a>
                  {%- endif -%}
                </li>
                {%- assign bz_shown = bz_shown | plus: 1 -%}
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endfor -%}
      </div>
    </div>
  </div>
  <div class="bz-v410-marquee__copy bz-reveal">
    {%- if section.settings.heading != blank or section.settings.heading_accent != blank -%}
      <h2>{{ section.settings.heading | escape }}{%- if section.settings.heading_accent != blank %} <em>{{ section.settings.heading_accent | escape }}</em>{%- endif -%}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <p>{{ section.settings.text | escape | newline_to_br }}</p>
    {%- endif -%}
    {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
      <a class="bz-btn bz-btn--gold" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }}</a>
    {%- endif -%}
  </div>
</section>
<script src="{{ 'bz-pages.js' | asset_url }}" defer></script>
<script src="{{ 'bz-v410-palmora-gallery.js' | asset_url }}" defer></script>
{%- endif -%}

{% schema %}
{
  "name": "Striscia fotografica",
  "class": "bz-home",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titolo",
      "default": "I pezzi"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Titolo in corsivo",
      "default": "come sono"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Testo",
      "default": "Foto dei prodotti. Il pezzo unico in foto è quello che parte o che ritiri in negozio."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Etichetta del pulsante",
      "default": "Vedi le pietre"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Link del pulsante"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collezione",
      "info": "Solo la foto principale di ogni prodotto. I pezzi senza foto si saltano. Non usiamo la foto della collezione."
    },
    {
      "type": "range",
      "id": "limit",
      "min": 6,
      "max": 18,
      "step": 1,
      "label": "Numero di foto",
      "info": "Prima le foto dei prodotti della collezione, poi le foto dei blocchi.",
      "default": 10
    }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Foto prodotto",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Foto del prodotto",
          "info": "Una foto del pezzo, non del negozio."
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Testo alternativo"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Didascalia"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 18,
  "enabled_on": {
    "templates": ["index", "page"]
  },
  "presets": [
    {
      "name": "Striscia fotografica"
    }
  ]
}
{% endschema %}
