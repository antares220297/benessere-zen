{{ 'bz-tokens.css' | asset_url | stylesheet_tag }}
{{ 'bz-home.css' | asset_url | stylesheet_tag }}
{{ 'bz-pages.css' | asset_url | stylesheet_tag }}
{{ 'bz-v410-glowence-process.css' | asset_url | stylesheet_tag }}

<section class="bz bz-v410-process" data-bz-process aria-labelledby="BzProcessTitle-{{ section.id }}">
  {%- if section.settings.heading != blank or section.settings.heading_accent != blank -%}
    <h2 class="bz-reveal" id="BzProcessTitle-{{ section.id }}">
      {{ section.settings.heading | escape }}
      {%- if section.settings.heading_accent != blank %} <em>{{ section.settings.heading_accent | escape }}</em>{%- endif -%}
    </h2>
  {%- endif -%}
  {%- if section.settings.intro != blank -%}
    <p class="bz-v410-process__intro">{{ section.settings.intro | escape }}</p>
  {%- endif -%}

  <div class="bz-v410-process__layout">
    <div class="bz-v410-process__visual">
      {%- for block in section.blocks -%}
        {%- if block.type == 'step' -%}
          {%- liquid
            assign shot_alt = block.settings.image_alt
            if shot_alt == blank
              assign shot_alt = block.settings.title
            endif
          -%}
          <figure class="bz-v410-process__shot" data-bz-shot="{{ block.id }}" {% unless forloop.first %}hidden{% endunless %}>
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: shot_alt, widths: '480, 800, 1200', sizes: '(min-width: 800px) 38vw, 100vw' }}
            {%- else -%}
              <div class="bz-v410-process__quiet">
                <p>{{ block.settings.title | escape }}</p>
              </div>
            {%- endif -%}
          </figure>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="bz-v410-process__steps">
      {%- for block in section.blocks -%}
        {%- if block.type == 'step' -%}
          <div class="bz-v410-process__step" {{ block.shopify_attributes }}>
            <h3>
              <button type="button" data-bz-shot-id="{{ block.id }}" aria-expanded="{% if forloop.first %}true{% else %}false{% endif %}" aria-controls="BzProcessPanel-{{ section.id }}-{{ block.id }}" id="BzProcessBtn-{{ section.id }}-{{ block.id }}">
                <span>{{ block.settings.title | escape }}</span>
                <i class="bz-v410-process__mark" aria-hidden="true"></i>
              </button>
            </h3>
            <div class="bz-v410-process__panel" id="BzProcessPanel-{{ section.id }}-{{ block.id }}" {% unless forloop.first %}hidden{% endunless %}>
              {%- if block.settings.text != blank -%}
                <p>{{ block.settings.text | escape }}</p>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<script src="{{ 'bz-pages.js' | asset_url }}" defer></script>
<script src="{{ 'bz-v410-glowence-process.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Come avviene una visita",
  "class": "bz-home",
  "enabled_on": { "templates": ["page"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Titolo", "default": "In bottega" },
    { "type": "text", "id": "heading_accent", "label": "Titolo in corsivo", "default": "come va" },
    { "type": "textarea", "id": "intro", "label": "Introduzione", "default": "Tre gesti, senza appuntamento." }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Gesto",
      "settings": [
        { "type": "text", "id": "title", "label": "Titolo" },
        { "type": "textarea", "id": "text", "label": "Testo" },
        { "type": "image_picker", "id": "image", "label": "Immagine" },
        { "type": "text", "id": "image_alt", "label": "Testo alternativo" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Come avviene una visita",
      "settings": {
        "heading": "In bottega",
        "heading_accent": "come va",
        "intro": "Tre gesti, senza appuntamento."
      },
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "Entri e guardi",
            "text": "I pezzi sono in vetrina e sul banco, in Via Marcello Provenzali 1 a Cento. Se è un pezzo unico, quello in foto è quello che porti a casa."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Chiedi al banco",
            "text": "Si può chiedere un consiglio su dosha e chakra, a partire da quello che usi già. È un consiglio, non una visita medica."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Lo porti via",
            "text": "Lo prendi subito, oppure lo ordini qui e passi a ritirarlo. Orari: lunedì, martedì, mercoledì, venerdì e sabato 9:30–12:30 e 16:00–19:30. Giovedì 9:00–13:00."
          }
        }
      ]
    }
  ]
}
{% endschema %}
