{{ 'bz-tokens.css' | asset_url | stylesheet_tag }}
{{ 'bz-home.css' | asset_url | stylesheet_tag }}
{{ 'bz-mid.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign lead = section.settings.collection
  assign lead_image = section.settings.image
  if lead_image == blank and lead != blank
    if lead.image != blank
      assign lead_image = lead.image
    elsif lead.products.first.featured_image != blank
      assign lead_image = lead.products.first.featured_image
    endif
  endif
  assign featured = section.settings.featured_product
  assign ship_euros = settings.bz_free_shipping_threshold | default: section.settings.shipping_amount | default: 50 | plus: 0
  assign tile_count = 0
  if section.settings.stat_value != blank
    assign tile_count = tile_count | plus: 1
  endif
  if featured != blank
    assign tile_count = tile_count | plus: 1
  endif
  assign tile_count = tile_count | plus: 1
  if ship_euros > 0
    assign tile_count = tile_count | plus: 1
  endif
  for block in section.blocks
    if block.type == 'visit'
      if block.settings.title != blank or block.settings.text != blank
        assign tile_count = tile_count | plus: 1
      endif
    endif
  endfor
  assign tile_odd = tile_count | modulo: 2
  assign side = section.settings.side_collection
  assign side_image = section.settings.side_image
  if side_image == blank and side != blank
    if side.image != blank
      assign side_image = side.image
    elsif side.products.first.featured_image != blank
      assign side_image = side.products.first.featured_image
    endif
  endif
-%}

<div class="bz bz-mid bz-promo">
  <div class="bz-bento{% if tile_count == 4 %} is-four{% endif %}{% if tile_odd == 1 %} is-odd{% endif %}">
    <div class="bz-bento__lead">
      {%- if lead_image != blank -%}
        {{ lead_image | image_url: width: 1400 | image_tag: alt: section.settings.image_alt, class: 'bz-bento__photo', widths: '600, 900, 1400', sizes: '(min-width: 860px) 40vw, 100vw', loading: 'lazy', width: 900, height: 700 }}
      {%- endif -%}
      <div class="bz-bento__copy">
        <h2>{{ section.settings.heading | escape }} <em>{{ section.settings.heading_accent | escape }}</em></h2>
        {%- if section.settings.text != blank -%}
          <p>{{ section.settings.text | escape }}</p>
        {%- endif -%}
        {%- if lead != blank -%}
          <div class="bz-mchips">
            {%- for product in lead.products limit: 3 -%}
              <a href="{{ product.url }}">
                {%- if product.featured_image != blank -%}
                  {{ product.featured_image | image_url: width: 80 | image_tag: alt: '', width: 32, height: 32, loading: 'lazy' }}
                {%- endif -%}
                {%- assign chip_name = product.title -%}
                <span>{{ chip_name | escape }}</span>
                <b>{% render 'bz-money', cents: product.price %}</b>
              </a>
            {%- endfor -%}
          </div>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <a class="bz-btn bz-btn--gold" href="{{ section.settings.button_link | default: lead.url }}">{{ section.settings.button_label | escape }} <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
        {%- endif -%}
      </div>
    </div>

    {%- if section.settings.stat_value != blank -%}
      <div class="bz-bento__stat">
        <p class="bz-figure bz-figure--gold">{{ section.settings.stat_value | escape }}{%- if section.settings.stat_unit != blank -%}<small> {{ section.settings.stat_unit | escape }}</small>{%- endif -%}</p>
        <div>
          {%- if section.settings.stat_text != blank -%}<p>{{ section.settings.stat_text | escape }}</p>{%- endif -%}
          {%- if section.settings.stat_link_label != blank and section.settings.stat_link != blank -%}
            <a class="bz-picked__all bz-bento__more" href="{{ section.settings.stat_link }}">{{ section.settings.stat_link_label | escape }} <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    {%- if featured != blank -%}
      {%- assign feat_variant = featured.selected_or_first_available_variant -%}
      {%- assign feat_cents = featured.price | modulo: 100 -%}
      <div class="bz-bento__product">
        <a href="{{ featured.url }}">
          {%- if featured.featured_image != blank -%}
            {{ featured.featured_image | image_url: width: 800 | image_tag: alt: featured.title, widths: '400, 800', sizes: '25vw', loading: 'lazy', width: 480, height: 360 }}
          {%- endif -%}
          {%- if feat_variant.inventory_management != blank and feat_variant.inventory_quantity == 1 and featured.available -%}
            <span class="bz-badge bz-stock--low">Ultimo pezzo</span>
          {%- endif -%}
          <span class="bz-bento__caption">
            <b>{{ featured.title | escape }}</b>
            <span class="bz-price">{% render 'bz-money', cents: featured.price %}</span>
          </span>
        </a>
        {%- if featured.available -%}
          <form class="bz-card__form bz-bento__add" action="{{ routes.cart_add_url }}" method="post">
            <input type="hidden" name="id" value="{{ feat_variant.id }}">
            <button class="bz-card__add" type="submit" aria-label="Aggiungi {{ featured.title | escape }}">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
            </button>
          </form>
        {%- endif -%}
      </div>
    {%- endif -%}

    <a class="bz-bento__link" href="{{ section.settings.side_link | default: side.url }}">
      {%- if side_image != blank -%}
        {{ side_image | image_url: width: 900 | image_tag: alt: '', widths: '400, 800', sizes: '25vw', loading: 'lazy', width: 480, height: 360 }}
      {%- else -%}
        <img src="{{ 'bz-pendoli.jpg' | asset_url }}" alt="" width="480" height="360" loading="lazy">
      {%- endif -%}
      <div class="bz-bento__caption">
        <h3>{{ section.settings.side_title | escape }} <em>{{ section.settings.side_accent | escape }}</em></h3>
        <span class="bz-picked__all">{{ section.settings.side_label | escape }} <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
      </div>
    </a>

    {%- if ship_euros > 0 -%}
      <div class="bz-bento__stat bz-bento__stat--gold">
        <p class="bz-figure">{{ ship_euros }}<small>€</small></p>
        <p>{{ section.settings.shipping_text | escape }}</p>
      </div>
    {%- endif -%}

    {%- for block in section.blocks -%}
      {%- if block.type == 'visit' -%}
      {%- if block.settings.title != blank or block.settings.text != blank -%}
        {%- liquid
          assign visit_href = block.settings.link
          if visit_href == blank
            assign visit_page = pages['il-negozio']
            if visit_page != blank
              assign visit_href = visit_page.url
            else
              assign visit_href = 'https://maps.google.com/?q=Via+Marcello+Provenzali+1,+44042+Cento+FE'
            endif
          endif
          assign visit_label = block.settings.label | default: 'Vieni in negozio'
        -%}
        <a class="bz-bento__visit" href="{{ visit_href }}" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 900 | image_tag: alt: block.settings.title, loading: 'lazy', widths: '400, 800', sizes: '(min-width: 860px) 25vw, 50vw', width: 480, height: 360 }}
          {%- endif -%}
          {%- if block.settings.title != blank -%}<strong>{{ block.settings.title | escape }}</strong>{%- endif -%}
          {%- if block.settings.text != blank -%}<em>{{ block.settings.text | escape }}</em>{%- endif -%}
          <span class="bz-intent__cta">{{ visit_label | escape }} <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
        </a>
      {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Bento promo",
  "class": "bz-home",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titolo", "default": "108 grani," },
    { "type": "text", "id": "heading_accent", "label": "Titolo in corsivo", "default": "uno alla volta" },
    { "type": "textarea", "id": "text", "label": "Testo", "default": "Il mala nasce per contare i mantra: 108 grani da far scorrere tra le dita, fino alla nappa. Oggi si porta anche al collo o avvolto al polso." },
    { "type": "image_picker", "id": "image", "label": "Foto" },
    { "type": "text", "id": "image_alt", "label": "Testo alternativo", "default": "Mala in cristallo di rocca" },
    { "type": "collection", "id": "collection", "label": "Collezione dei mala" },
    { "type": "text", "id": "button_label", "label": "Pulsante", "default": "Vedi i mala" },
    { "type": "url", "id": "button_link", "label": "Link del pulsante" },
    { "type": "text", "id": "stat_value", "label": "Numero", "info": "Lascia vuoto per nascondere. Conferma il tempo di ritiro prima di pubblicare." },
    { "type": "text", "id": "stat_unit", "label": "Unità" },
    { "type": "textarea", "id": "stat_text", "label": "Testo del numero" },
    { "type": "text", "id": "stat_link_label", "label": "Link del numero" },
    { "type": "url", "id": "stat_link", "label": "Destinazione" },
    { "type": "product", "id": "featured_product", "label": "Prodotto in evidenza" },
    { "type": "text", "id": "side_title", "label": "Titolo laterale", "default": "Pendoli" },
    { "type": "text", "id": "side_accent", "label": "Corsivo laterale", "default": "e divinazione" },
    { "type": "text", "id": "side_label", "label": "Link laterale", "default": "Pendoli e teli" },
    { "type": "collection", "id": "side_collection", "label": "Collezione laterale" },
    { "type": "image_picker", "id": "side_image", "label": "Foto laterale" },
    { "type": "url", "id": "side_link", "label": "Link laterale" },
    { "type": "number", "id": "shipping_amount", "label": "Soglia in evidenza", "default": 50 },
    { "type": "text", "id": "shipping_text", "label": "Testo della soglia", "default": "Da qui la spedizione è gratuita, in tutta Italia." }
  ],
  "blocks": [
    {
      "type": "visit",
      "name": "In negozio",
      "settings": [
        { "type": "text", "id": "title", "label": "Titolo", "default": "Anche in negozio, a Cento (FE)" },
        { "type": "textarea", "id": "text", "label": "Testo", "default": "Gli stessi pezzi, da vedere di persona." },
        { "type": "text", "id": "label", "label": "Testo del link", "default": "Il negozio" },
        { "type": "url", "id": "link", "label": "Link", "info": "Se è vuoto, porta alla pagina del negozio." },
        { "type": "image_picker", "id": "image", "label": "Foto" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Bento promo",
      "blocks": [
        {
          "type": "visit",
          "settings": {
            "title": "Anche in negozio, a Cento (FE)",
            "text": "Gli stessi pezzi, da vedere di persona.",
            "label": "Il negozio"
          }
        }
      ]
    }
  ]
}
{% endschema %}
