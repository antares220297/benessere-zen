{%- liquid
  assign bz_piece = section.settings.product
  if bz_piece == blank and section.settings.collection != blank
    for bz_candidate in section.settings.collection.products limit: 1
      assign bz_piece = bz_candidate
    endfor
  endif
  if bz_piece == blank and collection != blank
    for bz_candidate in collection.products limit: 1
      assign bz_piece = bz_candidate
    endfor
  endif
-%}
{%- if bz_piece != blank -%}
{{ 'bz-tokens.css' | asset_url | stylesheet_tag }}
{{ 'bz-home.css' | asset_url | stylesheet_tag }}
{{ 'bz-v410-fance-exclusive.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign bz_shot = section.settings.image
  if bz_shot == blank
    assign bz_shot = bz_piece.featured_image
  endif
  assign bz_alt = section.settings.image_alt | strip
  if bz_alt == blank
    if bz_piece.featured_image != blank and bz_piece.featured_image.alt != blank
      assign bz_alt = bz_piece.featured_image.alt
    else
      assign bz_alt = bz_piece.title
    endif
  endif
  assign bz_href = section.settings.button_link
  if bz_href == blank
    assign bz_href = bz_piece.url
  endif
  assign bz_label = section.settings.button_label | strip
  if bz_label == blank
    assign bz_label = 'Vedi il pezzo'
  endif
  assign bz_variant = bz_piece.selected_or_first_available_variant
-%}
<section class="bz bz-v410-exclusive">
  {%- if section.settings.show_collection_title and collection != blank -%}
    <h1 class="bz-v410-exclusive__collection">{{ collection.title | escape }}</h1>
  {%- endif -%}
  <div class="bz-v410-exclusive__inner">
    {%- if bz_shot != blank -%}
      <div class="bz-v410-exclusive__frame">
        {{ bz_shot | image_url: width: 1600 | image_tag: alt: bz_alt, class: 'bz-v410-exclusive__img', widths: '480, 800, 1200, 1600', sizes: '(min-width: 928px) 880px, calc(100vw - 48px)', loading: 'lazy', width: bz_shot.width, height: bz_shot.height }}
      </div>
    {%- endif -%}
    <div class="bz-reveal bz-v410-exclusive__row">
      <div class="bz-v410-exclusive__top">
        <h2>{{ bz_piece.title | escape }}</h2>
        <div class="bz-v410-exclusive__offer">
          <p class="bz-v410-exclusive__price">
            {%- if bz_piece.compare_at_price > bz_piece.price -%}
              <s class="bz-v410-exclusive__compare">{% render 'bz-money', cents: bz_piece.compare_at_price %}</s>
            {%- endif -%}
            <span>{% render 'bz-money', cents: bz_piece.price %}</span>
          </p>
          <div class="bz-v410-exclusive__actions">
            {%- if bz_piece.available == false -%}
              <span class="bz-v410-exclusive__sold">Esaurito</span>
            {%- elsif bz_piece.has_only_default_variant -%}
              <form action="{{ routes.cart_add_url }}" method="post">
                <input type="hidden" name="id" value="{{ bz_variant.id }}">
                <button class="bz-btn bz-btn--gold" type="submit">Aggiungi al carrello</button>
              </form>
              <a class="bz-v410-exclusive__more" href="{{ bz_href }}">{{ bz_label | escape }}</a>
            {%- else -%}
              <a class="bz-btn bz-btn--gold" href="{{ bz_piece.url }}">Scegli il pezzo</a>
            {%- endif -%}
          </div>
        </div>
      </div>
      {%- if section.settings.heading != blank or section.settings.heading_accent != blank -%}
        <p class="bz-v410-exclusive__line">{%- if section.settings.heading != blank -%}{{ section.settings.heading | escape }}{%- endif -%}{%- if section.settings.heading_accent != blank -%} <em>{{ section.settings.heading_accent | escape }}</em>{%- endif -%}</p>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="bz-v410-exclusive__text">{{ section.settings.text | escape }}</p>
      {%- endif -%}
    </div>
  </div>
</section>
<script src="{{ 'bz-pages.js' | asset_url }}" defer></script>
{%- endif -%}

{% schema %}
{
  "name": "Pezzo in evidenza",
  "class": "bz-home",
  "enabled_on": {
    "templates": ["index", "collection"]
  },
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Prodotto"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collezione",
      "info": "Se il prodotto è vuoto, usa il primo pezzo di questa collezione. In una pagina collezione, se anche questa è vuota, usa la collezione aperta."
    },
    {
      "type": "checkbox",
      "id": "show_collection_title",
      "label": "Mostra il nome della collezione",
      "info": "In pagina collezione, il nome diventa il titolo della pagina.",
      "default": false
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Foto",
      "info": "Sostituisce la foto del prodotto."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Testo alternativo della foto"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titolo",
      "default": "Il pezzo"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Titolo in corsivo",
      "default": "in evidenza"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Testo",
      "default": "Quello in foto è in negozio, da vedere e da ritirare a Cento."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Testo del pulsante",
      "default": "Vedi il pezzo"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Link del pulsante",
      "info": "Se vuoto, il link apre il prodotto."
    }
  ],
  "presets": [
    {
      "name": "Pezzo in evidenza"
    }
  ]
}
{% endschema %}
