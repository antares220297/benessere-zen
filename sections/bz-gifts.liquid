<section class="mala-band" aria-labelledby="gift-title">
  <article class="mala-lead">
    <div class="mala-photo">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1400 | image_tag: alt: '', loading: 'lazy', widths: '600, 1000, 1400', sizes: '(min-width: 900px) 50vw, 100vw' }}
      {%- else -%}
        <picture>
          <source media="(min-width: 1024px)" srcset="{{ 'bz-regali-wide.jpg' | asset_url }}">
          <source media="(min-width: 768px)" srcset="{{ 'bz-regali-mid.jpg' | asset_url }}">
          <img src="{{ 'bz-regali-mobile.jpg' | asset_url }}" alt="Still life del negozio: portacandela mano dorata con loto, ciondolo in corniola, candele chakra e portacandela Albero della Vita" width="960" height="720" loading="lazy">
        </picture>
      {%- endif -%}
    </div>
    <div class="mala-copy">
      <h2 id="gift-title">{{ section.settings.heading | escape }} <em>{{ section.settings.heading_accent | escape }}</em></h2>
      <p>{{ section.settings.text | escape }}</p>
      <a class="btn gold" href="{{ section.settings.link }}">{{ section.settings.button_label | escape }}</a>
    </div>
  </article>
  <div class="bento">
    {%- assign labels = section.settings.product_labels | newline_to_br | split: '<br />' -%}
    {%- for product in section.settings.products limit: 4 -%}
      {% render 'bz-product-card', card: product, style: 'gift', labels: labels %}
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "Fascia regali",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titolo", "default": "Regali piccoli," },
    { "type": "text", "id": "heading_accent", "label": "Corsivo", "default": "sotto 30 €" },
    { "type": "text", "id": "text", "label": "Testo", "default": "Ciondoli, pietre e piccole luci da regalare." },
    { "type": "text", "id": "button_label", "label": "Pulsante", "default": "Vedi le idee regalo →" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "image_picker", "id": "image", "label": "Foto" },
    { "type": "textarea", "id": "product_labels", "label": "Titoli in pagina", "info": "Un prodotto per riga: handle|titolo." },
    { "type": "product_list", "id": "products", "label": "Quattro prodotti", "limit": 4 }
  ],
  "presets": [{ "name": "Fascia regali" }]
}
{% endschema %}
