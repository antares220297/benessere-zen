{{ 'bz-tokens.css' | asset_url | stylesheet_tag }}
{{ 'bz-home.css' | asset_url | stylesheet_tag }}
{{ 'bz-pages.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign bz_gesture_any = false
  for block in section.blocks
    assign bz_gesture_item = block.settings.product
    if bz_gesture_item == blank and block.settings.collection != blank and block.settings.collection.products_count > 0
      assign bz_gesture_any = true
    endif
    if bz_gesture_item != blank
      assign bz_gesture_any = true
    endif
  endfor
-%}
{%- if bz_gesture_any -%}
<section class="bz bz-pages bz-gestures">
  {%- if section.settings.heading != blank -%}<h2 class="bz-reveal">{{ section.settings.heading | escape }}</h2>{%- endif -%}
  <div class="bz-gestures__grid">
    {%- for block in section.blocks -%}
      {%- assign item = block.settings.product -%}
      {%- if item == blank and block.settings.collection != blank -%}
        {%- for candidate in block.settings.collection.products -%}
          {%- if item == blank and candidate.available -%}
            {%- assign item = candidate -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
      {%- if item != blank -%}
        <a class="bz-gesture bz-reveal" href="{{ item.url }}" {{ block.shopify_attributes }}>
          {%- if item.featured_image -%}{{ item.featured_image | image_url: width: 900 | image_tag: alt: item.title, loading: 'lazy', width: 640, height: 420 }}{%- endif -%}
          <div class="bz-gesture__copy">
            <h3>{{ block.settings.title | escape }}</h3>
            {%- if block.settings.text != blank -%}<p>{{ block.settings.text | escape }}</p>{%- endif -%}
            <span class="bz-picked__all">{{ item.title | split: '|' | first | strip | escape }}</span>
          </div>
        </a>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>
<script src="{{ 'bz-pages.js' | asset_url }}" defer></script>
{%- endif -%}
{% schema %}
{
  "name": "Gesti del giorno",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titolo", "default": "Due gesti" }
  ],
  "blocks": [
    {
      "type": "gesture",
      "name": "Gesto",
      "settings": [
        { "type": "text", "id": "title", "label": "Titolo", "default": "Al mattino" },
        { "type": "textarea", "id": "text", "label": "Testo" },
        { "type": "product", "id": "product", "label": "Prodotto" },
        { "type": "collection", "id": "collection", "label": "Collezione", "info": "Se il prodotto è vuoto, usiamo il primo pezzo di questa collezione." }
      ]
    }
  ],
  "max_blocks": 2,
  "presets": [{ "name": "Gesti del giorno" }]
}
{% endschema %}
