{{ 'bz-tokens.css' | asset_url | stylesheet_tag }}
{{ 'bz-home.css' | asset_url | stylesheet_tag }}
{{ 'bz-pages.css' | asset_url | stylesheet_tag }}
<section class="bz bz-pages bz-shop-details">
  <p>{{ section.settings.pickup | escape }}</p>
  <h2>{{ section.settings.heading | escape }}</h2>
  <p>{{ section.settings.business | escape }}</p>
  <div>{{ section.settings.links }}</div>
</section>
{% schema %}
{
  "name": "Dati del negozio",
  "settings": [
    { "type": "textarea", "id": "pickup", "label": "Ritiro in negozio" },
    { "type": "text", "id": "heading", "label": "Titolo" },
    { "type": "textarea", "id": "business", "label": "Dati dell’attività" },
    { "type": "richtext", "id": "links", "label": "Link utili" }
  ],
  "presets": [{ "name": "Dati del negozio" }]
}
{% endschema %}
