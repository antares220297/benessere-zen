{{ 'bz-tokens.css' | asset_url | stylesheet_tag }}
{{ 'bz-home.css' | asset_url | stylesheet_tag }}
{{ 'bz-pages.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign pages_v2 = false
  if template.suffix == 'cura-di-se' or template.suffix == 'cose-layurveda' or template.suffix == 'cos-e-ayurveda'
    assign pages_v2 = true
  endif
-%}
<section class="bz bz-pages bz-story">
  {%- for block in section.blocks -%}
    {%- liquid
      assign shot = block.settings.image
      if shot == blank and block.settings.product != blank
        assign shot = block.settings.product.featured_image
      endif
      if shot == blank and block.settings.collection != blank
        assign shot = block.settings.collection.image | default: block.settings.collection.products.first.featured_image
      endif
    -%}
    <article class="bz bz-pages bz-story__band bz-reveal{% if pages_v2 %} bz-tile bz-tile--am{% endif %}{% if block.settings.flip %} is-flip{% endif %}{% unless shot %} is-solo{% endunless %}" {{ block.shopify_attributes }}>
      {%- if shot -%}
        {{ shot | image_url: width: 1200 | image_tag: alt: block.settings.title, loading: 'lazy', width: 800, height: 560 }}
      {%- endif -%}
      <div class="bz-story__copy">
        {%- if block.settings.title != blank -%}<h2>{{ block.settings.title | escape }}</h2>{%- endif -%}
        {%- if block.settings.text != blank -%}<p>{{ block.settings.text | escape }}</p>{%- endif -%}
        {%- if block.settings.text_2 != blank -%}<p>{{ block.settings.text_2 | escape }}</p>{%- endif -%}
        {%- if block.settings.button_label != blank and block.settings.button_link != blank -%}
          <a class="bz-btn {% if pages_v2 %}bz-btn--line{% else %}bz-btn--gold{% endif %}" href="{{ block.settings.button_link }}">{% render 'bz-nav-label', label: block.settings.button_label %}</a>
        {%- endif -%}
      </div>
    </article>
  {%- endfor -%}
</section>
<script src="{{ 'bz-pages.js' | asset_url }}" defer></script>
{% schema %}
{
  "name": "Fasce racconto",
  "settings": [],
  "blocks": [
    {
      "type": "band",
      "name": "Fascia",
      "settings": [
        { "type": "text", "id": "title", "label": "Titolo" },
        { "type": "textarea", "id": "text", "label": "Primo paragrafo" },
        { "type": "textarea", "id": "text_2", "label": "Secondo paragrafo" },
        { "type": "image_picker", "id": "image", "label": "Foto" },
        { "type": "product", "id": "product", "label": "Prodotto per la foto" },
        { "type": "collection", "id": "collection", "label": "Collezione per la foto" },
        { "type": "checkbox", "id": "flip", "label": "Testo a sinistra", "default": false },
        { "type": "text", "id": "button_label", "label": "Pulsante" },
        { "type": "url", "id": "button_link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Fasce racconto" }]
}
{% endschema %}
