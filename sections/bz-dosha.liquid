{{ 'bz-tokens.css' | asset_url | stylesheet_tag }}
{{ 'bz-home.css' | asset_url | stylesheet_tag }}
{{ 'bz-pages.css' | asset_url | stylesheet_tag }}
<section class="bz bz-pages bz-dosha">
  {%- if section.settings.heading != blank -%}<h2 class="bz-reveal">{{ section.settings.heading | escape }}</h2>{%- endif -%}
  {%- if section.settings.text != blank -%}<p class="bz-reveal">{{ section.settings.text | escape }}</p>{%- endif -%}
  <div class="bz-dosha__grid">
    {%- for block in section.blocks -%}
      {%- if block.settings.collection != blank and block.settings.collection.products_count > 0 -%}
        <a class="bz-dosha__card is-{{ block.settings.tone }} bz-reveal" href="{{ block.settings.collection.url }}" {{ block.shopify_attributes }}>
          {% render 'bz-dosha-mark', tone: block.settings.tone, title: block.settings.title, text: block.settings.text %}
          <span class="bz-picked__all">Vedi i pezzi</span>
        </a>
      {%- else -%}
        <article class="bz-dosha__card is-{{ block.settings.tone }} bz-reveal" {{ block.shopify_attributes }}>
          {% render 'bz-dosha-mark', tone: block.settings.tone, title: block.settings.title, text: block.settings.text %}
        </article>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>
<script src="{{ 'bz-pages.js' | asset_url }}" defer></script>
{% schema %}
{
  "name": "Dosha",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titolo", "default": "Tre energie" },
    { "type": "textarea", "id": "text", "label": "Testo" }
  ],
  "blocks": [
    {
      "type": "dosha",
      "name": "Dosha",
      "settings": [
        { "type": "text", "id": "title", "label": "Nome" },
        { "type": "textarea", "id": "text", "label": "Testo" },
        { "type": "collection", "id": "collection", "label": "Collezione" },
        {
          "type": "select",
          "id": "tone",
          "label": "Tono",
          "default": "vata",
          "options": [
            { "value": "vata", "label": "Vata" },
            { "value": "pitta", "label": "Pitta" },
            { "value": "kapha", "label": "Kapha" }
          ]
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [{ "name": "Dosha" }]
}
{% endschema %}
